From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ombra engine maintainers <engine@ombra.local>
Date: Sat, 1 Jan 2000 00:00:00 +0000
Subject: [PATCH] Byte budget for workspace context files with a truncation
 notice

What: Byte budget for workspace context files with a truncation notice
Why: A large AGENTS.md silently filled a small local model's window; contextFiles.maxBytes (0 = unlimited) keeps the nearest files, names truncated/omitted ones, and the wrapper states precedence.
Upstream-Status: Ombra-specific; idea from DeepSeek Harness; not submitted

diff --git a/src/context-file-budget.test.ts b/src/context-file-budget.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5bd7651c682b88f00be2427d3066429bfcf8474b
--- /dev/null
+++ b/src/context-file-budget.test.ts
@@ -0,0 +1,81 @@
+import { afterAll, beforeAll, describe, expect, test } from "bun:test";
+import { mkdtemp, rm } from "node:fs/promises";
+import * as os from "node:os";
+import * as path from "node:path";
+import { buildSystemPrompt } from "./system-prompt";
+
+const PRECEDENCE =
+	"They run broad to specific: nearer files override broader ones; none override system or direct user instructions.";
+
+describe("contextFiles.maxBytes budget in the system prompt", () => {
+	let cwd: string;
+	beforeAll(async () => {
+		cwd = await mkdtemp(path.join(os.tmpdir(), "ombra-context-budget-"));
+	});
+	afterAll(() => rm(cwd, { recursive: true, force: true }));
+
+	const userFile = { path: "/home/u/.omp/agent/AGENTS.md", content: "user rule: answer in English" };
+	const lines = (label: string) =>
+		[`${label} rule`, ...Array.from({ length: 300 }, (_, i) => `${label} line ${String(i).padStart(3, "0")}`)].join("\n");
+	const rootFile = { path: "/repo/AGENTS.md", content: lines("top"), depth: 2 };
+	const midFile = { path: "/repo/pkg/AGENTS.md", content: lines("mid"), depth: 1 };
+	const nearFile = { path: "/repo/pkg/app/AGENTS.md", content: "near rule: use tabs", depth: 0 };
+	const files = [userFile, rootFile, midFile, nearFile];
+
+	async function projectBlock(
+		contextFilesMaxBytes?: number,
+		contextFiles: Array<{ path: string; content: string; depth?: number }> = files,
+	): Promise<string> {
+		const { systemPrompt } = await buildSystemPrompt({
+			cwd,
+			contextFiles,
+			contextFilesMaxBytes,
+			skills: [],
+			personality: "none",
+			activeRepoContext: null,
+		});
+		const block = systemPrompt.find(part => part.includes("<repo-rules>"));
+		expect(block).toBeDefined();
+		return block!;
+	}
+
+	test("budget 0 is unlimited and adds only the static precedence sentence", async () => {
+		const block = await projectBlock(0);
+		expect(block).toBe(await projectBlock(undefined));
+		expect(block).toContain(PRECEDENCE);
+		for (const file of files) expect(block).toContain(`<file path="${file.path}">\n${file.content}\n</file>`);
+		expect(block).not.toContain("Workspace instructions exceeded");
+	});
+
+	test("under budget, every file renders whole with no notice", async () => {
+		const block = await projectBlock(1 << 20);
+		expect(block).toBe(await projectBlock(0));
+	});
+
+	test("over budget, the nearest file stays whole and the notice names cut paths", async () => {
+		const block = await projectBlock(2000);
+		// User-global chain has its own budget: untouched by the large project chain.
+		expect(block).toContain(`<file path="${userFile.path}">\n${userFile.content}\n</file>`);
+		expect(block).toContain(`<file path="${nearFile.path}">\n${nearFile.content}\n</file>`);
+		// Next-nearest file fills the remaining 1981 bytes, cut on a line boundary; the broadest is gone.
+		const midKept = midFile.content.slice(0, midFile.content.indexOf("\nmid line 151"));
+		expect(midKept.endsWith("mid line 150")).toBe(true);
+		expect(block).toContain(`<file path="${midFile.path}">\n${midKept}\n</file>`);
+		expect(block).not.toContain(`${rootFile.path}">`);
+		expect(block).toContain(
+			`Workspace instructions exceeded the 2000-byte budget: truncated ${midFile.path} (1971 of 3908 bytes); omitted ${rootFile.path}. Read these files in full before work they may govern.`,
+		);
+		// Byte-stable across rebuilds (no per-turn content).
+		expect(block).toBe(await projectBlock(2000));
+	});
+
+	test("a budget that omits every file still renders the notice", async () => {
+		const multibyte = { path: "/repo/AGENTS.md", content: "Ж rule", depth: 0 };
+		const block = await projectBlock(1, [multibyte]);
+		expect(block).toContain(
+			`<repo-rules>\nWorkspace instructions exceeded the 1-byte budget: omitted ${multibyte.path}. Read these files in full before work they may govern.\n</repo-rules>`,
+		);
+		expect(block).not.toContain("<file path=");
+		expect(block).not.toContain(PRECEDENCE);
+	});
+});
diff --git a/src/context-file-budget.ts b/src/context-file-budget.ts
new file mode 100644
index 0000000000000000000000000000000000000000..861ae306d701421415c42b263343d6c29d819bc1
--- /dev/null
+++ b/src/context-file-budget.ts
@@ -0,0 +1,147 @@
+/**
+ * Byte budget for workspace context files (AGENTS.md and similar) rendered into
+ * the system prompt.
+ *
+ * The user-global chain (files without a `depth`) and the project chain (files
+ * with a `depth`) are budgeted separately, so a huge project AGENTS.md cannot
+ * push out the user's own instructions. Within a chain, files keep their input
+ * order (broad first, nearest last) and the budget is spent nearest-first: the
+ * nearest files stay whole, the first file that no longer fits is truncated to
+ * the remaining bytes, and broader files are omitted.
+ */
+
+/** A context file entry as loaded for the system prompt. */
+export interface BudgetedContextFile {
+	path: string;
+	content: string;
+	depth?: number;
+}
+
+/** A file whose content was cut to fit the budget. */
+export interface TruncatedContextFile {
+	path: string;
+	originalBytes: number;
+	includedBytes: number;
+}
+
+export interface ContextFileBudgetResult<T extends BudgetedContextFile> {
+	/** Files to render, in input order; truncated entries carry the cut content. */
+	files: T[];
+	/** Paths of files left out entirely, in input order. */
+	omitted: string[];
+	/** Files rendered with only a prefix of their content, in input order. */
+	truncated: TruncatedContextFile[];
+}
+
+const encoder = new TextEncoder();
+const decoder = new TextDecoder();
+
+/**
+ * Longest prefix of `content` within `maxBytes` UTF-8 bytes. It ends on a line
+ * boundary when that keeps at least half the allowance, otherwise on a code
+ * point boundary.
+ */
+function truncateUtf8(content: string, maxBytes: number): string {
+	const bytes = encoder.encode(content);
+	if (bytes.length <= maxBytes) return content;
+	let end = maxBytes;
+	// Step back over UTF-8 continuation bytes (10xxxxxx) so no code point is split.
+	while (end > 0 && (bytes[end]! & 0xc0) === 0x80) end--;
+	const prefix = decoder.decode(bytes.subarray(0, end));
+	const lastNewline = prefix.lastIndexOf("\n");
+	return lastNewline > 0 && Buffer.byteLength(prefix.slice(0, lastNewline), "utf8") * 2 >= maxBytes
+		? prefix.slice(0, lastNewline)
+		: prefix;
+}
+
+function budgetChain<T extends BudgetedContextFile>(
+	chain: readonly T[],
+	maxBytes: number,
+	kept: Map<T, T>,
+	omitted: Set<T>,
+	truncated: Map<T, TruncatedContextFile>,
+): void {
+	let remaining = maxBytes;
+	for (let index = chain.length - 1; index >= 0; index--) {
+		const file = chain[index]!;
+		const size = Buffer.byteLength(file.content, "utf8");
+		if (size <= remaining) {
+			kept.set(file, file);
+			remaining -= size;
+			continue;
+		}
+		const content = remaining > 0 ? truncateUtf8(file.content, remaining) : "";
+		if (content.length === 0) {
+			omitted.add(file);
+		} else {
+			const includedBytes = Buffer.byteLength(content, "utf8");
+			kept.set(file, { ...file, content });
+			truncated.set(file, { path: file.path, originalBytes: size, includedBytes });
+		}
+		// Broader files of this chain do not fit once a nearer one was cut.
+		for (let broader = index - 1; broader >= 0; broader--) omitted.add(chain[broader]!);
+		return;
+	}
+}
+
+/**
+ * Fit context files into `maxBytes` of content per chain (user-global, project).
+ * A budget of 0 (or any non-positive or non-finite value) means unlimited and
+ * returns the input unchanged.
+ */
+export function applyContextFileBudget<T extends BudgetedContextFile>(
+	files: readonly T[],
+	maxBytes: number,
+): ContextFileBudgetResult<T> {
+	if (!(maxBytes > 0) || !Number.isFinite(maxBytes)) {
+		return { files: [...files], omitted: [], truncated: [] };
+	}
+	const kept = new Map<T, T>();
+	const omitted = new Set<T>();
+	const truncated = new Map<T, TruncatedContextFile>();
+	budgetChain(
+		files.filter(file => file.depth === undefined),
+		maxBytes,
+		kept,
+		omitted,
+		truncated,
+	);
+	budgetChain(
+		files.filter(file => file.depth !== undefined),
+		maxBytes,
+		kept,
+		omitted,
+		truncated,
+	);
+	return {
+		files: files.flatMap(file => {
+			const entry = kept.get(file);
+			return entry === undefined ? [] : [entry];
+		}),
+		omitted: files.filter(file => omitted.has(file)).map(file => file.path),
+		truncated: files.flatMap(file => {
+			const entry = truncated.get(file);
+			return entry === undefined ? [] : [entry];
+		}),
+	};
+}
+
+/**
+ * One-line, model-facing notice naming the omitted and truncated files, or
+ * undefined when the budget left every file whole. The text depends only on the
+ * budget and the files, so it stays byte-stable across turns.
+ */
+export function formatContextFileBudgetNotice(
+	maxBytes: number,
+	result: Pick<ContextFileBudgetResult<BudgetedContextFile>, "omitted" | "truncated">,
+): string | undefined {
+	if (result.omitted.length === 0 && result.truncated.length === 0) return undefined;
+	const parts: string[] = [];
+	if (result.truncated.length > 0) {
+		parts.push(
+			`truncated ${result.truncated.map(file => `${file.path} (${file.includedBytes} of ${file.originalBytes} bytes)`).join(", ")}`,
+		);
+	}
+	if (result.omitted.length > 0) parts.push(`omitted ${result.omitted.join(", ")}`);
+	return `Workspace instructions exceeded the ${maxBytes}-byte budget: ${parts.join("; ")}. Read these files in full before work they may govern.`;
+}
