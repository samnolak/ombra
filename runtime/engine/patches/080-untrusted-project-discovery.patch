+/**
+ * The launch's plugin-root preload (`--plugin-dir` roots injected when given), run under the launch `settings`:
+ * the process-wide roots LSP/DAP read must follow that launch's folder trust, which may be read before
+ * those settings become the process singleton.
+ */
+export function preloadLaunchPluginRoots(
+	settings: Settings,
+	home: string,
+	cwd: string,
+	pluginDirs: string[] | undefined,
+): Promise<void> {
+	return withActiveSettings(settings, () =>
+		pluginDirs?.length ? injectPluginDirRoots(home, pluginDirs, cwd) : preloadPluginRoots(home, cwd),
+	);
+}
