Date: Mon, 19 Oct 2026 21:42:07 +0300
Subject: [PATCH] small context recovery

What: Preserve the repository-owned small context recovery.
Why: Ombra embeds multiple concurrent sessions and renders native host features.
Upstream-status: Ombra-only integration; generic safety fixes are upstream candidates.

diff --git a/src/session/reported-context-limit.test.ts b/src/session/reported-context-limit.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0ff8f6819b370ac3c9d36ae67b4362adb08f0315
--- /dev/null
+++ b/src/session/reported-context-limit.test.ts
@@ -0,0 +1,29 @@
+import { describe, expect, test } from "bun:test";
+import { reportedContextLimit } from "./reported-context-limit";
+
+describe("reportedContextLimit", () => {
+	test("reads the window OpenAI-compatible servers state", () => {
+		expect(
+			reportedContextLimit(
+				"400 This model's maximum context length is 12000 tokens. However, your messages resulted in 17520 tokens.",
+			),
+		).toBe(12000);
+		expect(reportedContextLimit("maximum context length is 32,768 tokens")).toBe(32768);
+	});
+
+	test("reads LM Studio and llama.cpp phrasings", () => {
+		expect(
+			reportedContextLimit("Trying to keep the first 9000 tokens when context the overflows. However, the model is loaded with context length of only 4096 tokens"),
+		).toBe(4096);
+		expect(
+			reportedContextLimit('{"error":{"code":400,"message":"the request exceeds the available context size, try increasing it","type":"exceed_context_size_error","n_prompt_tokens":9000,"n_ctx":8192}}'),
+		).toBe(8192);
+	});
+
+	test("ignores messages without a stated window and implausible numbers", () => {
+		expect(reportedContextLimit(undefined)).toBeUndefined();
+		expect(reportedContextLimit("context_length_exceeded")).toBeUndefined();
+		expect(reportedContextLimit("prompt is too long: 210000 tokens > 200000 maximum")).toBeUndefined();
+		expect(reportedContextLimit("maximum context length is 12 tokens")).toBeUndefined();
+	});
+});
diff --git a/src/session/reported-context-limit.ts b/src/session/reported-context-limit.ts
new file mode 100644
index 0000000000000000000000000000000000000000..442ce23590c9f40aadb9cd85d164ffefabd48bd8
--- /dev/null
+++ b/src/session/reported-context-limit.ts
@@ -0,0 +1,30 @@
+/**
+ * The context window a provider states in its context-overflow error, when it names one.
+ *
+ * Local servers (vLLM, llama.cpp, LM Studio) are often started with a shorter context than the model's
+ * configured `contextWindow`. Their overflow error then names the real limit, while every maintenance
+ * threshold still measures against the configured window, so compaction finds "nothing to free" and the
+ * run dead-ends. Recognized phrasings:
+ * - OpenAI / vLLM: "This model's maximum context length is 8192 tokens."
+ * - LM Studio: "the model is loaded with context length of only 4096 tokens"
+ * - llama.cpp: `"n_ctx": 4096` (or `n_ctx: 4096`) next to "exceeds the available context size"
+ */
+const REPORTED_LIMIT_PATTERNS: readonly RegExp[] = [
+	/\bmaximum context length is (\d[\d,]*) tokens\b/i,
+	/\bcontext length of only (\d[\d,]*) tokens\b/i,
+	/\bn_ctx\\?"?\s*[:=]\s*(\d+)\b/i,
+];
+
+/** Smallest window worth adopting: anything below is a parse accident, not a real server limit. */
+const MIN_REPORTED_CONTEXT_WINDOW = 1024;
+
+export function reportedContextLimit(errorMessage: string | undefined): number | undefined {
+	if (!errorMessage) return undefined;
+	for (const pattern of REPORTED_LIMIT_PATTERNS) {
+		const match = pattern.exec(errorMessage);
+		if (!match) continue;
+		const tokens = Number(match[1].replaceAll(",", ""));
+		if (Number.isSafeInteger(tokens) && tokens >= MIN_REPORTED_CONTEXT_WINDOW) return tokens;
+	}
+	return undefined;
+}
