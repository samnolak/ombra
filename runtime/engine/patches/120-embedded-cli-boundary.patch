diff --git a/src/cli/gc-cli.ts b/src/cli/gc-cli.ts
index 2f65650670a2a9ffbab5fbd0295196611f15e174..e9ae4eac98fd7bdf2de8b6808ee440b1e6429200 100644
--- a/src/cli/gc-cli.ts
+++ b/src/cli/gc-cli.ts
@@ -1857,14 +1857,32 @@ async function runArchiveGc(
 
 	const archivedSessionIds: string[] = [];
 	const archivedSessions: SessionInfo[] = [];
+	const storage = new FileSessionStorage();
 	for (const candidate of candidates) {
+		let release: (() => void) | null = null;
+		const nestedReleases: (() => void)[] = [];
 		try {
+			// An old mtime (including SIGSTOP) is not evidence that a writer died.
+			// Hold the canonical lifetime lease through compression and unlink.
+			release = storage.claimSession(candidate.session.id, candidate.session.path);
+			if (!release) {
+				result.skippedActive += 1;
+				continue;
+			}
+			for (const nested of await listNestedSessionsReadOnly(sessionArtifactsPath(candidate.session.path))) {
+				const nestedRelease = storage.claimSession(nested.id, nested.path);
+				if (!nestedRelease) throw new Error(`Nested session is busy in another live writer: ${nested.path}`);
+				nestedReleases.push(nestedRelease);
+			}
 			await moveSessionWithArtifacts(candidate);
 			result.archived += 1;
 			archivedSessionIds.push(candidate.session.id);
 			archivedSessions.push(candidate.session);
 		} catch (error) {
 			result.errors.push(`${candidate.session.path}: ${errorMessage(error)}`);
+		} finally {
+			for (const nestedRelease of nestedReleases) nestedRelease();
+			release?.();
 		}
 	}
 
