+	/**
+	 * Bring the logs back under the shared budget: settled jobs (oldest first)
+	 * give up their whole output, then the running job holding the most is
+	 * trimmed from its oldest bytes. Offsets stay valid; readers see the loss
+	 * as skipped bytes.
+	 */
+	#trimOutputLogs(): void {
+		const held = Array.from(this.#jobs.values()).filter(job => (job.output?.retainedBytes ?? 0) > 0);
+		const settled = held
+			.filter(job => job.status !== "running")
+			.sort((a, b) => (a.endTime ?? a.startTime) - (b.endTime ?? b.startTime));
+		for (const job of settled) {
+			if (this.#outputBytes <= this.#outputBudgetBytes) return;
+			this.#outputBytes -= job.output!.retainedBytes;
+			job.output!.release(job.output!.retainedBytes);
+		}
+		const running = held.filter(job => job.status === "running");
+		while (this.#outputBytes > this.#outputBudgetBytes) {
+			const largest = running.reduce((a, b) => (b.output!.retainedBytes > a.output!.retainedBytes ? b : a));
+			const log = largest.output!;
+			const before = log.retainedBytes;
+			log.release(this.#outputBytes - this.#outputBudgetBytes);
+			this.#outputBytes -= before - log.retainedBytes;
+		}
+	}
