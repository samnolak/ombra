-		if (isRecord(frame) && frame.type === "agent_start") this.#streamedMessages = [];
+		let logicalFrame = frame;
+		let sessionKey: string | undefined;
+		if (isRecord(frame) && frame.type === "engine_session_frame" && typeof frame.sessionKey === "string" && isRecord(frame.frame)) {
+			sessionKey = frame.sessionKey;
+			logicalFrame = frame.frame;
+		}
+		let history = sessionKey ? this.#sessionMessages.get(sessionKey) : this.#streamedMessages;
+		if (!history) {
+			history = { messages: [], bytes: 0, tracking: true };
+			this.#sessionMessages.set(sessionKey!, history);
+		}
+		if (isRecord(logicalFrame) && logicalFrame.type === "agent_start") {
+			this.#trackedMessageBytes -= history.bytes;
+			history.messages = [];
+			history.bytes = 0;
+			history.tracking = true;
+		}
+		if (isRecord(frame) && frame.type === "engine_session_closed" && typeof frame.sessionKey === "string") {
+			const closed = this.#sessionMessages.get(frame.sessionKey);
+			if (closed) this.#trackedMessageBytes -= closed.bytes;
+			this.#sessionMessages.delete(frame.sessionKey);
+		}
 		const json = serializeFrame(frame);
 		let frames: Iterable<string>;
 		let singleFrame: string | undefined;
 		if (this.#protocolVersion === 2 && serializedFrameBytes(json) > MAX_RPC_FRAME_BYTES) {
-			const compacted = compactTerminalFrame(frame, this.#streamedMessages.length, this.#streamedMessages);
+			const terminal = compactTerminalFrame(logicalFrame, history.messages.length, history.messages);
+			const compacted = terminal === logicalFrame ? frame : sessionKey
+				? { ...frame, frame: terminal } : terminal;
 			// Reuse the original serialization when compaction was a no-op.
 			const compactedJson = compacted === frame ? json : JSON.stringify(compacted);
 			if (serializedFrameBytes(compactedJson) > MAX_RPC_FRAME_BYTES) {
@@ -368,19 +403,31 @@ export class RpcFrameEncoder {
 				frames = [singleFrame];
 			}
 		} else {
-			singleFrame = encodeRpcFrameFromJson(frame, json, this.#streamedMessages.length, this.#streamedMessages);
+			singleFrame = encodeRpcFrameFromJson(frame, json, history.messages.length, history.messages);
 			frames = [singleFrame];
 		}
-		if (!isRecord(frame)) return frames;
-		if (frame.type === "message_end") {
-			const snapshot =
-				this.#protocolVersion === 2 && Object.hasOwn(frame, "message")
-					? (encodedMessageSnapshot(json) ?? { message: jsonSnapshot(frame.message) })
-					: singleFrame !== undefined
-						? encodedMessageSnapshot(singleFrame)
-						: undefined;
-			if (snapshot) this.#streamedMessages.push(snapshot.message);
-		} else if (frame.type === "agent_end" && frame.willContinue !== true) this.#streamedMessages = [];
+		if (!isRecord(logicalFrame)) return frames;
+		if (logicalFrame.type === "message_end" && history.tracking) {
+			// Bound retained compaction snapshots across all logical sessions. A
+			// truncated prefix is still safe: terminal compaction compares it.
+			const bytes = Buffer.byteLength(json);
+			if (bytes <= MAX_RPC_REASSEMBLED_BYTES - this.#trackedMessageBytes) {
+				const snapshot =
+					this.#protocolVersion === 2 && Object.hasOwn(logicalFrame, "message")
+						? encodedMessageSnapshot(json)
+						: singleFrame !== undefined ? encodedMessageSnapshot(singleFrame) : undefined;
+				if (snapshot) {
+					history.messages.push(snapshot.message);
+					history.bytes += bytes;
+					this.#trackedMessageBytes += bytes;
+				}
+			} else history.tracking = false;
+		} else if (logicalFrame.type === "agent_end" && logicalFrame.willContinue !== true) {
+			this.#trackedMessageBytes -= history.bytes;
+			history.messages = [];
+			history.bytes = 0;
+			history.tracking = true;
+		}
 		return frames;
 	}
 
