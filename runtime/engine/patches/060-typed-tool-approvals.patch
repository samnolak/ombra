 /**
- * Ask the user to approve a call: the host's approval dialog when it has one (it gets the full
- * prompt and a compact one with the details summarized to a row, so the composer beneath it
- * keeps its room), else a select with the full prompt (RPC, ACP, extension hosts). `appendix`
- * lines follow the prompt on both. With a `sessionSubject`, both also offer to approve that
- * subject for the rest of the session. Anything but an explicit approval is `deny`.
+ * Ask through the host's approval dialog, or a select fallback. Both receive the typed request
+ * and denial-reason callback. Session grants are offered only when allowed by the request;
+ * provider safety checks and explicit prompt policies stay per-call. Anything but an explicit
+ * supported approval is a denial.
  */
 export async function requestApproval(
 	ui: Pick<ExtensionUIContext, "select" | "approve">,
 	tool: ApprovalSubject,
 	args: unknown,
-	options: { reason?: string; appendix?: readonly string[]; sessionSubject?: string } = {},
-): Promise<ExtensionApprovalAnswer> {
-	const { reason, appendix = [], sessionSubject } = options;
+	options: {
+		approval: ToolApprovalRequest;
+		reason?: string;
+		appendix?: readonly string[];
+		sessionSubject?: string;
+	},
+): Promise<ToolApprovalOutcome> {
+	const { approval, reason, appendix = [], sessionSubject } = options;
 	const header = approvalHeader(tool, reason);
 	const details = approvalDetails(tool, args);
 	const full = [...header, ...details, ...appendix].join("\n");
-	const session = sessionSubject === undefined ? undefined : `Approve ${sessionSubject} for this session`;
+	const session =
+		sessionSubject !== undefined && approval.scopes.includes("session") && !approval.safetyChecks?.length
+			? `Approve ${sessionSubject} for this session`
+			: undefined;
+	let denyReason: string | undefined;
+	const dialogOptions = {
+		approval,
+		onApprovalDenied: (reason: string) => {
+			denyReason = reason.trim().slice(0, MAX_APPROVAL_DENY_REASON_CHARS) || undefined;
+		},
+	};
+	let answer: ExtensionApprovalAnswer;
 	if (ui.approve) {
 		const summary = approvalSummary(details);
 		const compact = [...header, ...(summary === undefined ? [] : [summary]), ...appendix].join("\n");
-		const answer = await ui.approve({ full, compact, ...(session ? { session } : {}) });
-		return answer === "once" || (answer === "session" && session) ? answer : "deny";
+		answer = await ui.approve({ full, compact, ...(session ? { session } : {}) }, dialogOptions);
+	} else {
+		const choice = await ui.select(
+			full,
+			session ? ["Approve", session, "Deny"] : ["Approve", "Deny"],
+			dialogOptions,
+		);
+		answer = choice === "Approve" ? "once" : session && choice === session ? "session" : "deny";
 	}
-	const choice = await ui.select(full, session ? ["Approve", session, "Deny"] : ["Approve", "Deny"]);
-	return choice === "Approve" ? "once" : session && choice === session ? "session" : "deny";
+	if (answer === "once" || (answer === "session" && session)) return { approved: true, scope: answer };
+	return denyReason ? { approved: false, reason: denyReason } : { approved: false };
 }
+
+/**
+ * The failed tool result of a denied call: the user's reason, when given, is what the agent reads next. It is a
+ * JSON string after a fixed label, so a reason spanning lines cannot pose as further tool output.
+ */
