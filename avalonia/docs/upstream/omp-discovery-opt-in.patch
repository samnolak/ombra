diff --git a/packages/catalog/src/provider-models/remote-catalog.ts b/packages/catalog/src/provider-models/remote-catalog.ts
new file mode 100644
--- /dev/null
+++ b/packages/catalog/src/provider-models/remote-catalog.ts
@@ -0,0 +1,18 @@
+/**
+ * Process-wide switch for the shared models.dev mirror (catalog.stencil.so).
+ *
+ * Every catalog lookup — the additive models.dev fallback layer and the
+ * reference/pricing enrichment some endpoint fetchers perform — goes through
+ * `fetchWellKnownModels`, which consults this switch before any I/O. While it
+ * is off, lookups reject without touching the network and callers keep their
+ * bundled metadata. The coding agent drives it from `providers.remoteCatalog`.
+ */
+let remoteCatalogEnabled = true;
+
+export function setRemoteCatalogEnabled(enabled: boolean): void {
+	remoteCatalogEnabled = enabled;
+}
+
+export function isRemoteCatalogEnabled(): boolean {
+	return remoteCatalogEnabled;
+}
diff --git a/packages/coding-agent/CHANGELOG.md b/packages/coding-agent/CHANGELOG.md
--- a/packages/coding-agent/CHANGELOG.md
+++ b/packages/coding-agent/CHANGELOG.md
@@ -2,6 +2,11 @@
 
 ## [Unreleased]
 
+### Added
+
+- Added the `providers.discovery` setting: `all` (default, current behavior) or `configured`, which lists models only from providers that have credentials, an env key, a `models.yml` entry, or an extension, and probes Ollama, llama.cpp, and LM Studio only when their base URL env var is set or they are configured.
+- Added the `providers.remoteCatalog` setting (default `true`); set it to `false` to never fetch the shared models.dev mirror (`catalog.stencil.so`) and use the bundled catalog plus configured provider endpoints only.
+
