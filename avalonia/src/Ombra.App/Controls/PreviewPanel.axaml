<!-- Browser preview (as Claude Code's Preview pane), the browser tab of the right panel (Views/Panes/RightPanel, whose
     strip lists the pages): the web app the agent is building, usually a dev server on localhost. DataContext =
     PreviewViewModel. A 48 px toolbar of pills (the ChatGPT app's): back | forward · reload in one, the address as a
     full pill (open in browser at its end), device size and annotate in another; suggestion chips while nothing is
     open, then the page. The native web view is created in code only once a page is navigated; where the platform's
     engine is missing a card offers the system browser instead. -->
<UserControl xmlns:loc="using:Ombra.App.Localization"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ombra.App.ViewModels"
             xmlns:ctl="using:Ombra.App.Controls"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             xmlns:cb="using:Ombra.ClientCore.Browser"
             x:Class="Ombra.App.Controls.PreviewPanel"
             x:DataType="vm:PreviewViewModel"
             Background="Transparent"
             AutomationProperties.Name="{loc:T 'Preview'}">
  <UserControl.Styles>
    <Style Selector="Border.preview-toolbar">
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource GuiBorderSoft}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="ProgressBar.preview-loading">
      <Setter Property="MinHeight" Value="2" />
      <Setter Property="Height" Value="2" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.preview-agent">
      <Setter Property="Background" Value="{DynamicResource GuiStatusInfoSoft}" />
      <Setter Property="CornerRadius" Value="{DynamicResource GuiRadiusFull}" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="10,0,12,0" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The device bar (shown in device mode) -->
    <Style Selector="Border.preview-device-bar">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="BorderBrush" Value="{DynamicResource GuiBorderSoft}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <!-- Downloads of the pane's pages, under the page -->
    <Style Selector="Border.preview-downloads">
      <Setter Property="Padding" Value="8" />
      <Setter Property="BorderBrush" Value="{DynamicResource GuiBorderSoft}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- The Browser page's own tabs (MainWindow's BrowserPage): a row of the window's band, centred in it; on macOS the
         title bar, its empty part moves the window (Styles.Workspace: after the traffic lights while the sidebar is hidden) -->
    <DockPanel DockPanel.Dock="Top" Classes="preview-tab-strip" IsVisible="{Binding ShowTabStrip, RelativeSource={RelativeSource AncestorType=ctl:PreviewPanel}}"
               chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding NewTabCommand}"
              ToolTip.Tip="{loc:T 'New tab'}" AutomationProperties.Name="{loc:T 'New tab'}">
        <ctl:Icon Data="{StaticResource IconPlus}" Size="16" />
      </Button>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Tabs}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PreviewTab">
              <Border Classes="panel-tab" Classes.active="{Binding IsActive}" IsVisible="{Binding ShowsInStrip}" ctl:TabMenus.Enabled="True">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="icon panel-tab-close" IsEnabled="{Binding CanClose}"
                          Command="{Binding $parent[ctl:PreviewPanel].((vm:PreviewViewModel)DataContext).CloseTabCommand}" CommandParameter="{Binding}"
                          ToolTip.Tip="{loc:T 'Close tab'}" AutomationProperties.Name="{loc:T 'Close tab'}">
                    <ctl:Icon Data="{StaticResource IconClose}" Size="14" />
                  </Button>
                  <Button Classes="flat panel-tab-button" Command="{Binding $parent[ctl:PreviewPanel].((vm:PreviewViewModel)DataContext).SelectTabCommand}"
                          CommandParameter="{Binding}" ToolTip.Tip="{Binding ToolTip}" AutomationProperties.Name="{Binding Header}">
                    <TextBlock Text="{Binding Header}" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                  </Button>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
    <!-- ── Toolbar ── -->
    <Panel DockPanel.Dock="Top">
      <Border Classes="preview-toolbar">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
          <!-- Back | forward · reload: one pill -->
          <Border Grid.Column="0" Classes="toolbar-pill">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="BackButton" Classes="icon" Command="{Binding BackCommand}"
                      ToolTip.Tip="{loc:T 'Back'}" AutomationProperties.Name="{loc:T 'Back'}">
                <ctl:Icon Data="{StaticResource IconArrowLeft}" Size="16" />
              </Button>
              <Button x:Name="ForwardButton" Classes="icon" Command="{Binding ForwardCommand}"
                      ToolTip.Tip="{loc:T 'Forward'}" AutomationProperties.Name="{loc:T 'Forward'}">
                <ctl:Icon Data="{StaticResource IconArrowRight}" Size="16" />
              </Button>
              <Border Classes="toolbar-divider" />
              <Button x:Name="ReloadButton" Classes="icon" Command="{Binding ReloadCommand}"
                      ToolTip.Tip="{loc:T 'Reload'}" AutomationProperties.Name="{loc:T 'Reload'}">
                <ctl:Icon Data="{StaticResource IconReload}" Size="16" />
              </Button>
            </StackPanel>
          </Border>
          <TextBox x:Name="AddressBox" Grid.Column="1" Classes="pill" Margin="8,0"
                   Text="{Binding Address}" PlaceholderText="localhost:3000"
                   AutomationProperties.Name="{loc:T 'Address'}" ToolTip.Tip="{Binding Title}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding NavigateCommand}" />
            </TextBox.KeyBindings>
            <!-- Open in the system browser: part of the address, as in browsers -->
            <TextBox.InnerRightContent>
              <Button x:Name="OpenExternallyButton" Classes="icon round" Width="26" Height="26" Margin="0,0,3,0" Command="{Binding OpenExternallyCommand}"
                      ToolTip.Tip="{loc:T 'Open in the browser'}" AutomationProperties.Name="{loc:T 'Open in browser'}">
                <ctl:Icon Data="{StaticResource IconExternal}" Size="16" />
              </Button>
            </TextBox.InnerRightContent>
          </TextBox>
          <!-- omp's browser tool is using the page (as Claude in Chrome marks the tab it drives); in the toolbar, so the page keeps its size -->
          <Border x:Name="AgentBrowsingPill" Grid.Column="2" Classes="preview-agent" IsVisible="{Binding IsAgentBrowsing}"
                  ToolTip.Tip="{loc:T 'omp is using this page'}" AutomationProperties.Name="{loc:T 'omp is using this page'}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Classes="state-dot running" />
              <TextBlock Text="omp" FontSize="{DynamicResource GuiFontS}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <!-- The page's tools: one pill -->
          <Border Grid.Column="3" Classes="toolbar-pill">
            <StackPanel Orientation="Horizontal">
              <!-- Device mode (the browsers' device toolbar): the page at a phone's, a tablet's or a desktop's size and platform -->
              <Button x:Name="DeviceButton" Classes="icon" Classes.on="{Binding HasDevice}" Command="{Binding ToggleDeviceCommand}"
                      ToolTip.Tip="{Binding DeviceTip}" AutomationProperties.Name="{loc:T 'Device size'}">
                <ctl:Icon Data="{StaticResource IconDevices}" Size="16" />
              </Button>
              <!-- Annotate (Codex's page comments): click a point or drag over an area, write what to change -->
              <Button x:Name="AnnotateButton" Classes="icon" Classes.on="{Binding IsAnnotating}" Command="{Binding ToggleAnnotateCommand}"
                      ToolTip.Tip="{loc:T 'Annotate: mark a point or an area (Ctrl/⌘+Shift+S)'}" AutomationProperties.Name="{loc:T 'Annotate'}">
                <ctl:Icon Data="{StaticResource IconSelect}" Size="16" />
              </Button>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
      <ProgressBar Classes="preview-loading" VerticalAlignment="Bottom" IsIndeterminate="{Binding IsLoading}"
                   IsVisible="{Binding IsLoading}" />
    </Panel>

    <!-- ── Device bar (while device mode is on): a preset, or a size typed in; turn it; the platform the page sees ── -->
    <Border x:Name="DeviceBar" DockPanel.Dock="Top" Classes="preview-device-bar" IsVisible="{Binding HasDevice}">
      <WrapPanel ItemSpacing="8" LineSpacing="6" VerticalAlignment="Center">
        <ComboBox x:Name="DevicePresetBox" ItemsSource="{x:Static vm:PreviewViewModel.DevicePresets}" SelectedItem="{Binding DevicePreset}"
                  PlaceholderText="{loc:T 'Custom size'}" MinWidth="170" VerticalAlignment="Center" AutomationProperties.Name="{loc:T 'Device'}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:DevicePreset">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                <TextBlock Classes="muted" Text="{Binding SizeText}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <TextBox x:Name="DeviceWidthBox" Classes="sm" Width="64" Text="{Binding CustomWidth}" AutomationProperties.Name="{loc:T 'Width'}" ToolTip.Tip="{loc:T 'Width (Enter applies)'}">
            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding ApplyCustomSizeCommand}" /></TextBox.KeyBindings>
          </TextBox>
          <TextBlock Classes="muted" Text="×" VerticalAlignment="Center" />
          <TextBox x:Name="DeviceHeightBox" Classes="sm" Width="64" Text="{Binding CustomHeight}" AutomationProperties.Name="{loc:T 'Height'}" ToolTip.Tip="{loc:T 'Height (Enter applies)'}">
            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding ApplyCustomSizeCommand}" /></TextBox.KeyBindings>
          </TextBox>
        </StackPanel>
        <Button x:Name="RotateDeviceButton" Classes="icon" Classes.on="{Binding IsLandscape}" Command="{Binding RotateDeviceCommand}"
                ToolTip.Tip="{loc:T 'Portrait / landscape'}" AutomationProperties.Name="{loc:T 'Rotate'}" VerticalAlignment="Center">
          <ctl:Icon Data="{StaticResource IconRotate}" Size="16" />
        </Button>
        <ComboBox x:Name="DevicePlatformBox" ItemsSource="{x:Static vm:PreviewViewModel.DevicePlatforms}" SelectedItem="{Binding DevicePlatform}"
                  IsEnabled="{x:Static vm:PreviewViewModel.CanSetUserAgent}" MinWidth="110" VerticalAlignment="Center"
                  ToolTip.Tip="{loc:T 'The platform the page sees (its user agent). Only the size changes where the engine can’t set one.'}"
                  AutomationProperties.Name="{loc:T 'Platform'}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:DevicePlatform">
              <TextBlock Text="{Binding Converter={x:Static vm:PreviewViewModel.PlatformNameConverter}}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <!-- The Nightly runtime emulates these too: devicePixelRatio, and touch (pointer: coarse, touch events, the mouse as a finger) -->
        <ComboBox x:Name="DevicePixelRatioBox" ItemsSource="{x:Static vm:PreviewViewModel.DevicePixelRatios}" SelectedItem="{Binding DevicePixelRatio}"
                  IsVisible="{Binding UseNightly}" MinWidth="90" VerticalAlignment="Center"
                  ToolTip.Tip="{loc:T 'The device pixel ratio the page sees (devicePixelRatio, resolution media queries)'}"
                  AutomationProperties.Name="{loc:T 'Pixel ratio'}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="x:Double">
              <TextBlock Text="{Binding Converter={x:Static vm:PreviewViewModel.PixelRatioNameConverter}}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button x:Name="DeviceTouchButton" Classes="icon" Classes.on="{Binding DeviceTouch}" Command="{Binding ToggleTouchCommand}"
                IsVisible="{Binding UseNightly}" VerticalAlignment="Center" AutomationProperties.Name="{loc:T 'Touch'}"
                ToolTip.Tip="{loc:T 'Touch: the page sees a touch screen (pointer: coarse, touch events) and the mouse acts as a finger'}">
          <ctl:Icon Data="{StaticResource IconTouch}" Size="16" />
        </Button>
        <Button x:Name="CloseDeviceButton" Classes="icon" Command="{Binding ClearDeviceCommand}" VerticalAlignment="Center"
                ToolTip.Tip="{loc:T 'Fit the pane again (Ctrl/⌘+Shift+M)'}" AutomationProperties.Name="{loc:T 'Leave device mode'}">
          <ctl:Icon Data="{StaticResource IconClose}" Size="16" />
        </Button>
      </WrapPanel>
    </Border>

    <!-- ── Suggestions (local addresses from tool output) while nothing is open ── -->
    <ItemsControl x:Name="SuggestionRow" DockPanel.Dock="Top" ItemsSource="{Binding Suggestions}"
                  IsVisible="{Binding ShowSuggestionRow}" Margin="8,8,8,0">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel ItemSpacing="6" LineSpacing="6" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <Button Classes="chip" Command="{Binding $parent[ItemsControl].((vm:PreviewViewModel)DataContext).NavigateCommand}"
                  CommandParameter="{Binding}" ToolTip.Tip="{loc:T 'Open in the preview'}" AutomationProperties.Name="{Binding}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ctl:Icon Data="{StaticResource IconGlobe}" Size="16" />
              <TextBlock Text="{Binding}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- ── Why an address was refused or a page failed ── -->
    <Border x:Name="MessageBar" DockPanel.Dock="Top" Classes="notice error" Margin="8,8,8,0" IsVisible="{Binding HasMessage}">
      <DockPanel>
        <ctl:Icon DockPanel.Dock="Left" Classes="error-mark" Data="{StaticResource IconAlert}" Size="16" Margin="0,0,8,0" VerticalAlignment="Top" />
        <TextBlock Classes="error" Text="{Binding Message}" TextWrapping="Wrap" FontSize="{DynamicResource GuiFontS}" />
      </DockPanel>
    </Border>

    <!-- ── First run (macOS): may pages move to Nightly? (PreviewNightly.cs) ── -->
    <Border x:Name="NightlyConsentBar" DockPanel.Dock="Top" Classes="card" Margin="8,8,8,0" IsVisible="{Binding NeedsNightlyConsent}">
      <StackPanel Spacing="12">
        <StackPanel Spacing="6">
          <TextBlock Classes="card-title" Text="{loc:T 'Show pages with Nightly?'}" TextWrapping="Wrap" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="{loc:T 'Ombra can show pages in Nightly, a full browser engine it installs and runs with its own profile. Pages, sign-ins and downloads stay on this Mac. You can change this in Settings › General.'}" />
        </StackPanel>
        <WrapPanel ItemSpacing="8" LineSpacing="8">
          <Button x:Name="NightlyAcceptButton" Classes="accent md" Content="{loc:T 'Use Nightly'}" Command="{Binding AcceptNightlyCommand}" />
          <Button x:Name="NightlyDeclineButton" Classes="outline md" Content="{loc:T 'Keep the built-in preview'}" Command="{Binding DeclineNightlyCommand}" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- ── Nightly was chosen but cannot show pages: the built-in preview does, and says why ── -->
    <Border x:Name="NightlyFallbackBar" DockPanel.Dock="Top" Classes="notice warning" Margin="8,8,8,0" IsVisible="{Binding ShowNightlyFallback}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" VerticalAlignment="Top">
          <Button x:Name="NightlyInstallButton" Classes="accent" Content="{loc:T 'Install Nightly'}" Command="{Binding InstallNightlyCommand}"
                  IsVisible="{Binding CanInstallNightly}" />
          <Button x:Name="NightlyRetryButton" Content="{loc:T 'Try again'}" Command="{Binding RetryNightlyCommand}"
                  IsVisible="{Binding !CanInstallNightly}" />
        </StackPanel>
        <ctl:Icon DockPanel.Dock="Left" Classes="warning-mark" Data="{StaticResource IconAlert}" Size="16" Margin="0,0,8,0" VerticalAlignment="Top" />
        <StackPanel Spacing="4">
          <TextBlock x:Name="NightlyFallbackText" Text="{Binding NightlyFallbackReason}" TextWrapping="Wrap" FontSize="{DynamicResource GuiFontS}" />
          <TextBlock Classes="tertiary" Text="{loc:T 'The built-in preview shows pages meanwhile.'}" TextWrapping="Wrap" />
          <TextBlock x:Name="NightlyInstallStatusText" Classes="tertiary" Text="{Binding NightlyInstallStatus}" TextWrapping="Wrap"
                     IsVisible="{Binding NightlyInstallStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <StackPanel Spacing="4" IsVisible="{Binding HasNightlyFallbackDetail}">
            <ToggleButton x:Name="NightlyDetailToggle" Classes="thinking-toggle" AutomationProperties.Name="{loc:T 'Show details'}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{loc:T 'Show details'}" VerticalAlignment="Center" />
                <ctl:Icon Classes="chevron" Data="{StaticResource IconChevronRight}" Size="16" />
              </StackPanel>
            </ToggleButton>
            <SelectableTextBlock x:Name="NightlyFallbackDetailText" Classes="mono muted" Text="{Binding NightlyFallbackDetail}" TextWrapping="Wrap"
                                 FontSize="{DynamicResource GuiFontXs}" IsVisible="{Binding #NightlyDetailToggle.IsChecked}" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ── Downloads (saved where the user chose; the folder opens from here) ── -->
    <Border x:Name="DownloadsStrip" DockPanel.Dock="Bottom" Classes="preview-downloads" IsVisible="{Binding HasDownloads}">
      <DockPanel>
        <Button x:Name="ClearDownloadsButton" DockPanel.Dock="Right" Classes="icon sm" VerticalAlignment="Top"
                Command="{Binding ClearDownloadsCommand}" ToolTip.Tip="{loc:T 'Clear finished downloads'}" AutomationProperties.Name="{loc:T 'Clear downloads'}">
          <ctl:Icon Data="{StaticResource IconClose}" Size="16" />
        </Button>
        <ScrollViewer MaxHeight="132" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="DownloadItems" ItemsSource="{Binding Downloads.Items}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="cb:BrowserDownload">
                <DockPanel AutomationProperties.Name="{Binding FileName}">
                  <Button DockPanel.Dock="Right" Classes="md" Content="{loc:T 'Show in Finder'}" IsVisible="{Binding IsFinished}" Margin="8,0,0,0"
                          Command="{Binding $parent[ItemsControl].((vm:PreviewViewModel)DataContext).ShowDownloadCommand}" CommandParameter="{Binding}"
                          AutomationProperties.Name="{loc:T 'Show in Finder'}" />
                  <Button DockPanel.Dock="Right" Classes="md" Content="{loc:T 'Stop'}" IsVisible="{Binding IsActive}" Margin="8,0,0,0"
                          Command="{Binding $parent[ItemsControl].((vm:PreviewViewModel)DataContext).CancelDownloadCommand}" CommandParameter="{Binding}"
                          AutomationProperties.Name="{loc:T 'Stop download'}" />
                  <ctl:Icon DockPanel.Dock="Left" Data="{StaticResource IconDownload}" Size="16" Margin="0,2,8,0" VerticalAlignment="Top"
                            TextElement.Foreground="{DynamicResource GuiTextSecondary}" />
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource GuiFontS}"
                               ToolTip.Tip="{Binding Path}" />
                    <TextBlock Classes="tertiary" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource GuiFontXs}">
                      <TextBlock.Text>
                        <MultiBinding Converter="{x:Static vm:Converters.DownloadStatus}">
                          <Binding Path="State" />
                          <Binding Path="BytesReceived" />
                          <Binding Path="TotalBytes" />
                          <Binding Path="Error" />
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Panel x:Name="PageArea">
      <!-- Empty: nothing opened yet -->
      <StackPanel x:Name="EmptyState" IsVisible="{Binding ShowEmptyState}" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Spacing="8" Margin="24" MaxWidth="360">
        <ctl:Icon Classes="pane-empty-mark" Data="{StaticResource IconGlobe}" Size="28" />
        <TextBlock Classes="muted" Text="{Binding EmptyText}" TextWrapping="Wrap" TextAlignment="Center" />
      </StackPanel>

      <!-- The platform's engine is missing: offer the system browser -->
      <Border x:Name="FallbackCard" Classes="card" IsVisible="{Binding ShowFallback}" HorizontalAlignment="Center" VerticalAlignment="Center"
              Margin="24" MaxWidth="420">
        <StackPanel Spacing="12">
          <StackPanel Spacing="6">
            <DockPanel>
              <ctl:Icon DockPanel.Dock="Left" Classes="warning-mark" Data="{StaticResource IconAlert}" Size="16" Margin="0,1,10,0" VerticalAlignment="Top" />
              <TextBlock Classes="card-title" Text="{Binding FallbackText}" TextWrapping="Wrap" />
            </DockPanel>
            <TextBlock Classes="muted" Text="{Binding EngineDetail}" TextWrapping="Wrap" IsVisible="{Binding EngineDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <Button x:Name="FallbackOpenButton" Classes="accent md" Content="{loc:T 'Open in browser'}" Command="{Binding OpenExternallyCommand}"
                  HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <!-- The page's web process ended: no blank page, one click brings it back -->
      <Border x:Name="CrashPage" Classes="card" IsVisible="{Binding ShowCrashPage}" HorizontalAlignment="Center" VerticalAlignment="Center"
              Margin="24" MaxWidth="420">
        <StackPanel Spacing="12">
          <StackPanel Spacing="6">
            <DockPanel>
              <ctl:Icon DockPanel.Dock="Left" Classes="warning-mark" Data="{StaticResource IconAlert}" Size="16" Margin="0,1,10,0" VerticalAlignment="Top" />
              <TextBlock Classes="card-title" Text="{loc:T 'This page stopped working'}" TextWrapping="Wrap" />
            </DockPanel>
            <TextBlock Classes="muted" Text="{loc:T 'Its web content process ended. Reload to open it again.'}" TextWrapping="Wrap" />
          </StackPanel>
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button x:Name="CrashReloadButton" Classes="accent md" Content="{loc:T 'Reload'}" Command="{Binding ReloadCommand}" />
            <Button x:Name="CrashOpenExternallyButton" Classes="outline md" Content="{loc:T 'Open in browser'}" Command="{Binding OpenExternallyCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- The navigation failed (server unreachable, refused certificate…): why, and Try again -->
      <Border x:Name="ErrorPage" Classes="card" IsVisible="{Binding ShowErrorPage}" HorizontalAlignment="Center" VerticalAlignment="Center"
              Margin="24" MaxWidth="420">
        <StackPanel Spacing="12">
          <StackPanel Spacing="6">
            <DockPanel>
              <ctl:Icon DockPanel.Dock="Left" Classes="error-mark" Data="{StaticResource IconAlertCircle}" Size="16" Margin="0,1,10,0" VerticalAlignment="Top" />
              <TextBlock x:Name="ErrorPageTitle" Classes="card-title" Text="{Binding ErrorTitle}" TextWrapping="Wrap" />
            </DockPanel>
            <SelectableTextBlock x:Name="ErrorPageDetail" Classes="muted" Text="{Binding ErrorDetail}" TextWrapping="Wrap" />
          </StackPanel>
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button x:Name="ErrorRetryButton" Classes="accent md" Content="{loc:T 'Try again'}" Command="{Binding ReloadCommand}" />
            <Button x:Name="ErrorOpenExternallyButton" Classes="outline md" Content="{loc:T 'Open in browser'}" Command="{Binding OpenExternallyCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- The pages: PreviewPanel.axaml.cs puts one NativeWebView per tab here (the active tab's shows), and pop-ups' own views -->
      <Panel x:Name="WebHost" IsVisible="{Binding ShowWebView}" />
      <!-- A pop-up of the window (a tooltip, a menu) over the page: macOS draws it inside the window, under the native web
           view, so until it closes the page shows as the picture taken when it opened (PreviewPanel.axaml.cs) -->
      <Image x:Name="PageUnderPopup" Source="{Binding PageUnderPopup}" IsVisible="{Binding PageUnderPopup, Converter={x:Static ObjectConverters.IsNotNull}}"
             Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" />

      <!-- ── A question from the page (sign-in, alert, file, download, permission, popup): BrowserDialogsViewModel ──
           The native web view draws over anything here, so while a card is open it is hidden and the page shows as the
           picture taken just before (or the plain surface) under a scrim. One card at a time; Enter answers with the
           main button, Esc cancels. -->
      <Panel x:Name="BrowserDialogLayer" IsVisible="{Binding Dialogs.IsOpen}" ClipToBounds="True">
        <Image x:Name="BrowserDialogSnapshot" Source="{Binding Dialogs.Snapshot}" IsVisible="{Binding Dialogs.HasSnapshot}"
               Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <Border Background="{DynamicResource GuiBackdrop}" />
        <ContentControl x:Name="BrowserDialogHost" Content="{Binding Dialogs.Card}" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        MaxWidth="400" Margin="16">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:BrowserDialogCardViewModel">
              <Border x:Name="BrowserDialogCard" Classes="dialog browser-dialog" Background="{DynamicResource GuiSurface1}" BoxShadow="{DynamicResource GuiShadowPopup}"
                      AutomationProperties.Name="{Binding Title}">
                <Border.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding PrimaryCommand}" />
                  <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
                </Border.KeyBindings>
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <ctl:Icon x:Name="BrowserDialogIcon" Classes="dialog-mark" Size="16" Margin="0,1,10,0" VerticalAlignment="Top" />
                    <SelectableTextBlock x:Name="BrowserDialogTitle" Grid.Column="1" Classes="dialog-title" Text="{Binding Title}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="tertiary" Text="{Binding QueueText}" IsVisible="{Binding HasQueue}" Margin="12,0,0,0"
                               VerticalAlignment="Center" ToolTip.Tip="{loc:T 'More questions from this page are waiting'}" />
                  </Grid>
                  <TextBlock Classes="muted" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" TextWrapping="Wrap" Margin="0,-6,0,0" />
                  <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasMessage}">
                    <SelectableTextBlock x:Name="BrowserDialogMessage" Text="{Binding Message}" TextWrapping="Wrap" FontSize="{DynamicResource GuiFontUi}" />
                  </ScrollViewer>
                  <DockPanel IsVisible="{Binding HasError}">
                    <ctl:Icon DockPanel.Dock="Left" Classes="error-mark" Data="{StaticResource IconAlertCircle}" Size="16" Margin="0,1,8,0" VerticalAlignment="Top" />
                    <TextBlock Classes="error" Text="{Binding Error}" TextWrapping="Wrap" />
                  </DockPanel>
                  <DockPanel IsVisible="{Binding HasWarning}">
                    <ctl:Icon DockPanel.Dock="Left" Classes="warning-mark" Data="{StaticResource IconAlert}" Size="16" Margin="0,1,8,0" VerticalAlignment="Top" />
                    <TextBlock Classes="warning" Text="{Binding Warning}" TextWrapping="Wrap" />
                  </DockPanel>
                  <StackPanel Spacing="8" IsVisible="{Binding IsCredentials}">
                    <TextBox x:Name="BrowserDialogUser" Text="{Binding UserName}" PlaceholderText="{loc:T 'Username'}" AutomationProperties.Name="{loc:T 'Username'}" />
                    <TextBox x:Name="BrowserDialogPassword" Text="{Binding Password}" PasswordChar="•" PlaceholderText="{loc:T 'Password'}" AutomationProperties.Name="{loc:T 'Password'}" />
                  </StackPanel>
                  <TextBox x:Name="BrowserDialogPrompt" Text="{Binding PromptText}" IsVisible="{Binding IsPrompt}" AutomationProperties.Name="{loc:T 'Answer'}" />
                  <TextBlock Classes="muted" Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" />
                  <!-- Two answers: in a row, the main one last. Three (permission, download): stacked full width, the main one first. -->
                  <WrapPanel ItemSpacing="8" LineSpacing="8" HorizontalAlignment="Right" IsVisible="{Binding !HasTertiary}">
                    <Button x:Name="BrowserDialogSecondary" Classes="md outline" Content="{Binding SecondaryLabel}" Command="{Binding SecondaryCommand}" IsVisible="{Binding HasSecondary}"
                            AutomationProperties.Name="{Binding SecondaryLabel}" ToolTip.Tip="Esc" />
                    <Button x:Name="BrowserDialogPrimary" Classes="accent md" MinWidth="88" Content="{Binding PrimaryLabel}" Command="{Binding PrimaryCommand}"
                            AutomationProperties.Name="{Binding PrimaryLabel}" ToolTip.Tip="Enter" />
                  </WrapPanel>
                  <StackPanel Spacing="8" IsVisible="{Binding HasTertiary}">
                    <Button x:Name="BrowserDialogPrimaryStacked" Classes="accent md" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Content="{Binding PrimaryLabel}" Command="{Binding PrimaryCommand}" AutomationProperties.Name="{Binding PrimaryLabel}" ToolTip.Tip="Enter" />
                    <Button x:Name="BrowserDialogTertiary" Classes="md outline" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Content="{Binding TertiaryLabel}" Command="{Binding TertiaryCommand}" AutomationProperties.Name="{Binding TertiaryLabel}" />
                    <Button x:Name="BrowserDialogSecondaryStacked" Classes="md outline" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Content="{Binding SecondaryLabel}" Command="{Binding SecondaryCommand}" AutomationProperties.Name="{Binding SecondaryLabel}" ToolTip.Tip="Esc" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </Panel>
    </Panel>
  </DockPanel>
</UserControl>
