<!-- Four or more pages of one site in a tab strip (TabSiteGroup): one chip in place of their tabs — the site's globe,
     its name, how many, a chevron — whose list opens downward under it (the strip has no room to the right). A row: the
     page's title, its × on the row under the pointer and the page shown. Picking a row shows the page and closes the
     list; × closes the page and keeps the list open. The right panel's strip and the Browser page's both use it
     (SelectCommand / CloseCommand take the PreviewTab). Motion: TabGroupChip.axaml.cs. -->
<UserControl xmlns:loc="using:Ombra.App.Localization"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ombra.App.ViewModels"
             xmlns:ctl="using:Ombra.App.Controls"
             x:Class="Ombra.App.Controls.TabGroupChip"
             x:Name="Root">
  <UserControl.Styles>
    <Style Selector="Border.tab-group-count">
      <Setter Property="Background" Value="{DynamicResource GuiFill2}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.tab-group-count TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource GuiFontXs}" />
      <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ctl|Icon.tab-group-chevron">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextTertiary}" />
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
    </Style>
    <Style Selector="ctl|Icon.tab-group-chevron.open">
      <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>
    <!-- A row of the list: × only on the page shown and the row under the pointer, as on the strip's tabs -->
    <Style Selector="Panel.tab-group-row Button.tab-group-close">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Panel.tab-group-row:pointerover Button.tab-group-close, Panel.tab-group-row.current Button.tab-group-close, Button.tab-group-close:focus-visible">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <Border x:Name="Chip" x:DataType="vm:TabSiteGroup" DataContext="{Binding #Root.Group}" Classes="panel-tab" Classes.active="{Binding #Root.IsActive}" MinWidth="112">
    <Panel>
      <Button x:Name="ChipButton" Classes="flat panel-tab-button" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
              Click="OnChipClick" ToolTip.Tip="{Binding ToolTip}" AutomationProperties.Name="{Binding ToolTip}">
        <DockPanel>
          <Panel DockPanel.Dock="Left" Width="14" Margin="0,0,6,0" VerticalAlignment="Center">
            <ctl:Icon Data="{StaticResource IconGlobe}" Size="16" IsVisible="{Binding !IsLoading}" />
            <Ellipse Classes="state-dot running" IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Panel>
          <ctl:Icon x:Name="Chevron" DockPanel.Dock="Right" Classes="tab-group-chevron" Classes.open="{Binding IsOpen}" ctl:Motion.Kind="Chevron"
                    Data="{StaticResource IconChevronDown}" Size="14" Margin="4,0,4,0" VerticalAlignment="Center" />
          <Border DockPanel.Dock="Right" Classes="tab-group-count">
            <TextBlock x:Name="CountText" Text="{Binding Count}" />
          </Border>
          <TextBlock x:Name="LabelText" Classes="panel-tab-title" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </DockPanel>
      </Button>
      <!-- Under the chip, its left edge on the chip's; the margin is the shadow's room -->
      <Popup x:Name="ListPopup" IsOpen="{Binding IsOpen, Mode=TwoWay}" PlacementTarget="{Binding #Chip}" Placement="BottomEdgeAlignedLeft"
             IsLightDismissEnabled="True" OverlayDismissEventPassThrough="False" Opened="OnListOpened">
        <Border x:Name="ListCard" Classes="menu" Width="300" Margin="0,6,12,12" AutomationProperties.Name="{Binding Label}">
          <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
          <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Rows" ItemsSource="{Binding Members}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PreviewTab">
                  <Panel Classes="tab-group-row" Classes.current="{Binding IsActive}">
                    <Panel.RenderTransform><TranslateTransform /></Panel.RenderTransform>
                    <Button Classes="menu-item" Classes.current="{Binding IsActive}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Padding="8,5,32,5" Click="OnRowClick" ToolTip.Tip="{Binding ToolTip}" AutomationProperties.Name="{Binding Header}">
                      <DockPanel>
                        <Panel DockPanel.Dock="Left" Width="16" Margin="0,0,10,0" VerticalAlignment="Center">
                          <ctl:Icon Data="{StaticResource IconGlobe}" Size="16" IsVisible="{Binding !IsLoading}" />
                          <Ellipse Classes="state-dot running" IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Panel>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                          <TextBlock Text="{Binding Header}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="tertiary" Text="{Binding ShortAddress}" FontSize="{DynamicResource GuiFontXs}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DockPanel>
                    </Button>
                    <Button Classes="icon tab-group-close" Width="20" Height="20" Margin="0,0,6,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                            IsVisible="{Binding CanClose}" Click="OnRowCloseClick"
                            ToolTip.Tip="{loc:T 'Close tab'}" AutomationProperties.Name="{loc:T 'Close tab'}">
                      <ctl:Icon Data="{StaticResource IconClose}" Size="14" />
                    </Button>
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </Popup>
    </Panel>
  </Border>
</UserControl>
