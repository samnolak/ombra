<!-- Styles for pets, on the design system's tokens (Tokens.axaml), as in Styles.axaml. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Ombra.App.Controls">

  <!-- The pet: a hand cursor says it can be clicked (and dragged) -->
  <Style Selector="ctl|OniView.perched">
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ctl|OniView.perched.dragging">
    <Setter Property="Cursor" Value="SizeAll" />
  </Style>
  <!-- While the model menu is open over the message box the pet steps out of its way -->
  <Style Selector="ctl|PetPerch">
    <Setter Property="Transitions">
      <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.12" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="ctl|PetPerch.under-menu">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!-- Its message box: a small popup surface beside the pet; the card is the field, the text box stays bare -->
  <Style Selector="Border.pet-chat">
    <Setter Property="Width" Value="300" />
    <Setter Property="Background" Value="{DynamicResource GuiSurface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GuiBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadius12}" />
    <Setter Property="BoxShadow" Value="{DynamicResource GuiShadowPopup}" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <Style Selector="TextBox.pet-chat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource GuiFontS}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.pet-chat:not(:disabled) /template/ TextBlock#PART_Placeholder">
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- Its speech bubble: a small menu surface with a tail pointing at the pet -->
  <Style Selector="Border.pet-bubble">
    <Setter Property="Background" Value="{DynamicResource GuiSurface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GuiBorderSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadius12}" />
    <Setter Property="BoxShadow" Value="{DynamicResource GuiShadow}" />
    <Setter Property="Padding" Value="10,5" />
  </Style>
  <Style Selector="Border.pet-bubble TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <Style Selector="Path.pet-bubble-tail">
    <Setter Property="Fill" Value="{DynamicResource GuiSurface2}" />
    <Setter Property="Stroke" Value="{DynamicResource GuiBorderSoft}" />
    <Setter Property="StrokeThickness" Value="1" />
  </Style>

  <!-- Settings: the preview stage and the preview's choices -->
  <Style Selector="Border.pet-stage">
    <Setter Property="Background" Value="{DynamicResource GuiFill1OnSurface1}" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadius12}" />
  </Style>
  <Style Selector="Button.chip.pet-choice">
    <Setter Property="Background" Value="{DynamicResource GuiFill1}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.chip.pet-choice.small">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.chip.pet-choice.selected">
    <Setter Property="Background" Value="{DynamicResource GuiInverse}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextOnInverse}" />
  </Style>
  <Style Selector="Button.chip.pet-choice.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GuiInverseHover}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextOnInverse}" />
  </Style>
  <Style Selector="Button.flat.danger-text">
    <Setter Property="Foreground" Value="{DynamicResource GuiTextError}" />
  </Style>
</Styles>
