<!-- Active context and account-stage status from the session connection. Full provider reports live in Settings. -->
<UserControl xmlns:loc="using:Ombra.App.Localization"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ombra.App.ViewModels"
             xmlns:ctl="using:Ombra.App.Controls"
             x:Class="Ombra.App.Views.Session.UsageIndicator"
             x:DataType="vm:MainViewModel">
  <Panel>
    <Button x:Name="RingButton" Classes="chip ghost usage-ring" Command="{Binding Usage.ToggleCommand}" IsVisible="{Binding Usage.HasIndicator}"
            ToolTip.Tip="{Binding Usage.Tooltip}" AutomationProperties.Name="{Binding Usage.AccessibleName}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <ctl:UsageRing x:Name="Ring" Value="{Binding Usage.Percent, FallbackValue=0, TargetNullValue=0}" Size="16" VerticalAlignment="Center"
                       IsVisible="{Binding Usage.HasPercent}" Classes.warn="{Binding Usage.IsWarn}" Classes.full="{Binding Usage.IsFull}" />
        <TextBlock x:Name="PercentText" Classes="usage-percent" Text="{Binding Usage.PercentText}" IsVisible="{Binding Usage.HasPercent}" VerticalAlignment="Center" />
        <TextBlock x:Name="UsageLimitBadge" Classes="warning" Text="{Binding Usage.LimitBadge}" IsVisible="{Binding Usage.HasUsageLimit}"
                   ToolTip.Tip="{Binding Usage.LimitStatus}" AutomationProperties.Name="{Binding Usage.LimitStatus}" VerticalAlignment="Center" />
      </StackPanel>
    </Button>
    <Popup x:Name="UsagePopup" IsOpen="{Binding Usage.IsOpen, Mode=TwoWay}" PlacementTarget="{Binding #RingButton}"
           Placement="TopEdgeAlignedRight" IsLightDismissEnabled="True" VerticalOffset="-6">
      <Border x:Name="UsagePopover" Classes="menu usage-popover" Width="360" Margin="12">
        <!-- Scrolls in a short window (UsageIndicator.axaml.cs caps it) instead of running into the window's top edge -->
        <ScrollViewer x:Name="UsageScroll" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10" Margin="10,8,10,10">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Classes="caps" Text="{loc:T 'Context window'}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="tertiary" Text="{loc:T 'Updating…'}" IsVisible="{Binding Usage.IsLoading}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button Grid.Column="2" Classes="icon sm" Command="{Binding Usage.RefreshCommand}" ToolTip.Tip="{loc:T 'Measure again'}"
                    AutomationProperties.Name="{loc:T 'Refresh usage'}">
              <ctl:Icon Data="{StaticResource IconReload}" Size="16" />
            </Button>
          </Grid>
          <TextBlock x:Name="ContextHeadline" Classes="usage-headline" Text="{Binding Usage.ContextHeadline}" TextWrapping="Wrap" />
          <ItemsControl x:Name="ContextBars" ItemsSource="{Binding Usage.ContextRows}" IsVisible="{Binding Usage.HasContext}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ContextRowViewModel">
                <Grid Classes="usage-row" ColumnDefinitions="148,*,Auto" ToolTip.Tip="{Binding Tooltip}" AutomationProperties.Name="{Binding Tooltip}">
                  <TextBlock Classes="usage-label" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <ProgressBar Grid.Column="1" Classes="usage-bar" Classes.free="{Binding IsFree}" Classes.reserve="{Binding IsReserve}"
                               Value="{Binding Value}" Maximum="100" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Classes="usage-value" Text="{Binding Tokens}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="tertiary" Text="{Binding Usage.ContextNote}" TextWrapping="Wrap"
                     IsVisible="{Binding Usage.ContextNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <Border Height="1" Background="{DynamicResource GuiBorderSoft}" />
          <TextBlock Classes="caps" Text="{loc:T 'This session'}" IsVisible="{Binding Usage.HasTotals}" />
          <ItemsControl x:Name="UsageTotals" ItemsSource="{Binding Usage.Totals}" IsVisible="{Binding Usage.HasTotals}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:UsageTotalViewModel">
                <Grid Classes="usage-row" ColumnDefinitions="*,Auto">
                  <TextBlock Classes="usage-label" Text="{Binding Label}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="usage-value" Text="{Binding Value}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="caps" Text="{loc:T 'Active account limit'}" IsVisible="{Binding Usage.HasUsageLimit}" VerticalAlignment="Center" />
            <Button x:Name="AllProvidersButton" Grid.Column="1" Classes="link action" Content="{loc:T 'All providers'}" Command="{Binding Usage.ShowAllProvidersCommand}"
                    VerticalAlignment="Center" ToolTip.Tip="{loc:T 'Every signed-in provider’s limits (Settings → Model providers)'}" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding Usage.HasUsageLimit}">
            <ctl:Icon Classes="warning-mark" Data="{StaticResource IconAlert}" Size="16" VerticalAlignment="Top" Margin="0,0,8,0" />
            <TextBlock x:Name="UsageLimitStatus" Grid.Column="1" Classes="warning" Text="{Binding Usage.LimitStatus}" TextWrapping="Wrap" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding Usage.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <ctl:Icon Classes="warning-mark" Data="{StaticResource IconAlert}" Size="16" VerticalAlignment="Top" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Classes="warning" Text="{Binding Usage.Error}" TextWrapping="Wrap" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Button x:Name="CompactNowButton" Classes="accent" Content="{loc:T 'Compact now'}" Command="{Binding Usage.CompactNowCommand}"
                    ToolTip.Tip="{loc:T 'omp summarizes the conversation and goes on from the summary (/compact)'}" />
            <Button x:Name="DashboardButton" Grid.Column="2" Classes="link action" Content="{loc:T 'Usage dashboard'}" Command="{Binding Usage.OpenDashboardCommand}"
                    VerticalAlignment="Center" ToolTip.Tip="{loc:T 'omp’s local dashboard of tokens and cost across all sessions (/stats)'}" />
          </Grid>
        </StackPanel>
        </ScrollViewer>
      </Border>
    </Popup>
  </Panel>
</UserControl>
