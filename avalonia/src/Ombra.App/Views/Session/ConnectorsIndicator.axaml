<!-- The chat's connectors (MCP servers) under the message box: a plug while omp runs, with what needs the user next to
     it (a sign-in, a server that failed); its popover lists each server's state in this chat with Sign in, Reconnect,
     Reload config and the way to Settings → Plugins → MCP (ConnectorsViewModel.Chat.cs). -->
<UserControl xmlns:loc="using:Ombra.App.Localization"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ombra.App.ViewModels"
             xmlns:ctl="using:Ombra.App.Controls"
             x:Class="Ombra.App.Views.Session.ConnectorsIndicator"
             x:DataType="vm:MainViewModel">
  <Panel DataContext="{Binding Connectors}" x:DataType="vm:ConnectorsViewModel">
    <Button x:Name="ConnectorsButton" Classes="chip ghost" Command="{Binding ToggleChatCommand}" IsVisible="{Binding IsChatAvailable}"
            ToolTip.Tip="{loc:T 'Connectors (MCP servers) of this chat: status, sign-in, reconnect'}" AutomationProperties.Name="{Binding ChipName}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Panel VerticalAlignment="Center">
          <ctl:Icon Data="{StaticResource IconPlug}" Size="16" IsVisible="{Binding !HasChatAttention}" />
          <ctl:Icon Classes="warning-mark" Data="{StaticResource IconPlug}" Size="16" IsVisible="{Binding HasChatAttention}" />
        </Panel>
        <!-- Shed first when the row is narrow (Styles.Composer.axaml): the plug's colour still says it -->
        <Panel Classes="connectors-label" VerticalAlignment="Center">
          <TextBlock x:Name="ConnectorsChipLabel" Classes="warning" Text="{Binding ChipLabel}" IsVisible="{Binding HasChatAttention}"
                     MaxWidth="260" TextTrimming="CharacterEllipsis" />
        </Panel>
      </StackPanel>
    </Button>
    <Popup x:Name="ConnectorsPopup" IsOpen="{Binding IsChatOpen, Mode=TwoWay}" PlacementTarget="{Binding #ConnectorsButton}"
           Placement="TopEdgeAlignedRight" IsLightDismissEnabled="True" VerticalOffset="-6">
      <Border x:Name="ConnectorsPopover" Classes="menu usage-popover" Width="380" Margin="12">
        <ScrollViewer x:Name="ConnectorsScroll" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="10" Margin="10,8,10,10">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBlock Classes="caps" Text="{loc:T 'Connectors'}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="tertiary" Text="{loc:T 'Updating…'}" IsVisible="{Binding IsChatLoading}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <Button Grid.Column="2" Classes="icon sm" Command="{Binding LoadChatCommand}" ToolTip.Tip="{loc:T 'Ask omp again'}"
                      AutomationProperties.Name="{loc:T 'Refresh connectors'}">
                <ctl:Icon Data="{StaticResource IconReload}" Size="16" />
              </Button>
            </Grid>
            <TextBlock x:Name="ConnectorsChatEmpty" Classes="tertiary" TextWrapping="Wrap" IsVisible="{Binding ShowChatEmpty}"
                       Text="{loc:T 'This chat has no MCP servers. Add one in Settings → Plugins → MCP, or add it to mcp.json and reload the config.'}" />
            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasChatError}">
              <ctl:Icon Classes="warning-mark" Data="{StaticResource IconAlert}" Size="16" VerticalAlignment="Top" Margin="0,0,8,0" />
              <SelectableTextBlock x:Name="ConnectorsChatError" Grid.Column="1" Classes="warning" Text="{Binding ChatError}" TextWrapping="Wrap" />
            </Grid>
            <ItemsControl x:Name="ChatConnectorList" ItemsSource="{Binding ChatServers}" IsVisible="{Binding HasChatServers}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatConnectorViewModel">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Panel VerticalAlignment="Center" Margin="0,0,8,0">
                        <ctl:Icon Data="{StaticResource IconPlug}" Size="16" IsVisible="{Binding !IsRemote}" />
                        <ctl:Icon Data="{StaticResource IconGlobe}" Size="16" IsVisible="{Binding IsRemote}" />
                      </Panel>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                        <Border Classes="status" Classes.done="{Binding IsConnected}" Classes.failed="{Binding IsFailed}" Classes.running="{Binding IsWorking}"
                                Classes.stopped="{Binding IsStopped}" HorizontalAlignment="Left" Background="Transparent" Padding="0"
                                AutomationProperties.Name="{Binding StatusText}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse />
                            <TextBlock Text="{Binding StatusText}" />
                          </StackPanel>
                        </Border>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button Classes="accent" Content="{Binding SignInLabel}" Command="{Binding SignInCommand}" ctl:ContextMenus.DefaultBrowserSignIn="{Binding SignInInDefaultBrowserCommand}" IsVisible="{Binding CanSignIn}"
                                AutomationProperties.Name="{Binding Name, StringFormat={loc:T 'Sign in to {0}'}}" />
                        <Button Content="{loc:T 'Cancel sign-in'}" Command="{Binding CancelSignInCommand}" IsVisible="{Binding IsSigningIn}"
                                ToolTip.Tip="{loc:T 'Finish the sign-in in your browser. omp connects as soon as it’s done.'}"
                                AutomationProperties.Name="{Binding Name, StringFormat={loc:T 'Cancel the sign-in to {0}'}}" />
                        <Button Classes="outline" Content="{loc:T 'Reconnect'}" Command="{Binding ReconnectCommand}" IsVisible="{Binding CanReconnect}"
                                AutomationProperties.Name="{Binding Name, StringFormat={loc:T 'Reconnect {0}'}}" />
                        <TextBlock Classes="tertiary" Text="{loc:T 'Connecting…'}" IsVisible="{Binding IsReconnecting}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Grid>
                    <!-- omp's own words: why it did not connect, why the sign-in failed -->
                    <SelectableTextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
                                         FontSize="{DynamicResource GuiFontS}" Margin="24,0,0,0" />
                    <SelectableTextBlock Classes="error" Text="{Binding ActionError}" IsVisible="{Binding HasActionError}" TextWrapping="Wrap"
                                         FontSize="{DynamicResource GuiFontS}" Margin="24,0,0,0" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="ConnectorsChatNotice" Classes="tertiary" Text="{Binding ChatNotice}" IsVisible="{Binding HasChatNotice}" TextWrapping="Wrap" />
            <Border Height="1" Background="{DynamicResource GuiBorderSoft}" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Button x:Name="ChatReloadConfigButton" Command="{Binding ReloadConfigCommand}" IsEnabled="{Binding !IsReconnecting}"
                      ToolTip.Tip="{loc:T 'omp reads mcp.json again and reconnects every server, without a restart'}" AutomationProperties.Name="{loc:T 'Reload config'}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ctl:Icon Data="{StaticResource IconReload}" Size="16" VerticalAlignment="Center" />
                  <TextBlock Text="{loc:T 'Reload config'}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="ManageConnectorsButton" Grid.Column="2" Classes="link action" Content="{loc:T 'Manage connectors'}" Command="{Binding ManageConnectorsCommand}"
                      VerticalAlignment="Center" ToolTip.Tip="{loc:T 'Every MCP server, its switch and details (Settings → Plugins → MCP)'}" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Popup>
  </Panel>
</UserControl>
