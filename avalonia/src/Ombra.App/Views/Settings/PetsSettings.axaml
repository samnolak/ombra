<!-- Settings page "Pets": show ONI, its size, less motion, where it may go and where it is; a preview of every pose.
     All of it is the app's: omp has no pets. -->
<UserControl xmlns:loc="using:Ombra.App.Localization"
        xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ombra.App.ViewModels"
             xmlns:ctl="using:Ombra.App.Controls"
             x:Class="Ombra.App.Views.Settings.PetsSettings"
             x:DataType="vm:MainViewModel">
  <Panel DataContext="{Binding Pets}">
    <StackPanel x:DataType="vm:PetsViewModel" Spacing="16">

      <!-- Show the pet, size, motion, where it goes -->
      <Border Classes="section-card">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4">
            <TextBlock Classes="section" Text="{loc:T 'Pets'}" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="{loc:T 'ONI, a small masked oni with two spirit flames, sits on the message box. It thinks and works along with omp, waits with you when omp asks something, cheers when a run is done and winces when a tool fails. Click it to send omp a message; drag it anywhere on your screens, over your other apps, to keep an eye on omp from there.'}" />
          </StackPanel>
          <Border Classes="ws-sep" />
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Classes="ws-title" Text="{loc:T 'Show a pet'}" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="{loc:T 'On the top edge of the message box. It falls asleep when nothing happens and then stops moving.'}" />
            </StackPanel>
            <ToggleButton x:Name="ShowPetSwitch" Grid.Column="1" Classes="switch" IsChecked="{Binding ShowPet}"
                          AutomationProperties.Name="{loc:T 'Show a pet'}" VerticalAlignment="Center" />
          </Grid>
          <Border Classes="ws-sep" />
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Classes="ws-title" Text="{loc:T 'Size'}" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="{loc:T 'How tall the pet is, in points'}" />
            </StackPanel>
            <Border Grid.Column="1" Classes="segmented" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button x:Name="PetSize64" Classes="segment" Classes.selected="{Binding IsSize64}" Content="64"
                        Command="{Binding SetSizeCommand}" CommandParameter="64" AutomationProperties.Name="{loc:T 'Pet size: 64'}" />
                <Button x:Name="PetSize80" Classes="segment" Classes.selected="{Binding IsSize80}" Content="80"
                        Command="{Binding SetSizeCommand}" CommandParameter="80" AutomationProperties.Name="{loc:T 'Pet size: 80'}" />
                <Button x:Name="PetSize96" Classes="segment" Classes.selected="{Binding IsSize96}" Content="96"
                        Command="{Binding SetSizeCommand}" CommandParameter="96" AutomationProperties.Name="{loc:T 'Pet size: 96'}" />
              </StackPanel>
            </Border>
          </Grid>
          <Border Classes="ws-sep" />
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Classes="ws-title" Text="{loc:T 'Reduce motion'}" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="{loc:T 'The pet shows each pose still. Follows the system setting until you change it here.'}" />
            </StackPanel>
            <ToggleButton x:Name="PetReduceMotionSwitch" Grid.Column="1" Classes="switch" IsChecked="{Binding ReduceMotion}"
                          AutomationProperties.Name="{loc:T 'Reduce motion'}" VerticalAlignment="Center" />
          </Grid>
          <Border Classes="ws-sep" />
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Classes="ws-title" Text="{loc:T 'Roams'}" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="{loc:T 'Where you can drag it: anywhere on your screens, staying on top of other apps, or only inside this window'}" />
            </StackPanel>
            <Border Grid.Column="1" Classes="segmented" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button x:Name="PetRoamDesktop" Classes="segment" Classes.selected="{Binding IsRoamDesktop}" Content="{loc:T 'Whole desktop'}"
                        Command="{Binding SetRoamCommand}" CommandParameter="desktop" AutomationProperties.Name="{loc:T 'Pet roams the whole desktop'}" />
                <Button x:Name="PetRoamWindow" Classes="segment" Classes.selected="{Binding IsRoamWindow}" Content="{loc:T 'Inside the window'}"
                        Command="{Binding SetRoamCommand}" CommandParameter="window" AutomationProperties.Name="{loc:T 'Pet stays inside the window'}" />
              </StackPanel>
            </Border>
          </Grid>
          <Border Classes="ws-sep" />
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Classes="ws-title" Text="{loc:T 'Place'}" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding PlaceText}" />
            </StackPanel>
            <Button x:Name="PetReturnToPerch" Grid.Column="1" Content="{loc:T 'Reset position'}" VerticalAlignment="Center"
                    Command="{Binding ReturnToPerchCommand}" AutomationProperties.Name="{loc:T 'Put the pet back on the message box'}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- What it does when… -->
      <Border Classes="section-card">
        <StackPanel Spacing="14">
          <TextBlock Classes="section" Text="{loc:T 'What it does'}" />
          <Grid ColumnDefinitions="Auto,*">
            <Border Classes="pet-stage" Width="200" Height="190" ClipToBounds="True">
              <ctl:OniView x:Name="PetPreview" Pet="{Binding Preview}" HeightPx="{Binding PetHeight}" Reduced="{Binding ReduceMotion}"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22"
                           AutomationProperties.Name="{loc:T 'Preview'}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="8" Margin="20,0,0,0" VerticalAlignment="Center">
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="{loc:T 'Pick what happens to see how the pet takes it.'}" />
              <ItemsControl x:Name="PetPreviewChoices" ItemsSource="{Binding PreviewOptions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel ItemSpacing="4" LineSpacing="4" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PetPreviewOptionViewModel">
                    <Button Classes="chip pet-choice small" Classes.selected="{Binding IsSelected}" Content="{Binding Label}"
                            AutomationProperties.Name="{Binding Label, StringFormat={loc:T 'Preview: {0}'}}"
                            Command="{Binding $parent[ItemsControl].((vm:PetsViewModel)DataContext).ShowPreviewCommand}" CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </Panel>
</UserControl>
