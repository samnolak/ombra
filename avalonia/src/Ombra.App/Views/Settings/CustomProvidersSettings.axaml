<!-- Settings → Model providers, "Local and custom": model servers on this computer (Ollama, LM Studio, llama.cpp, vLLM)
     and providers of the user's own, both kept in omp's models.yml (CustomProvidersViewModel). -->
<UserControl xmlns:loc="using:Ombra.App.Localization"
        xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ombra.App.ViewModels"
             xmlns:ctl="using:Ombra.App.Controls"
             x:Class="Ombra.App.Views.Settings.CustomProvidersSettings"
             x:DataType="vm:MainViewModel">
  <Border x:Name="CustomProvidersCard" Classes="section-card" DataContext="{Binding CustomProviders}" x:DataType="vm:CustomProvidersViewModel">
    <StackPanel Spacing="12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="section" Text="{loc:T 'Local and custom'}" VerticalAlignment="Center" />
        <Button Grid.Column="1" x:Name="AddCustomProviderButton" Content="{loc:T 'Add custom provider…'}" Command="{Binding BeginAddCommand}"
                IsVisible="{Binding !IsFormOpen}" IsEnabled="{Binding CanChange}" />
      </Grid>
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="{loc:T 'Model servers on this computer and providers of your own. omp reads them from its models.yml when it starts: after each change here, omp restarts and its models appear in the model picker.'}" />

      <Border x:Name="CustomProvidersMessageBar" Classes="ws-note" Classes.ok="{Binding !MessageIsError}" Classes.error="{Binding MessageIsError}" IsVisible="{Binding HasMessage}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Panel Margin="0,0,10,0" VerticalAlignment="Top">
            <ctl:Icon Classes="ok-mark" Data="{StaticResource IconCheckCircle}" Size="16" IsVisible="{Binding !MessageIsError}" />
            <ctl:Icon Classes="error-mark" Data="{StaticResource IconAlertCircle}" Size="16" IsVisible="{Binding MessageIsError}" />
          </Panel>
          <SelectableTextBlock x:Name="CustomProvidersMessage" Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" FontSize="{DynamicResource GuiFontS}" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="icon" Width="24" Height="24" Margin="8,-4,-6,-4" VerticalAlignment="Top" Command="{Binding DismissMessageCommand}"
                  ToolTip.Tip="{loc:T 'Dismiss'}" AutomationProperties.Name="{loc:T 'Dismiss'}">
            <ctl:Icon Data="{StaticResource IconClose}" Size="16" />
          </Button>
        </Grid>
      </Border>
      <Border Classes="ws-note error" IsVisible="{Binding HasLoadError}">
        <SelectableTextBlock x:Name="CustomProvidersLoadError" Text="{Binding LoadError}" TextWrapping="Wrap" FontSize="{DynamicResource GuiFontS}" />
      </Border>

      <!-- Add or edit a custom provider: name (→ provider id), address, protocol, key, models -->
      <Border x:Name="CustomProviderForm" Classes="ws-form" IsVisible="{Binding IsFormOpen}">
        <StackPanel Spacing="10">
          <TextBlock Classes="ws-title" Text="{Binding FormTitle}" />
          <StackPanel Spacing="4" IsVisible="{Binding IsNew}">
            <TextBlock Classes="label" Text="{loc:T 'Name'}" />
            <TextBox x:Name="CustomProviderNameBox" Classes="sm" Text="{Binding FormName}" PlaceholderText="{loc:T 'My server'}" AutomationProperties.Name="{loc:T 'Provider name'}" />
            <TextBlock Classes="tertiary" Text="{Binding FormIdNote}" IsVisible="{Binding FormIdNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="{loc:T 'Address (base URL)'}" />
            <TextBox x:Name="CustomProviderUrlBox" Classes="sm" Text="{Binding FormBaseUrl}" PlaceholderText="{Binding BaseUrlHint}" AutomationProperties.Name="{loc:T 'Base URL'}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="{loc:T 'Speaks'}" />
            <Border Classes="segmented" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button x:Name="CustomProviderApiChat" Classes="segment" Classes.selected="{Binding FormApiIsChat}" Content="OpenAI Chat Completions"
                        Command="{Binding SetApiCommand}" CommandParameter="openai-completions" AutomationProperties.Name="{loc:T 'OpenAI-compatible Chat Completions'}" />
                <Button x:Name="CustomProviderApiResponses" Classes="segment" Classes.selected="{Binding FormApiIsResponses}" Content="OpenAI Responses"
                        Command="{Binding SetApiCommand}" CommandParameter="openai-responses" AutomationProperties.Name="OpenAI Responses" />
                <Button x:Name="CustomProviderApiAnthropic" Classes="segment" Classes.selected="{Binding FormApiIsAnthropic}" Content="Anthropic Messages"
                        Command="{Binding SetApiCommand}" CommandParameter="anthropic-messages" AutomationProperties.Name="Anthropic Messages" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="{loc:T 'API key (optional)'}" />
            <TextBox x:Name="CustomProviderKeyBox" Classes="sm" Text="{Binding FormApiKey}" PasswordChar="•" PlaceholderText="{loc:T 'sk-…, or the name of an environment variable that holds it'}"
                     AutomationProperties.Name="{loc:T 'API key'}" />
            <TextBlock Classes="tertiary" TextWrapping="Wrap" Text="{loc:T 'Saved in omp’s models.yml, which only your user can read. Leave it empty for a server that needs no key.'}" />
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="{loc:T 'Models'}" />
            <Border Classes="segmented" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button x:Name="CustomProviderDiscover" Classes="segment" Classes.selected="{Binding FormDiscover}" Content="{loc:T 'Discover from the server'}"
                        Command="{Binding SetDiscoverCommand}" CommandParameter="true" AutomationProperties.Name="{loc:T 'Discover models from the server'}" />
                <Button x:Name="CustomProviderListModels" Classes="segment" Classes.selected="{Binding FormListsModels}" Content="{loc:T 'List them'}"
                        Command="{Binding SetDiscoverCommand}" CommandParameter="false" AutomationProperties.Name="{loc:T 'List the models'}" />
              </StackPanel>
            </Border>
            <TextBlock Classes="tertiary" TextWrapping="Wrap" IsVisible="{Binding FormDiscover}"
                       Text="{loc:T 'omp asks the server for its models each time it starts.'}" />
            <TextBox x:Name="CustomProviderModelsBox" Classes="sm" Text="{Binding FormModels}" IsVisible="{Binding FormListsModels}"
                     AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="72" MaxHeight="160" PlaceholderText="{loc:T 'One model id per line'}"
                     AutomationProperties.Name="{loc:T 'Model ids'}" />
          </StackPanel>
          <Border Classes="ws-note" Classes.ok="{Binding TestOk}" Classes.error="{Binding !TestOk}" IsVisible="{Binding HasTestResult}">
            <Grid ColumnDefinitions="Auto,*">
              <Panel Margin="0,0,10,0" VerticalAlignment="Top">
                <ctl:Icon Classes="ok-mark" Data="{StaticResource IconCheckCircle}" Size="16" IsVisible="{Binding TestOk}" />
                <ctl:Icon Classes="error-mark" Data="{StaticResource IconCrossCircle}" Size="16" IsVisible="{Binding !TestOk}" />
              </Panel>
              <SelectableTextBlock x:Name="CustomProviderTestResult" Grid.Column="1" Text="{Binding TestResult}" TextWrapping="Wrap" FontSize="{DynamicResource GuiFontS}" />
            </Grid>
          </Border>
          <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasFormError}">
            <ctl:Icon Classes="error-mark" Data="{StaticResource IconAlertCircle}" Size="16" Margin="0,0,8,0" VerticalAlignment="Top" />
            <SelectableTextBlock x:Name="CustomProviderFormError" Grid.Column="1" Text="{Binding FormError}" TextWrapping="Wrap" FontSize="{DynamicResource GuiFontS}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="CustomProviderSave" Classes="accent" Content="{loc:T 'Save'}" Command="{Binding SaveFormCommand}" IsEnabled="{Binding CanChange}" />
            <Button x:Name="CustomProviderTest" Classes="outline" Content="{loc:T 'Test connection'}" Command="{Binding TestCommand}" IsEnabled="{Binding !Testing}" />
            <Button Content="{loc:T 'Cancel'}" Classes="flat" Command="{Binding CancelFormCommand}" />
            <TextBlock Classes="muted" Text="{loc:T 'Connecting…'}" IsVisible="{Binding Testing}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- On this computer -->
      <TextBlock Classes="label" Text="{loc:T 'On this computer'}" Margin="0,4,0,-6" />
      <ItemsControl x:Name="LocalServerList" ItemsSource="{Binding LocalServers}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LocalServerRowViewModel">
            <Border Classes="ws-row">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <ctl:Icon Data="{StaticResource IconServer}" Size="16" Margin="0,0.5,12,0" VerticalAlignment="Top" TextElement.Foreground="{DynamicResource GuiTextSecondary}" />
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="ws-title" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="tertiary" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Border Classes="status" Classes.done="{Binding IsRunning}" IsVisible="{Binding IsAdded}" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse />
                        <TextBlock Text="{loc:T 'Added'}" />
                      </StackPanel>
                    </Border>
                    <Button Classes="icon" IsVisible="{Binding IsAdded}" Command="{Binding AskRemoveCommand}" VerticalAlignment="Center"
                            IsEnabled="{Binding $parent[ItemsControl].((vm:CustomProvidersViewModel)DataContext).CanChange}"
                            ToolTip.Tip="{Binding Name, StringFormat={loc:T 'Remove {0}…'}}" AutomationProperties.Name="{Binding Name, StringFormat={loc:T 'Remove {0}'}}">
                      <ctl:Icon Data="{StaticResource IconTrash}" Size="16" />
                    </Button>
                    <Button Content="{loc:T 'Add'}" IsVisible="{Binding IsNotAdded}" Command="{Binding BeginAddCommand}" VerticalAlignment="Center"
                            IsEnabled="{Binding $parent[ItemsControl].((vm:CustomProvidersViewModel)DataContext).CanChange}"
                            AutomationProperties.Name="{Binding Name, StringFormat={loc:T 'Add {0}'}}" />
                  </StackPanel>
                </Grid>
                <Border Classes="conn-inset" IsVisible="{Binding IsAddOpen}" Margin="28,0,0,0">
                  <StackPanel Spacing="8">
                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource GuiFontS}"
                               Text="{Binding Name, StringFormat={loc:T 'omp will use {0} at this address and ask it for its models each time it starts.'}}" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBox Classes="sm" Text="{Binding Url}" AutomationProperties.Name="{Binding Name, StringFormat={loc:T 'Address of {0}'}}" />
                      <Button Grid.Column="1" Content="{loc:T 'Check'}" Margin="8,0,0,0" Command="{Binding CheckCommand}" IsEnabled="{Binding !Checking}"
                              AutomationProperties.Name="{Binding Name, StringFormat={loc:T 'Check {0}'}}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="accent" Content="{loc:T 'Add to omp'}" Command="{Binding ConfirmAddCommand}"
                              IsEnabled="{Binding $parent[ItemsControl].((vm:CustomProvidersViewModel)DataContext).CanChange}" />
                      <Button Classes="flat" Content="{loc:T 'Cancel'}" Command="{Binding CancelAddCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Classes="ws-note warning" IsVisible="{Binding IsConfirmingRemove}" Margin="28,0,0,0">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding RemoveQuestion}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Button Classes="danger" Content="{loc:T 'Remove'}" Command="{Binding ConfirmRemoveCommand}" AutomationProperties.Name="{Binding Name, StringFormat={loc:T 'Confirm removing {0}'}}" />
                      <Button Content="{loc:T 'Cancel'}" Classes="flat" Command="{Binding CancelRemoveCommand}" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Classes="ws-note error" IsVisible="{Binding HasProblem}" Margin="28,0,0,0">
                  <SelectableTextBlock Text="{Binding Problem}" TextWrapping="Wrap" FontSize="{DynamicResource GuiFontS}" />
                </Border>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Providers of the user's own -->
      <TextBlock Classes="label" Text="{loc:T 'Your providers'}" Margin="0,4,0,-6" IsVisible="{Binding HasCustomProviders}" />
      <ItemsControl x:Name="CustomProviderList" ItemsSource="{Binding CustomProviders}" IsVisible="{Binding HasCustomProviders}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CustomProviderRowViewModel">
            <Border Classes="ws-row">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <ctl:Icon Data="{StaticResource IconGlobe}" Size="16" Margin="0,0.5,12,0" VerticalAlignment="Top" TextElement.Foreground="{DynamicResource GuiTextSecondary}" />
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="ws-title" Text="{Binding Id}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="tertiary" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button Classes="icon" IsVisible="{Binding IsEditable}" Command="{Binding EditCommand}"
                            IsEnabled="{Binding $parent[ItemsControl].((vm:CustomProvidersViewModel)DataContext).CanChange}"
                            ToolTip.Tip="{Binding Id, StringFormat={loc:T 'Edit {0}'}}" AutomationProperties.Name="{Binding Id, StringFormat={loc:T 'Edit {0}'}}">
                      <ctl:Icon Data="{StaticResource IconPencil}" Size="16" />
                    </Button>
                    <Button Classes="icon" Command="{Binding AskRemoveCommand}"
                            IsEnabled="{Binding $parent[ItemsControl].((vm:CustomProvidersViewModel)DataContext).CanChange}"
                            ToolTip.Tip="{Binding Id, StringFormat={loc:T 'Remove {0}…'}}" AutomationProperties.Name="{Binding Id, StringFormat={loc:T 'Remove {0}'}}">
                      <ctl:Icon Data="{StaticResource IconTrash}" Size="16" />
                    </Button>
                  </StackPanel>
                </Grid>
                <TextBlock Classes="tertiary" Text="{Binding ReadOnlyNote}" TextWrapping="Wrap" IsVisible="{Binding !IsEditable}" Margin="28,0,0,0" />
                <Border Classes="ws-note warning" IsVisible="{Binding IsConfirmingRemove}" Margin="28,0,0,0">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding RemoveQuestion}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Button Classes="danger" Content="{loc:T 'Remove'}" Command="{Binding ConfirmRemoveCommand}" AutomationProperties.Name="{Binding Id, StringFormat={loc:T 'Confirm removing {0}'}}" />
                      <Button Content="{loc:T 'Cancel'}" Classes="flat" Command="{Binding CancelRemoveCommand}" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Classes="ws-note error" IsVisible="{Binding HasProblem}" Margin="28,0,0,0">
                  <SelectableTextBlock Text="{Binding Problem}" TextWrapping="Wrap" FontSize="{DynamicResource GuiFontS}" />
                </Border>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Classes="ws-sep" IsVisible="{Binding FileLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock x:Name="CustomProvidersFile" Classes="tertiary" Text="{Binding FileLabel}" TextWrapping="Wrap"
                 IsVisible="{Binding FileLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </Border>
</UserControl>
