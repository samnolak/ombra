<!-- The Plugins page's MCP tab, under the list: what servers offer besides tools, and the project-file option
     (ViewModels/ConnectorsViewModel.cs). -->
<UserControl xmlns:loc="using:Ombra.App.Localization"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ombra.App.ViewModels"
             xmlns:ctl="using:Ombra.App.Controls"
             xmlns:settings="using:Ombra.App.Views.Settings"
             x:Class="Ombra.App.Views.Settings.McpMoreSection"
             x:DataType="vm:ConnectorsViewModel">
  <StackPanel Spacing="16">
    <!-- ── Resources and prompts ── -->
    <Border Classes="section-card">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4" Margin="0,0,16,0">
            <TextBlock Classes="section" Text="{loc:T 'Resources and prompts'}" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="{loc:T 'What the servers offer besides tools: data omp can read, and prompts you can run as commands. omp asks each server in turn.'}" />
          </StackPanel>
          <Button x:Name="ShowMcpItemsButton" Grid.Column="1" Content="{loc:T 'Show'}" Command="{Binding LoadItemsCommand}" IsEnabled="{Binding !IsLoadingItems}" VerticalAlignment="Top" />
        </Grid>
        <TextBlock Classes="muted" Text="{loc:T 'Asking the servers…'}" IsVisible="{Binding IsLoadingItems}" />
        <TextBlock x:Name="McpItemsMessage" Classes="muted" Text="{Binding ItemsMessage}" TextWrapping="Wrap" IsVisible="{Binding HasItemsMessage}" />
        <StackPanel Spacing="8" IsVisible="{Binding HasPrompts}">
          <TextBlock Classes="caps" Text="{loc:T 'Prompts'}" />
          <ItemsControl ItemsSource="{Binding Prompts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:McpItemViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                  <StackPanel Spacing="2" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Classes="conn-detail" Text="{Binding Command}" Foreground="{DynamicResource GuiTextPrimary}" />
                    <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="flat" Content="{loc:T 'Use'}" Command="{Binding UseCommand}" IsVisible="{Binding CanUse}" VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding Command, StringFormat={loc:T 'Use {0}'}}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel Spacing="8" IsVisible="{Binding HasResources}">
          <TextBlock Classes="caps" Text="{loc:T 'Resources'}" />
          <ItemsControl ItemsSource="{Binding Resources}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:McpItemViewModel">
                <TextBlock Classes="conn-detail" Text="{Binding Label}" ToolTip.Tip="{Binding Label}" Margin="0,3" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ── Option ── -->
    <Border Classes="section-card">
      <StackPanel Spacing="14">
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasOptions}">
          <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Classes="ws-title" Text="{loc:T 'Servers from project files'}" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="{loc:T 'Load the MCP servers a project brings (.omp/mcp.json, .mcp.json). Turn off for projects you don’t trust.'}" />
          </StackPanel>
          <ToggleButton x:Name="ProjectServersSwitch" Grid.Column="1" Classes="switch" IsChecked="{Binding ProjectServers}" VerticalAlignment="Center"
                        AutomationProperties.Name="{loc:T 'Servers from project files'}" />
        </Grid>
        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasOptionsError}">
          <ctl:Icon Classes="error-mark" Data="{StaticResource IconAlert}" Size="16" VerticalAlignment="Top" Margin="0,0,8,0" />
          <SelectableTextBlock Grid.Column="1" x:Name="OptionsError" Classes="error" Text="{Binding OptionsError}" TextWrapping="Wrap" FontSize="{DynamicResource GuiFontS}" />
        </Grid>
        <settings:ConnectorsSettingsFeedback DataContext="{Binding OptionsFeedback}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
