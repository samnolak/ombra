<!-- Styles for the app shell (icon rail, sidebar, header, right panel and its new-tab page, the summary popover, the
     settings page's navigation) and the Computer use, Git and worktrees and SSH settings, on the design system's tokens
     (Tokens.axaml), as in Styles.axaml. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Ombra.App.Controls"
        xmlns:panes="using:Ombra.App.Views.Panes">

  <!-- ─────────────── Sidebar ─────────────── -->
  <Style Selector="TextBlock.sidebar-brand">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="Button.sidebar-action">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadiusControl}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.sidebar-action.current">
    <Setter Property="Background" Value="{DynamicResource GuiFill2}" />
  </Style>
  <Style Selector="Button.sidebar-action.current /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GuiFill2}" />
  </Style>
  <!-- The shortcut beside "New session" / "Settings": only while the row is hovered or focused, so the list stays calm -->
  <Style Selector="TextBlock.sidebar-shortcut">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Button.sidebar-action:pointerover TextBlock.sidebar-shortcut, Button.sidebar-action:focus-visible TextBlock.sidebar-shortcut">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- An update to install, or how the last one went: the sidebar's one tinted row -->
  <Style Selector="Button.sidebar-action.update">
    <Setter Property="Background" Value="{DynamicResource GuiStatusInfoSoft}" />
  </Style>
  <Style Selector="Button.sidebar-action.update ctl|Icon">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiStatusInfo}" />
  </Style>
  <Style Selector="ListBox.sessions">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.sessions ListBoxItem">
    <Setter Property="Padding" Value="8,1" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="ListBox.sessions ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.sessions ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TextBlock.sidebar-empty">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
  </Style>
  <!-- A project row (Codex's): its folder and its name (TextBlock.group-label.project-label, Styles.Session), 30 high;
       "remove from the sidebar" and "new session here" show on hover or focus -->
  <Style Selector="Grid.group-header">
    <Setter Property="Height" Value="30" />
  </Style>
  <Style Selector="TextBlock.group-label">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontCaption}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
  </Style>
  <Style Selector="ctl|Icon.group-icon">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextSecondary}" />
  </Style>
  <Style Selector="Grid.group-header Button.group-action">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Grid.group-header:pointerover Button.group-action, Grid.group-header:focus-within Button.group-action">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- A session: 30 high, radius 8; the title takes the row; its age (or status dot) at the right gives way to pin and ⋯
       on hover / focus -->
  <Style Selector="Button.session">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadiusControl}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <!-- The hover fill follows the row, not its button: pin and ⋯ sit over the button as its siblings, so moving onto them
       took the button's :pointerover (and the fill) away and back. Fill 1's hover step (8 % ink / 9 % ivory, as Claude's
       rows): fill 1 itself (5 / 6 %) was too faint to see which row the pointer is on. -->
  <Style Selector="Panel.session-row:pointerover Button.session /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GuiFill1Hover}" />
  </Style>
  <!-- The open session: the neutral fill -->
  <Style Selector="Button.session.current">
    <Setter Property="Background" Value="{DynamicResource GuiFill2}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.session.current /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GuiFill2}" />
  </Style>
  <Style Selector="TextBlock.session-age">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
  </Style>
  <!-- Not ":focus-within": a clicked pin or menu keeps focus, which left that row's actions showing next to the hovered
       row's. Shown on hover, to the keyboard (:focus-visible), and while the row's menu is open. -->
  <Style Selector="Panel.session-row Button.session-action">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="Panel.session-row:pointerover Button.session-action, Button.session-action:focus-visible, Button.session-action:flyout-open">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
  </Style>
  <Style Selector="Panel.session-meta">
    <Setter Property="MinWidth" Value="20" />
  </Style>
  <Style Selector="Panel.session-row">
    <Setter Property="ctl:SessionRowActions.Track" Value="True" />
  </Style>
  <!-- The meta keeps the actions' width while they show, so the title trims before them instead of running under; it
       hides whenever they show (hover, keyboard focus, open menu: the class follows the last two) -->
  <Style Selector="Panel.session-row:pointerover Panel.session-meta, Panel.session-row.actions-shown Panel.session-meta">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="MinWidth" Value="48" />
  </Style>
  <Style Selector="Button.session-action ctl|Icon">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextSecondary}" />
  </Style>
  <Style Selector="Button.session-action:pointerover ctl|Icon, Button.session-action.on ctl|Icon">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <Style Selector="Button.session-action.on">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- What omp is doing in a session: working (pulsing), needs your input (the attention yellow), stopped by an error;
       a finished run not seen yet is a check (session-done) -->
  <Style Selector="Ellipse.session-dot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{DynamicResource GuiStatusRunning}" />
  </Style>
  <!-- Pulses while omp works (ctl:Pulse, not a style animation: that would redraw the window every vsync) -->
  <Style Selector="Ellipse.session-dot.running">
    <Setter Property="ctl:Pulse.Low" Value="0.3" />
  </Style>
  <!-- Waiting on the user (an approval or a question): the brand yellow, gently pulsing; the only yellow mark in the
       list, so yellow always means the chat needs you -->
  <Style Selector="Ellipse.session-dot.waiting">
    <Setter Property="Fill" Value="{DynamicResource GuiStatusAttention}" />
    <Setter Property="Stroke" Value="{DynamicResource GuiStatusAttentionRing}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="ctl:Pulse.Low" Value="0.55" />
  </Style>
  <Style Selector="Ellipse.session-dot.error">
    <Setter Property="Fill" Value="{DynamicResource GuiStatusError}" />
  </Style>
  <!-- Finished, the reply not seen yet: a check in the success green -->
  <Style Selector="ctl|Icon.session-done">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiStatusSuccess}" />
    <Setter Property="StrokeThickness" Value="2.5" />
  </Style>
  <!-- Unsent input in a chat not shown: a small pencil before the title, in the secondary text colour -->
  <Style Selector="ctl|Icon.session-draft">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- The sidebar's right edge: drag to resize (a hairline in the focus colour, centred on the edge, while hovered or dragged) -->
  <Style Selector="Border.sidebar-grip-line">
    <Setter Property="Width" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.sidebar-grip:pointerover Border.sidebar-grip-line, Border.sidebar-grip:focus-visible Border.sidebar-grip-line, Border.sidebar-grip.dragging Border.sidebar-grip-line">
    <Setter Property="Background" Value="{DynamicResource GuiFocus}" />
  </Style>
  <Style Selector="Border.sidebar.drawer Border.sidebar-grip">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <!-- The sidebar's top row: in the band, level with the header -->
  <Style Selector="Grid.sidebar-header">
    <Setter Property="Margin" Value="8,0,8,0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- The settings page's header row in a narrow window (back, the page's name) -->
  <Style Selector="Border.header.settings-narrow-header">
    <Setter Property="Padding" Value="8,0,16,0" />
  </Style>

  <!-- ─────────────── Icon rail: 52 px of the chrome (the band's colour, one L-shaped surface with it); 36 px icon buttons
       under the band, the page shown on a filled rounded square ─────────────── -->
  <Style Selector="Border.rail">
    <Setter Property="Width" Value="52" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="{DynamicResource GuiRailPadding}" />
  </Style>
  <Style Selector="Button.rail-item">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadius10}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
    <Setter Property="ToolTip.Placement" Value="Right" />
  </Style>
  <Style Selector="Button.rail-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GuiFill1Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <Style Selector="Button.rail-item.on /template/ ContentPresenter#PART_ContentPresenter, Button.rail-item.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GuiFill2}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <!-- The hairline before the embedded products (ChatGPT's apps divider): icon-wide, centred, a gap above and below -->
  <Style Selector="Border.rail-separator">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,6" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource GuiBorder}" />
  </Style>

  <!-- ─────────────── Header: the chat's title after the project's folder ─────────────── -->
  <Style Selector="TextBlock.header-title">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontM}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>

  <!-- ─────────────── Right panel: its tabs in the band, a tool's line, the tab shown on the sheet ─────────────── -->
  <!-- Docked, it is transparent: the band shows the chrome, the rest the sheet frame (its top-right corner rounded) -->
  <Style Selector="panes|RightPanel">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.panel-strip">
    <Setter Property="Height" Value="{DynamicResource GuiChromeBand}" />
    <Setter Property="Padding" Value="8,0,8,0" />
    <!-- hit-testable: on macOS its empty part moves the window (a title-bar area) -->
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- The Browser page's tabs (Controls/PreviewPanel, MainWindow's BrowserPage): the same row in the band -->
  <Style Selector="DockPanel.preview-tab-strip">
    <Setter Property="Height" Value="{DynamicResource GuiChromeBand}" />
    <Setter Property="Margin" Value="8,0,8,0" />
    <!-- hit-testable: on macOS its empty part moves the window (a title-bar area) -->
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.panel-toolline">
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="16,0,8,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource GuiBorderSoft}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <!-- A tab in the band (the ChatGPT app's): a rounded 32 px tab, the shown one lifted on GuiChromeTabActive with a
       hairline; icon, title, × -->
  <Style Selector="Border.panel-tab">
    <Setter Property="Height" Value="32" />
    <Setter Property="MaxWidth" Value="240" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadius10}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.panel-tab:pointerover">
    <Setter Property="Background" Value="{DynamicResource GuiFill1}" />
  </Style>
  <Style Selector="Border.panel-tab.active">
    <Setter Property="Background" Value="{DynamicResource GuiChromeTabActive}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GuiBorderSoft}" />
  </Style>
  <Style Selector="Border.panel-tab Button.panel-tab-button">
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="10,0,4,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadius10}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
  </Style>
  <Style Selector="Border.panel-tab Button.panel-tab-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.panel-tab.active Button.panel-tab-button">
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <Style Selector="TextBlock.panel-tab-title">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontS}" />
  </Style>
  <!-- × only on the shown tab and the one under the pointer (the strip stays calm) -->
  <Style Selector="Border.panel-tab Button.panel-tab-close">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Border.panel-tab.active Button.panel-tab-close, Border.panel-tab:pointerover Button.panel-tab-close, Button.panel-tab-close:focus-visible">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- Over a narrow conversation (MainWindow.FitPanels): a drawer from the right edge, above the cards and the composer,
       opaque (its tabs on the chrome, the tab on the window's surface), edged by a hairline (the Events panel, a Border,
       also casts the popup shadow) -->
  <Style Selector="Border.events.overlay">
    <Setter Property="BoxShadow" Value="{DynamicResource GuiShadowPopup}" />
  </Style>
  <Style Selector="panes|RightPanel.overlay">
    <Setter Property="Background" Value="{DynamicResource GuiWindow}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GuiBorder}" />
    <Setter Property="BorderThickness" Value="1,0,0,1" />
  </Style>
  <Style Selector="panes|RightPanel.overlay Border.panel-strip">
    <Setter Property="Background" Value="{DynamicResource GuiChrome}" />
  </Style>

  <!-- ─────────────── The new-tab page: Tools (tiles with their shortcut), Recent (the chat's changed files) ─────────────── -->
  <Style Selector="TextBlock.newtab-heading">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontUi}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <!-- A tool: a 44 px tile (GuiCard, radius 12, no outline, as Codex's), icon, name, its shortcut on a key chip -->
  <Style Selector="Button.tool-card">
    <Setter Property="Margin" Value="4" />
    <Setter Property="Padding" Value="14,0,8,0" />
    <Setter Property="Height" Value="44" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadius12}" />
    <Setter Property="Background" Value="{DynamicResource GuiCard}" />
    <Setter Property="FontSize" Value="{DynamicResource GuiFontUi}" />
  </Style>
  <Style Selector="Button.tool-card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GuiFill1Hover}" />
  </Style>
  <Style Selector="Button.tool-card ctl|Icon">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.key-chip">
    <Setter Property="Background" Value="{DynamicResource GuiFill1}" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadiusFull}" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.tool-shortcut">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- A recent file: its icon on a rounded tile, name and folder, +N −M; rows radius 12 with a hairline under each -->
  <Style Selector="Button.recent-row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadius12}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GuiBorderSoft}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="FontSize" Value="{DynamicResource GuiFontS}" />
  </Style>
  <Style Selector="Button.recent-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GuiFill1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GuiBorderSoft}" />
  </Style>
  <Style Selector="Border.recent-tile">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadius8}" />
    <Setter Property="Background" Value="{DynamicResource GuiFill2}" />
    <Setter Property="Margin" Value="0,0,12,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ctl|Icon.recent-icon">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextSecondary}" />
  </Style>

  <!-- ─────────────── The summary popover: the project atop, then its rows ─────────────── -->
  <Style Selector="TextBlock.summary-project">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontS}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
    <Setter Property="Margin" Value="8,4,8,6" />
  </Style>
  <Style Selector="TextBlock.summary-empty">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontS}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextTertiary}" />
    <Setter Property="Margin" Value="8,2,8,6" />
  </Style>

  <!-- ─────────────── Settings page: its navigation in the sidebar's place, a sheet like the sidebar's (Styles.axaml) ─────────────── -->
  <Style Selector="Border.settings-sidebar">
    <Setter Property="Width" Value="240" />
  </Style>
  <Style Selector="TextBlock.settings-title">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.settings-group">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontCaption}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
    <Setter Property="Margin" Value="10,16,0,4" />
  </Style>
  <Style Selector="Button.settings-nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadiusControl}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="Button.settings-nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GuiFill1}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <Style Selector="Button.settings-nav.current /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GuiFill2}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <Style Selector="Button.settings-nav.current">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <!-- In the narrow strip: tabs as wide as their names -->
  <Style Selector="Button.settings-nav.tab">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="0" />
  </Style>

  <!-- A 1 px separator between rows of a settings card -->
  <Style Selector="Border.ws-sep">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource GuiBorderSoft}" />
  </Style>

  <!-- A row's name (as the General page: medium weight, UI size) -->
  <Style Selector="TextBlock.ws-title">
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <!-- A value in a label / value line (same size as its muted label, so both share a baseline) -->
  <Style Selector="TextBlock.ws-value, SelectableTextBlock.ws-value">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontS}" />
  </Style>

  <!-- Feedback and notes inside a page: a pale fill in the status colour and a mark in the status colour; the text stays
       primary (status colours on their pale fill are below 4.5:1) -->
  <Style Selector="Border.ws-note">
    <Setter Property="Background" Value="{DynamicResource GuiFill1}" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadius8}" />
    <Setter Property="Padding" Value="12,9" />
  </Style>
  <Style Selector="Border.ws-note.ok">
    <Setter Property="Background" Value="{DynamicResource GuiStatusSuccessSoft}" />
  </Style>
  <Style Selector="Border.ws-note.warning">
    <Setter Property="Background" Value="{DynamicResource GuiStatusWarningSoft}" />
  </Style>
  <Style Selector="Border.ws-note.error">
    <Setter Property="Background" Value="{DynamicResource GuiStatusErrorSoft}" />
  </Style>
  <Style Selector="Border.ws-note TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontS}" />
  </Style>
  <Style Selector="ctl|Icon.ok-mark">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiStatusSuccess}" />
  </Style>
  <Style Selector="ctl|Icon.unknown-mark">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextTertiary}" />
  </Style>

  <!-- A form opened inside a card (new worktree, add a host): a pale outline, so its filled fields read as on the card -->
  <Style Selector="Border.ws-form">
    <Setter Property="BorderBrush" Value="{DynamicResource GuiBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadius12}" />
    <Setter Property="Padding" Value="16,14" />
  </Style>

  <!-- A list row (worktree, SSH host): 10 px above and below, separated by the pale line -->
  <Style Selector="Border.ws-row">
    <Setter Property="Padding" Value="0,10" />
    <Setter Property="BorderBrush" Value="{DynamicResource GuiBorderSoft}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <!-- The header's branch chip: quiet like the project name beside it, a hover fill like the title button -->
  <Style Selector="Button.branch-chip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="6,0,8,0" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="{DynamicResource GuiFontS}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.branch-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GuiFill1}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <Style Selector="Button.branch-chip ctl|Icon.project-chevron">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextTertiary}" />
  </Style>
  <!-- "· worktree" after the branch: the same quiet colour, even while the chip is hovered -->
  <Style Selector="Button.branch-chip TextBlock.worktree-mark">
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
  </Style>

  <!-- ─────────────── The settings page: its list and its page under the band (the band row stays the chrome's) ─────────────── -->
  <Style Selector="Border#SettingsPage:not(.narrow) ScrollViewer#SettingsScroll">
    <Setter Property="Margin" Value="{DynamicResource GuiSheetMargin}" />
  </Style>

  <!-- ─────────────── macOS: the band is the window's title bar (MainWindow.Chrome.cs) ───────────────
       The traffic lights sit over the window's top left, centred in the band (16–70 × 14–30: MainWindow.PlaceTrafficLights,
       held there through AppKit's own title-bar layouts by Platform/Mac/MacTrafficLights), over the rail (52 px, its
       buttons already under the band) and the start of the band: what is in the band there starts after them — the
       sidebar's top row (or, while the sidebar is hidden, the header or the Browser page's tabs; or the narrow settings
       page's header row) 40 px in. The title-bar areas are hit-testable (transparent) so that their empty part moves the
       window; the settings page's scroller is too, so that its empty part does not. In full screen the lights are hidden
       and none of this applies. -->
  <Style Selector=":is(Window).traffic-lights Grid.sidebar-header">
    <Setter Property="Margin" Value="40,0,8,0" />
  </Style>
  <Style Selector=":is(Window).traffic-lights Border.header.sidebar-hidden">
    <Setter Property="Padding" Value="40,0,10,0" />
  </Style>
  <Style Selector=":is(Window).traffic-lights Border.header.settings-narrow-header">
    <Setter Property="Padding" Value="40,0,16,0" />
  </Style>
  <Style Selector=":is(Window).traffic-lights Border.browser-page.sidebar-hidden DockPanel.preview-tab-strip">
    <Setter Property="Margin" Value="40,0,8,0" />
  </Style>
  <Style Selector=":is(Window).traffic-lights ScrollViewer#SettingsScroll">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- The image viewer over the whole window: its name and buttons below the lights (the dimmed backdrop still covers all) -->
  <Style Selector=":is(Window).traffic-lights ctl|ImageViewer > Panel > DockPanel">
    <Setter Property="Margin" Value="0,28,0,0" />
  </Style>
</Styles>
