<!-- P5 "Share" (MainViewModel.Share, ViewModels/Team/TeamShareViewModel): what is shared, to whom — everyone in the team
     or the members picked (found by name) — and an optional short comment. Over everything; Esc or Cancel closes it. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Ombra.App.Localization"
             xmlns:vm="using:Ombra.App.ViewModels"
             xmlns:ctl="using:Ombra.App.Controls"
             x:Class="Ombra.App.Views.Team.ShareDialog"
             x:DataType="vm:MainViewModel">
  <Panel DataContext="{Binding Share}" x:DataType="vm:TeamShareViewModel">
    <Border Classes="scrim" PointerPressed="OnScrimPressed" />
    <Border x:Name="ShareDialogCard" Classes="section-card" Width="460" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{DynamicResource GuiSurface1}" BoxShadow="{DynamicResource GuiShadowPopup}" Padding="20"
            AutomationProperties.Name="{loc:T 'Share with team'}">
      <Border.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CancelShareCommand}" />
      </Border.KeyBindings>
      <StackPanel Spacing="12">
        <TextBlock Classes="section" Text="{Binding DialogTitle}" TextWrapping="Wrap" />
        <TextBlock x:Name="ShareDialogDetail" Classes="muted mono" Text="{Binding DialogDetail}" FontSize="{DynamicResource GuiFontCaption}" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding DialogDetailTip}" />

        <TextBlock Classes="label" Text="{loc:T 'Send to'}" />
        <StackPanel Spacing="6" DataContext="{Binding Recipients}" x:DataType="vm:ShareRecipientsViewModel">
          <RadioButton x:Name="ShareToEveryone" GroupName="ShareTo" Content="{loc:T 'Everyone in the team'}" IsChecked="{Binding Everyone}" />
          <RadioButton x:Name="ShareToMembers" GroupName="ShareTo" Content="{loc:T 'Specific members'}" IsChecked="{Binding IsSpecific}" IsEnabled="{Binding HasMembers}" />
          <StackPanel Spacing="6" Margin="24,0,0,0" IsVisible="{Binding IsSpecific}">
            <TextBox x:Name="ShareMemberFilter" Classes="sm" Text="{Binding Filter}" Watermark="{loc:T 'Find a member by name'}"
                     AutomationProperties.Name="{loc:T 'Find a member by name'}" />
            <ScrollViewer MaxHeight="180">
              <ItemsControl x:Name="ShareMemberList" ItemsSource="{Binding Members}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ShareRecipientRow">
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,2" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
          <TextBlock Classes="tertiary" IsVisible="{Binding !HasMembers}" Text="{loc:T 'There is no one else in the team yet.'}" />
        </StackPanel>

        <TextBox x:Name="ShareComment" Text="{Binding Comment}" MaxLength="280" Watermark="{loc:T 'Comment (optional)'}" AutomationProperties.Name="{loc:T 'Comment'}" />
        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasError}">
          <ctl:Icon Classes="error-mark" Data="{StaticResource IconAlertCircle}" Size="16" Margin="0,0,8,0" VerticalAlignment="Top" />
          <TextBlock x:Name="ShareError" Grid.Column="1" Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button x:Name="ShareCancel" Classes="flat md" Content="{loc:T 'Cancel'}" Command="{Binding CancelShareCommand}" />
          <Button x:Name="ShareSend" Classes="accent md" Content="{loc:T 'Share'}" Command="{Binding SendCommand}" IsEnabled="{Binding Recipients.CanSend}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Panel>
</UserControl>
