<!-- Line icons for the Files pane and the project menu, same rules as Icons.axaml (24-unit grid, stroked; Filled for solid shapes). -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Browse files: two sheets -->
  <StreamGeometry x:Key="IconFiles">M15 2 L11 2 A2 2 0 0 0 9 4 L9 15 A2 2 0 0 0 11 17 L19 17 A2 2 0 0 0 21 15 L21 8 M16.706 2.706 A2.4 2.4 0 0 0 15 2 L15 7 A1 1 0 0 0 16 8 L21 8 A2.4 2.4 0 0 0 20.294 6.294 Z M5 7 A2 2 0 0 0 3 9 L3 20 A2 2 0 0 0 5 22 L13 22 A2 2 0 0 0 14.732 21</StreamGeometry>
  <!-- Add to message: an @ (omp reads @path in a message) -->
  <StreamGeometry x:Key="IconAt">M8 12 A4 4 0 1 0 16 12 A4 4 0 1 0 8 12 Z M16 8 L16 13 A3 3 0 0 0 22 13 L22 12 A10 10 0 1 0 18 20</StreamGeometry>
  <!-- The viewer takes the whole pane, and back -->
  <StreamGeometry x:Key="IconExpand">M15 3 L21 3 L21 9 M21 3 L14 10 M3 21 L10 14 M9 21 L3 21 L3 15</StreamGeometry>
  <StreamGeometry x:Key="IconCollapse">M14 10 L21 3 M20 10 L14 10 L14 4 M3 21 L10 14 M4 14 L10 14 L10 20</StreamGeometry>
</ResourceDictionary>
