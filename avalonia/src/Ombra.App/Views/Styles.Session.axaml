<!-- Styles for the conversation (transcript rows, Markdown, diffs, dialog cards, the new-session greeting), the session
     menu, usage and model options, on the design system's tokens (Tokens.axaml), as in Styles.axaml. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Ombra.App.Controls"
        xmlns:vm="using:Ombra.App.ViewModels">

  <Style Selector="ListBox.transcript">
    <Setter Property="ctl:TurnCardGesture.IsEnabled" Value="True" />
  </Style>
  <!-- ─────────────── Session menu (the title's flyout) ─────────────── -->
  <Style Selector="StackPanel.session-menu > Button.menu-item">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <!-- The command omp runs, on the right of the item (Claude Code shows shortcuts there) -->
  <Style Selector="TextBlock.menu-hint">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="12,0,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
  </Style>
  <Style Selector="Button.menu-item:disabled TextBlock.menu-hint">
    <Setter Property="Foreground" Value="{DynamicResource GuiTextTertiary}" />
  </Style>
  <!-- The destructive item: the negative colour (large enough in the menu's 14 px, with its icon) -->
  <Style Selector="Button.menu-item.danger">
    <Setter Property="Foreground" Value="{DynamicResource GuiTextError}" />
  </Style>
  <Style Selector="Border.menu-separator">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource GuiBorderSoft}" />
    <Setter Property="Margin" Value="6,4" />
  </Style>

  <!-- A pinned session in the sidebar (where the running dot goes) -->
  <Style Selector="ctl|Icon.session-pin">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextSecondary}" />
  </Style>

  <!-- ─────────────── Sidebar (ChatGPT Codex look; base rules in Styles.Workspace.axaml, these load after) ─────────────── -->
  <!-- Rows 13 px; the selected chat a rounded 8 px fill (GuiFill2) -->
  <Style Selector="Button.session">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.session /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.sidebar-action">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <!-- Section labels (and menu headings): tertiary, 13 px -->
  <Style Selector="TextBlock.group-label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextTertiary}" />
  </Style>
  <!-- A project row's name (Codex's project rows): the rows' size and primary text beside its folder; its chats are
       indented under the folder icon -->
  <Style Selector="TextBlock.group-label.project-label">
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <Style Selector="ListBox.sessions ItemsControl > ContentPresenter > Panel.session-row">
    <Setter Property="Margin" Value="16,0,0,0" />
  </Style>
  <!-- Three hover actions (pin, delete, ⋯): the meta keeps their width so the title trims before them -->
  <Style Selector="Panel.session-row:pointerover Panel.session-meta, Panel.session-row.actions-shown Panel.session-meta">
    <Setter Property="MinWidth" Value="76" />
  </Style>
  <!-- Selection mode (MainViewModel.SessionSelection.cs): a check box leads each row, a picked row has the open
       chat's fill, and the age stays (the hover actions are hidden: a click picks the row) -->
  <Style Selector="CheckBox.session-check">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.session.selected">
    <Setter Property="Background" Value="{DynamicResource GuiFill2}" />
  </Style>
  <Style Selector="Button.session.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GuiFill2}" />
  </Style>
  <Style Selector="Panel.session-row.selecting:pointerover Panel.session-meta">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="MinWidth" Value="20" />
  </Style>
  <!-- The bar over the list while rows are picked: their number, Select all, Delete, Cancel -->
  <Style Selector="Border.selection-bar">
    <Setter Property="Background" Value="{DynamicResource GuiFill1}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="TextBlock.selection-count">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <!-- The header's search icon while the search field is open -->
  <Style Selector="Button#SessionSearchButton.on ctl|Icon">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <!-- A chat's hover card (11-hover-chat): title, then project and date in tertiary -->
  <Style Selector="TextBlock.session-tip-title">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.session-tip-meta">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextTertiary}" />
  </Style>
  <Style Selector="StackPanel.session-tip ctl|Icon">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextTertiary}" />
  </Style>

  <!-- ─────────────── Session card ─────────────── -->
  <Style Selector="Border.session-card">
    <Setter Property="Padding" Value="16,12,12,14" />
  </Style>
  <Style Selector="Border.card-mark">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadiusFull}" />
    <Setter Property="Background" Value="{DynamicResource GuiFill1}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <Style Selector="Border.session-card.failed Border.card-mark">
    <Setter Property="Background" Value="{DynamicResource GuiStatusErrorSoft}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextError}" />
  </Style>
  <Style Selector="TextBlock.card-title">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontM}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="SelectableTextBlock.card-message">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
  </Style>
  <Style Selector="Grid.folder-row">
    <Setter Property="MinHeight" Value="40" />
  </Style>

  <!-- ─────────────── Context ring and its popover ─────────────── -->
  <Style Selector="ctl|UsageRing">
    <Setter Property="TrackBrush" Value="{DynamicResource GuiTextSecondary}" />
    <Setter Property="ArcBrush" Value="{DynamicResource GuiTextSecondary}" />
  </Style>
  <Style Selector="ctl|UsageRing.warn">
    <Setter Property="TrackBrush" Value="{DynamicResource GuiStatusWarning}" />
    <Setter Property="ArcBrush" Value="{DynamicResource GuiStatusWarning}" />
  </Style>
  <Style Selector="ctl|UsageRing.full">
    <Setter Property="TrackBrush" Value="{DynamicResource GuiStatusError}" />
    <Setter Property="ArcBrush" Value="{DynamicResource GuiStatusError}" />
  </Style>
  <Style Selector="Button.usage-ring">
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadiusFull}" />
    <Setter Property="Padding" Value="8,0,9,0" />
  </Style>
  <Style Selector="TextBlock.usage-percent">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.usage-headline">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontM}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Grid.usage-row">
    <Setter Property="Height" Value="26" />
  </Style>
  <Style Selector="TextBlock.usage-label">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.usage-value">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
    <Setter Property="MinWidth" Value="60" />
    <Setter Property="TextAlignment" Value="Right" />
  </Style>
  <!-- One hue for what is used (magnitude); the reserve and the free room in quieter tones -->
  <Style Selector="ProgressBar.usage-bar">
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="Background" Value="{DynamicResource GuiProgressTrack}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiStatusInfo}" />
  </Style>
  <Style Selector="ProgressBar.usage-bar.reserve">
    <Setter Property="Foreground" Value="{DynamicResource GuiFill3}" />
  </Style>
  <Style Selector="ProgressBar.usage-bar.free">
    <Setter Property="Foreground" Value="{DynamicResource GuiTextTertiary}" />
  </Style>
  <Style Selector="ProgressBar.usage-bar.high">
    <Setter Property="Foreground" Value="{DynamicResource GuiStatusWarning}" />
  </Style>
  <Style Selector="StackPanel > ProgressBar.usage-bar">
    <Setter Property="Margin" Value="0" />
  </Style>

  <!-- ─────────────── Model options (under the model list) ─────────────── -->
  <Style Selector="Grid.option-row">
    <Setter Property="Height" Value="34" />
    <Setter Property="Margin" Value="10,0,10,0" />
  </Style>
  <Style Selector="Grid.option-row > ctl|Icon">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextSecondary}" />
  </Style>
  <Style Selector="TextBlock.option-label">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.option-note">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
    <Setter Property="Margin" Value="36,0,10,4" />
  </Style>

  <!-- ─────────────── Transcript ─────────────── -->
  <!-- Transcript rows are not selectable list items: no hover/selection chrome; one reading column, centered. Not
       clipped (Fluent clips a ListBoxItem): a tool line reaches 8 px past the column on each side, and the item's clip cut
       its rounded hover fill into a square-cornered strip. A row under lines that fold it ("Worked for…", a step group)
       sits that many levels in, a guide down from each line (Controls/TreeIndent, RowViewModel.Depth). -->
  <Style Selector="ListBox.transcript ListBoxItem" x:DataType="vm:RowViewModel">
    <Setter Property="MaxWidth" Value="768" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="ctl:TreeIndent.Depth" Value="{Binding Depth}" />
    <Setter Property="Template">
      <ControlTemplate>
        <ctl:TreeIndent Depth="{TemplateBinding ctl:TreeIndent.Depth}" GuideBrush="{DynamicResource GuiBorderSoft}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Content="{TemplateBinding Content}"
                            Padding="{TemplateBinding Padding}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
        </ctl:TreeIndent>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.transcript ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.transcript ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- A row held at the top of the view (an open exploration group's line, Controls/TranscriptPanel) covers what scrolls
       under it -->
  <Style Selector="ListBox.transcript ListBoxItem.stuck /template/ ContentPresenter#PART_ContentPresenter, ListBox.transcript ListBoxItem.stuck:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.transcript ListBoxItem.stuck:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GuiWindow}" />
  </Style>
  <Style Selector="ListBox.transcript">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- Your message (Codex): a blue bubble on the right (#213F73 in dark, radius 18, 15×10 inside), its text 14 on 22 in
       GuiUserBubbleText; ~28 px between turns -->
  <Style Selector="StackPanel.user-row">
    <Setter Property="Margin" Value="0,26,0,2" />
  </Style>
  <Style Selector="Border.user-bubble">
    <Setter Property="Background" Value="{DynamicResource GuiUserBubble}" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadiusBubble}" />
    <Setter Property="Padding" Value="15,10" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiUserBubbleText}" />
  </Style>
  <Style Selector="Border.user-bubble SelectableTextBlock.body">
    <Setter Property="Foreground" Value="{DynamicResource GuiUserBubbleText}" />
  </Style>
  <Style Selector="Button.link.bubble-fold">
    <Setter Property="Foreground" Value="{DynamicResource GuiUserBubbleText}" />
    <Setter Property="Opacity" Value="0.72" />
  </Style>
  <!-- The day and time over a message that starts the conversation or follows a pause: centred, 12 px meta grey, no rules -->
  <Style Selector="TextBlock.date-separator">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextTertiary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,4,0,22" />
  </Style>
  <!-- A message's line of actions: its time, then small grey icons (copy, rewind). Under your message, right-aligned and
       only while the pointer is over the message (or focus is in it); under an answer, left-aligned and always shown. -->
  <Style Selector="StackPanel.message-actions">
    <Setter Property="Spacing" Value="0" />
    <Setter Property="Height" Value="28" />
  </Style>
  <Style Selector="StackPanel.message-actions.user-meta">
    <Setter Property="Margin" Value="0,-2,-6,0" />
  </Style>
  <Style Selector="StackPanel.message-actions.reply-actions">
    <Setter Property="Margin" Value="-6,0,0,0" />
  </Style>
  <Style Selector="TextBlock.message-time">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextTertiary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="6,0,6,0" />
  </Style>
  <Style Selector="Button.row-action">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextTertiary}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.row-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <Style Selector="ListBox.transcript ListBoxItem StackPanel.user-meta">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="ListBox.transcript ListBoxItem:pointerover StackPanel.user-meta, ListBox.transcript ListBoxItem:focus-within StackPanel.user-meta">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- "Thinking…" / "Thought for 4s": a step line (28 high, its icon at the column's edge, the label at the steps' text
       edge) with a chevron; the thoughts under a pale bar that runs down from the icon -->
  <Style Selector="ToggleButton.thinking-toggle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource GuiFontS}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource GuiStepText}" />
  </Style>
  <Style Selector="ctl|Icon.thinking-mark">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiStepText}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,4,0" />
  </Style>
  <Style Selector="ToggleButton.thinking-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.thinking-toggle:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <Style Selector="ToggleButton.thinking-toggle ctl|Icon.chevron">
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextTertiary}" />
  </Style>
  <Style Selector="ToggleButton.thinking-toggle:checked ctl|Icon.chevron">
    <Setter Property="RenderTransform" Value="rotate(90deg)" />
  </Style>
  <!-- The thinking line held at the top of the view (Controls/StickyHeader) covers the thoughts under it -->
  <Style Selector="Border.sticky-bar.stuck">
    <Setter Property="Background" Value="{DynamicResource GuiWindow}" />
  </Style>
  <!-- Pulses while omp thinks (ctl:Pulse, not a style animation: that would redraw the window every vsync) -->
  <Style Selector="TextBlock.thinking-label.live">
    <Setter Property="ctl:Pulse.Low" Value="0.45" />
  </Style>
  <Style Selector="Border.thinking-body">
    <Setter Property="BorderBrush" Value="{DynamicResource GuiBorder}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Padding" Value="15,0,0,0" />
    <Setter Property="Margin" Value="7,0,0,6" />
  </Style>
  <Style Selector="Border.thinking-body SelectableTextBlock">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontUi}" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
  </Style>
  <!-- The digit that answers (1 Allow, 2 Deny; 1–9 a choice) -->
  <Style Selector="TextBlock.key-hint">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontCaption}" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>
  <Style Selector="Border.key-badge">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadius4}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GuiBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="TextElement.FontSize" Value="{DynamicResource GuiFontCaption}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextSecondary}" />
  </Style>

  <!-- ─────────────── New session: the greeting, its project and starter prompts ─────────────── -->
  <Style Selector="TextBlock.greeting">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontXxl}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- The project in the greeting: the same words on the app's chip (fill 1, a full pill, a chevron), opens the project menu -->
  <Style Selector="Button.greeting-project">
    <Setter Property="Padding" Value="14,2,10,2" />
    <Setter Property="Margin" Value="8,0,2,0" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Background" Value="{DynamicResource GuiFill1}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadiusFull}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.greeting-project:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GuiFill1Hover}" />
  </Style>
  <Style Selector="Button.greeting-project:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GuiFill1Pressed}" />
  </Style>
  <!-- By class, not "Button.greeting-project TextBlock": the project menu opens from this button, so its popup's text
       would match a descendant selector and render at greeting size -->
  <Style Selector="TextBlock.greeting-project-name">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontXxl}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <Style Selector="ctl|Icon.greeting-project-chevron">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextTertiary}" />
  </Style>
  <!-- A starter prompt: an outlined chip; it fills the message box -->
  <Style Selector="Button.starter">
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource GuiBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadiusFull}" />
    <Setter Property="FontSize" Value="{DynamicResource GuiFontUi}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
  </Style>
  <Style Selector="Button.starter:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GuiFill1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GuiBorderHover}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <Style Selector="Button.starter ctl|Icon">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextTertiary}" />
  </Style>

  <!-- ─────────────── A turn's "Worked for…" line (Codex) ─────────────── -->
  <!-- 13 px meta grey, a small chevron after it (down once open), a full-width hairline under it; ~34 px under your
       message (its hover line of actions sits between) and ~18 px over the answer. While the turn runs it reads
       "Activity" and opens nothing (not dimmed). -->
  <Style Selector="StackPanel.turn-fold">
    <Setter Property="Margin" Value="0,8,0,16" />
  </Style>
  <Style Selector="ToggleButton.turn-fold-head">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="22" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="{DynamicResource GuiFontS}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextTertiary}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ToggleButton.turn-fold-head /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.turn-fold-head:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.turn-fold-head:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.turn-fold-head:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.turn-fold-head:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextTertiary}" />
  </Style>
  <Style Selector="ToggleButton.turn-fold-head:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
  </Style>
  <Style Selector="ToggleButton.turn-fold-head:disabled">
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="TextBlock.turn-fold-label">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.turn-fold-head ctl|Icon.chevron">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
  </Style>
  <Style Selector="ToggleButton.turn-fold-head:checked ctl|Icon.chevron">
    <Setter Property="RenderTransform" Value="rotate(90deg)" />
  </Style>
  <Style Selector="Border.turn-fold-rule">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,10,0,0" />
    <Setter Property="Background" Value="{DynamicResource GuiHairline}" />
  </Style>

  <!-- ─────────────── Steps (Codex's step rows: an icon, what it did, in grey) ─────────────── -->
  <!-- The call: one quiet 13 px line; hover fills it, the chevron shows when there is more to open. What opens under it
       (a command's Shell card, the result, the output) starts at the text's edge, 30 px into the line. -->
  <Style Selector="ToggleButton.tool-row">
    <Setter Property="Width" Value="NaN" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="{DynamicResource GuiFontS}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadiusControl}" />
  </Style>
  <Style Selector="ToggleButton.tool-row:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.tool-row:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tool-row:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GuiFill1}" />
  </Style>
  <Style Selector="ToggleButton.tool-row ctl|Icon.chevron">
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextTertiary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Opacity" Value="0" />
  </Style>
  <!-- Shown under the pointer, on keyboard focus, and while open (Codex: "⌄" after an opened step) -->
  <Style Selector="ToggleButton.tool-row:pointerover ctl|Icon.chevron, ToggleButton.tool-row:focus-visible ctl|Icon.chevron, ToggleButton.tool-row:checked ctl|Icon.chevron">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ToggleButton.tool-row:checked ctl|Icon.chevron">
    <Setter Property="RenderTransform" Value="rotate(90deg)" />
  </Style>
  <!-- Its icon in a 16 px cell: the kind of step (a terminal, a file, a search…) in the step grey; a blue arc turning
       while it runs, a red cross when it failed, a dashed circle when it was stopped -->
  <Style Selector="Panel.tool-status">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ctl|Icon.tool-mark">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiStepText}" />
  </Style>
  <!-- Only while something runs, so an idle window does not redraw -->
  <Style Selector="ctl|Icon.tool-mark.running">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiStatusInfo}" />
    <Setter Property="StrokeThickness" Value="2.5" />
    <!-- Turns (a spinner), stepped like Pulse's fade so it costs no frame every vsync -->
    <Setter Property="ctl:Pulse.Spin" Value="0:0:0.9" />
  </Style>
  <!-- Waiting for the user's approval: the waiting colour, as the activity line and the session dot have it -->
  <Style Selector="ctl|Icon.tool-mark.running.waiting">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiStatusWaiting}" />
  </Style>
  <Style Selector="ctl|Icon.tool-mark.failed">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiStatusError}" />
    <Setter Property="StrokeThickness" Value="2.5" />
  </Style>
  <Style Selector="TextBlock.tool-name">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontS}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource GuiStepText}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="8,0,0,0" />
  </Style>
  <Style Selector="TextBlock.tool-summary">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontS}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiStepText}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- A group's line: what its steps did, in words -->
  <Style Selector="TextBlock.group-summary">
    <Setter Property="Margin" Value="8,0,8,0" />
  </Style>
  <Style Selector="TextBlock.tool-took">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextTertiary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- Why it failed, on its line: "exit 127" on the soft error fill -->
  <Style Selector="Border.tool-chip">
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadius4}" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.tool-chip TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontCaption}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Border.tool-chip.failed">
    <Setter Property="Background" Value="{DynamicResource GuiStatusErrorSoft}" />
  </Style>
  <Style Selector="Border.tool-chip.failed TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource GuiTextError}" />
  </Style>
  <!-- A command's Shell card (Codex): the code surface, radius 12, a hairline (red when the command failed); "$" and the
       command in primary text, then its output in secondary, "Exit code N" at its foot on the right -->
  <Style Selector="Border.console">
    <Setter Property="Margin" Value="30,2,8,8" />
    <Setter Property="Background" Value="{DynamicResource GuiCodeBlockBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GuiCodeBlockBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadiusCard}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="ctl:InnerClip.IsEnabled" Value="True" />
  </Style>
  <Style Selector="StackPanel.console-body">
    <Setter Property="Margin" Value="12,8,12,10" />
  </Style>
  <Style Selector="TextBlock.console-exit">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextTertiary}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>
  <!-- An open output's bar (a Shell card's, an output's): what it is, what it ran on, and a chevron that folds it. On
       the card's own fill with no rule under it (Codex): it stays at the top of the view over the card's lines
       (Controls/StickyHeader). Held there it is a flat bar across the card, square, with a hairline and a short shadow
       over the lines scrolling under it: the card goes on above (a rounded top there read as a card of a few lines). -->
  <Style Selector="Border.card-head.stuck">
    <Setter Property="Background" Value="{DynamicResource GuiCodeBlockHeader}" />
    <Setter Property="BoxShadow" Value="{DynamicResource GuiShadowStuck}" />
  </Style>
  <Style Selector="Button.card-header">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="{DynamicResource GuiCodeBlockHeader}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="11,11,0,0" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.card-header:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.card-header:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GuiCodeBlockHeader}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.tool-output Button.card-header">
    <Setter Property="Padding" Value="12,0" />
  </Style>
  <Style Selector="Button.card-header ctl|Icon">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextTertiary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.card-header ctl|Icon.card-icon">
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>
  <Style Selector="Button.card-header:pointerover ctl|Icon.card-chevron">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <Style Selector="TextBlock.card-kind">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.card-summary">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextTertiary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="Margin" Value="8,0" />
  </Style>
  <Style Selector="Border.console.failed">
    <Setter Property="BorderBrush" Value="{DynamicResource GuiStatusError}" />
  </Style>
  <!-- A message between agents (omp's IRC): the Shell card's surface at the conversation's edge; two preview lines in
       secondary text while folded, the message as Markdown when open -->
  <Style Selector="Border.agent-message">
    <Setter Property="Margin" Value="0,8" />
    <Setter Property="Background" Value="{DynamicResource GuiCodeBlockBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GuiCodeBlockBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadiusCard}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="ctl:InnerClip.IsEnabled" Value="True" />
  </Style>
  <Style Selector="TextBlock.agent-message-preview">
    <Setter Property="Margin" Value="12,8,12,10" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxLines" Value="2" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="ctl|MarkdownView.agent-message-body">
    <Setter Property="Margin" Value="12,8,12,10" />
  </Style>
  <Style Selector="TextBlock.console-prompt">
    <Setter Property="Foreground" Value="{DynamicResource GuiTextTertiary}" />
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <Style Selector="SelectableTextBlock.console-command">
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="SelectableTextBlock.console-output">
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="SelectableTextBlock.console-output.open">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- What anything but a command gave, under the call at the verb's edge: its first output lines, or the error -->
  <Style Selector="StackPanel.tool-result">
    <Setter Property="Margin" Value="30,0,8,2" />
  </Style>
  <Style Selector="TextBlock.tool-result">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
  </Style>
  <Style Selector="TextBlock.tool-result.failed">
    <Setter Property="Foreground" Value="{DynamicResource GuiTextError}" />
  </Style>
  <!-- "… +12 lines": opens the whole output -->
  <Style Selector="Button.tool-more">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="20" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextTertiary}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.tool-more:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.tool-more:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <!-- The whole output, opened: a code card under its bar -->
  <Style Selector="Border.tool-output">
    <Setter Property="Margin" Value="30,2,8,6" />
    <Setter Property="Background" Value="{DynamicResource GuiCodeBlockBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GuiCodeBlockBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadiusCard}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="ctl:InnerClip.IsEnabled" Value="True" />
  </Style>
  <Style Selector="SelectableTextBlock.tool-output-text">
    <Setter Property="Margin" Value="12,8" />
  </Style>
  <Style Selector="Border.tool-output SelectableTextBlock">
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
  </Style>
  <!-- Codex's change card under a turn's answer: a header on GuiChangeHead (a 38 px icon tile, "Changed 3 files" and its
       +N −M, the "Review changes" outline button), then a 32 px row per file on GuiChangeRow (its folder in grey, its
       name, its +N −M) between hairlines; a GuiCardBorder hairline round it, radius 12 -->
  <Style Selector="Border.change-card">
    <Setter Property="Margin" Value="0,12,0,6" />
    <Setter Property="BorderBrush" Value="{DynamicResource GuiCardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadiusCard}" />
    <Setter Property="Background" Value="{DynamicResource GuiChangeRow}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="ctl:InnerClip.IsEnabled" Value="True" />
  </Style>
  <Style Selector="Grid.change-card-head">
    <Setter Property="MinHeight" Value="62" />
    <Setter Property="Background" Value="{DynamicResource GuiChangeHead}" />
  </Style>
  <Style Selector="Grid.change-card-head > Border.change-tile">
    <Setter Property="Margin" Value="12,0,0,0" />
  </Style>
  <Style Selector="Grid.change-card-head > Button.turn-file-open">
    <Setter Property="Margin" Value="0,0,12,0" />
  </Style>
  <Style Selector="TextBlock.change-card-title">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontS}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <!-- The card's icon on a small dark rounded tile -->
  <Style Selector="Border.change-tile">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadius8}" />
    <Setter Property="Background" Value="{DynamicResource GuiWindow}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextSecondary}" />
  </Style>
  <Style Selector="TextBlock.turn-file-stat">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontCaption}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.turn-file-open">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="{DynamicResource GuiFontCaption}" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadiusControl}" />
  </Style>
  <!-- A file's row (and "Show N more files"): opens it; a hairline over it -->
  <Style Selector="Button.turn-file">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource GuiHairline}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="{DynamicResource GuiFontCaption}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.turn-file:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.turn-file:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GuiFill1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GuiHairline}" />
  </Style>
  <Style Selector="Button.turn-file.more-files">
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <Style Selector="Run.file-folder">
    <Setter Property="Foreground" Value="{DynamicResource GuiTextTertiary}" />
  </Style>
  <Style Selector="TextBlock.turn-file-path">
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
    <Setter Property="FontSize" Value="{DynamicResource GuiFontS}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.turn-file-path.deleted">
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
    <Setter Property="TextDecorations" Value="Strikethrough" />
  </Style>
  <Style Selector="Run.moved-from">
    <Setter Property="Foreground" Value="{DynamicResource GuiTextTertiary}" />
  </Style>
  <Style Selector="Border.change-tag">
    <Setter Property="Background" Value="{DynamicResource GuiFill2}" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadius4}" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.change-tag TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontCaption}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
  </Style>
  <Style Selector="Border.change-tag.created">
    <Setter Property="Background" Value="{DynamicResource GuiDiffAddedBg}" />
  </Style>
  <Style Selector="Border.change-tag.created TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource GuiDiffAddedText}" />
  </Style>
  <Style Selector="Border.change-tag.deleted">
    <Setter Property="Background" Value="{DynamicResource GuiDiffRemovedBg}" />
  </Style>
  <Style Selector="Border.change-tag.deleted TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource GuiDiffRemovedText}" />
  </Style>
  <Style Selector="Border.change-tag.moved">
    <Setter Property="Background" Value="{DynamicResource GuiDiffMovedBg}" />
  </Style>
  <Style Selector="Border.change-tag.moved TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource GuiDiffMovedText}" />
  </Style>
  <Style Selector="Border.command-output">
    <Setter Property="Background" Value="{DynamicResource GuiCodeBlockBg}" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadiusControl}" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Border.notice">
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadiusControl}" />
    <Setter Property="Padding" Value="0,2" />
  </Style>
  <Style Selector="Border.notice.error">
    <Setter Property="Background" Value="{DynamicResource GuiStatusErrorSoft}" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Border.notice.warning">
    <Setter Property="Background" Value="{DynamicResource GuiStatusWarningSoft}" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <!-- A notice in the conversation (Codex's system line): its words centred, 12 px secondary, between two hairlines; an
       error's or a warning's mark before them in its status colour -->
  <Style Selector="Grid.notice-line">
    <Setter Property="Margin" Value="0,14" />
  </Style>
  <Style Selector="Border.notice-rule">
    <Setter Property="Height" Value="1" />
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource GuiHairline}" />
  </Style>
  <Style Selector="TextBlock.notice-text, SelectableTextBlock.notice-text">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontCaption}" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="MaxWidth" Value="440" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Grid.notice-line > Grid, Grid.notice-line > TextBlock.notice-text">
    <Setter Property="Margin" Value="12,0" />
  </Style>
  <!-- Jump to latest: a 32 px button, widened only for its new-activity dot. -->
  <Style Selector="Button#JumpToLatest">
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource GuiWindow}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadiusFull}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GuiCardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ctl:Motion.Kind" Value="FadeBase" />
  </Style>
  <Style Selector="Button#JumpToLatest:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GuiChangeHead}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GuiCardBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>

  <!-- ─────────────── File changes (Controls/DiffView) ─────────────── -->
  <!-- One hairline card per changed file at the tool's text edge: the path (folder quiet, name strong), what happened to
       the file and +/− in its header; numbered rows (old | new gutters), a changed row with a solid bar at its left edge,
       a tinted fill and its changed words on a stronger tint -->
  <Style Selector="ctl|DiffView.tool-diff">
    <Setter Property="Margin" Value="30,2,8,8" />
  </Style>
  <!-- The header on the card's surface: it stays at the top of the view over the card's lines (Controls/StickyHeader).
       Its bar lies over the card's top hairline and draws it, rounded like the card. Held at the top of the view it is
       square, with a hairline and a short shadow over the lines scrolling under it, as a Shell card's bar: the card goes
       on above -->
  <Style Selector="Border.diff-head">
    <Setter Property="Margin" Value="-1,-1,-1,0" />
  </Style>
  <Style Selector="Border.diff-head.stuck">
    <Setter Property="BoxShadow" Value="{DynamicResource GuiShadowStuck}" />
  </Style>
  <Style Selector="Border.diff-head-bar">
    <Setter Property="Background" Value="{DynamicResource GuiCodeBlockHeader}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GuiCodeBlockBorder}" />
    <Setter Property="BorderThickness" Value="1,1,1,0" />
    <Setter Property="CornerRadius" Value="12,12,0,0" />
  </Style>
  <Style Selector="Border.diff-head.stuck > Border.diff-head-bar">
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <!-- Folds the card away (its tool row's line) -->
  <Style Selector="Button.diff-collapse">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Margin" Value="8,0,-4,0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.diff-collapse:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.diff-collapse:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GuiFill1}" />
  </Style>
  <Style Selector="Button.diff-collapse ctl|Icon">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextTertiary}" />
  </Style>
  <Style Selector="Button.diff-collapse:pointerover ctl|Icon">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <!-- A code card like the console and Markdown's code blocks: radius 12, a hairline, the code surface -->
  <Style Selector="Border.diff-card">
    <Setter Property="BorderBrush" Value="{DynamicResource GuiCodeBlockBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadiusCard}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="ctl:InnerClip.IsEnabled" Value="True" />
    <Setter Property="Background" Value="{DynamicResource GuiCodeBlockBg}" />
  </Style>
  <Style Selector="Grid.diff-header">
    <Setter Property="Height" Value="32" />
    <Setter Property="Margin" Value="12,0" />
  </Style>
  <Style Selector="ctl|Icon.diff-file-icon">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextTertiary}" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <Style Selector="TextBlock.diff-path">
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <!-- What happened to the file: a small pill after the path -->
  <Style Selector="Border.diff-badge">
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadiusFull}" />
    <Setter Property="Padding" Value="7,1" />
    <Setter Property="Margin" Value="8,0,0,0" />
  </Style>
  <Style Selector="Border.diff-badge TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.diff-badge.created">
    <Setter Property="Background" Value="{DynamicResource GuiDiffAddedBg}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiDiffAddedText}" />
  </Style>
  <Style Selector="Border.diff-badge.deleted">
    <Setter Property="Background" Value="{DynamicResource GuiDiffRemovedBg}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiDiffRemovedText}" />
  </Style>
  <Style Selector="Border.diff-badge.moved">
    <Setter Property="Background" Value="{DynamicResource GuiDiffMovedBg}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiDiffMovedText}" />
  </Style>
  <Style Selector="TextBlock.diff-added">
    <Setter Property="Foreground" Value="{DynamicResource GuiDiffAddedText}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.diff-removed">
    <Setter Property="Foreground" Value="{DynamicResource GuiDiffRemovedText}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="StackPanel.diff-body">
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style Selector="Grid.diff-row.added">
    <Setter Property="Background" Value="{DynamicResource GuiDiffAddedBg}" />
  </Style>
  <Style Selector="Grid.diff-row.removed">
    <Setter Property="Background" Value="{DynamicResource GuiDiffRemovedBg}" />
  </Style>
  <!-- A new file is all added lines: a lighter fill, the bar says it -->
  <Style Selector="Border.diff-card.created Grid.diff-row.added">
    <Setter Property="Background" Value="{DynamicResource GuiDiffNewFileBg}" />
  </Style>
  <Style Selector="Grid.diff-row.gap">
    <Setter Property="Background" Value="{DynamicResource GuiFill1}" />
  </Style>
  <Style Selector="Grid.diff-row.added Border.diff-bar">
    <Setter Property="Background" Value="{DynamicResource GuiDiffAddedBar}" />
  </Style>
  <Style Selector="Grid.diff-row.removed Border.diff-bar">
    <Setter Property="Background" Value="{DynamicResource GuiDiffRemovedBar}" />
  </Style>
  <Style Selector="TextBlock.diff-number">
    <Setter Property="Foreground" Value="{DynamicResource GuiTextTertiary}" />
  </Style>
  <Style Selector="Grid.diff-row.added TextBlock.diff-number">
    <Setter Property="Foreground" Value="{DynamicResource GuiDiffAddedText}" />
  </Style>
  <Style Selector="Grid.diff-row.removed TextBlock.diff-number">
    <Setter Property="Foreground" Value="{DynamicResource GuiDiffRemovedText}" />
  </Style>
  <Style Selector="TextBlock.diff-sign">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Grid.diff-row.added TextBlock.diff-sign">
    <Setter Property="Foreground" Value="{DynamicResource GuiDiffAddedText}" />
  </Style>
  <Style Selector="Grid.diff-row.removed TextBlock.diff-sign">
    <Setter Property="Foreground" Value="{DynamicResource GuiDiffRemovedText}" />
  </Style>
  <Style Selector="SelectableTextBlock.diff-code">
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <Style Selector="TextBlock.diff-gap">
    <Setter Property="Foreground" Value="{DynamicResource GuiTextTertiary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.link.diff-more">
    <Setter Property="Margin" Value="12,0,0,8" />
    <Setter Property="MinHeight" Value="24" />
  </Style>

  <!-- ─────────────── Markdown (Controls/MarkdownView.cs md-* classes) ─────────────── -->
  <!-- Code block (Codex): a card on #2A2A2A, radius 12, a #333 hairline; a 36 px header on the same fill (no rule under
       it) with a code icon and the language on the left, wrap and Copy on the right, held at the top of the view while
       the block is on screen; the code under it -->
  <Style Selector="Border.codeblock">
    <Setter Property="Background" Value="{DynamicResource GuiCodeBlockBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GuiCodeBlockBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadiusCard}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="ctl:InnerClip.IsEnabled" Value="True" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Border.md-code-head">
    <Setter Property="Background" Value="{DynamicResource GuiCodeBlockHeader}" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="14,0,6,0" />
  </Style>
  <!-- Held at the top of the view (Controls/StickyHeader): as a Shell card's bar, a hairline and a short shadow over the
       lines scrolling under it -->
  <Style Selector="Border.md-code-head.stuck">
    <Setter Property="BoxShadow" Value="{DynamicResource GuiShadowStuck}" />
  </Style>
  <Style Selector="Border.md-code-body">
    <Setter Property="Padding" Value="16,2,16,14" />
  </Style>
  <Style Selector="Button.md-wrap.on">
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <Style Selector="ctl|Icon.md-code-icon">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextPrimary}" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <Style Selector="TextBlock.md-code-lang">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <Style Selector="Button.icon.md-copy">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
  </Style>
  <Style Selector="SelectableTextBlock.md-code">
    <Setter Property="FontFamily" Value="{DynamicResource GuiFontMono}" />
    <Setter Property="FontSize" Value="{DynamicResource GuiFontCode}" />
    <Setter Property="LineHeight" Value="20" />
  </Style>
  <!-- Inline code (Codex): mono on an opaque #303030 chip, radius 4 (MarkdownView.CodeChip) -->
  <Style Selector="Border.md-inline-code">
    <Setter Property="Background" Value="{DynamicResource GuiInlineCodeBg}" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadius4}" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Margin" Value="1,0" />
  </Style>
  <Style Selector="HyperlinkButton.md-link">
    <Setter Property="Foreground" Value="{DynamicResource GuiTextLink}" />
  </Style>
  <Style Selector="HyperlinkButton.md-link:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource GuiTextLinkHover}" />
  </Style>
  <!-- Lists: bullets and numbers in the text's colour (Codex), a short indent -->
  <Style Selector="TextBlock.md-marker">
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <!-- Block quote: a 3 px bar; the quoted text in secondary -->
  <Style Selector="Grid.md-quote">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextSecondary}" />
  </Style>
  <Style Selector="Border.md-quote-bar">
    <Setter Property="Width" Value="3" />
    <Setter Property="CornerRadius" Value="1.5" />
    <Setter Property="Background" Value="{DynamicResource GuiCardBorder}" />
  </Style>
  <!-- Thematic break: a pale hairline -->
  <Style Selector="Border.md-rule">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,8" />
    <Setter Property="Background" Value="{DynamicResource GuiBorder}" />
  </Style>
  <!-- Tables (Codex): no frame and no fills; 12 px text, the header row semibold over a #3C3C3C rule, fainter #222 rules
       between the rows, 16 px between the columns -->
  <Style Selector="Border.md-table-frame">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.md-row-hover.active">
    <Setter Property="Background" Value="{DynamicResource GuiFill1Hover}" />
  </Style>
  <Style Selector="Border.md-cell">
    <Setter Property="BorderBrush" Value="{DynamicResource GuiTableRule}" />
    <Setter Property="Padding" Value="0,9,16,9" />
  </Style>
  <Style Selector="Border.md-cell.md-th">
    <Setter Property="BorderBrush" Value="{DynamicResource GuiCardBorder}" />
  </Style>
  <Style Selector="SelectableTextBlock.md-th-text">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontCaption}" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="SelectableTextBlock.md-td-text">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontCaption}" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- ─────────────── Dialog cards (approval, question, confirm, input): one chrome ─────────────── -->
  <Style Selector="Border.dialog">
    <Setter Property="BorderBrush" Value="{DynamicResource GuiBorderSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadius16}" />
    <Setter Property="Padding" Value="16,14,16,16" />
  </Style>
  <Style Selector="TextBlock.dialog-title, SelectableTextBlock.dialog-title">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontM}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="ctl|Icon.dialog-mark">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiBrandMark}" />
  </Style>
  <Style Selector="Border.details">
    <Setter Property="Background" Value="{DynamicResource GuiCodeBlockBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GuiBorderSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadiusCard}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="ctl:InnerClip.IsEnabled" Value="True" />
  </Style>
  <Style Selector="SelectableTextBlock.details">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="LineHeight" Value="19" />
  </Style>
</Styles>
