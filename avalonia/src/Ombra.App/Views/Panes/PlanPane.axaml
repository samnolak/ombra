<!-- The Plan pane (Claude Code's plan with checkboxes): omp's todo list by phase. Each task has a drawn box — checked
     when done, an info box with a dot while in progress (the current one on a fill, with what the run does now under
     it), a warning box and what it waits on when blocked, a cross and struck text when dropped. Earlier plans and every
     change stay below, folded. The current plan can be edited: the box marks a task done or to do, its ⋯ menu edits,
     reorders, sets the status or deletes it, and a task can be added at the end; each change goes to omp (set_todos).
     DataContext: PlanViewModel. -->
<UserControl xmlns:loc="using:Ombra.App.Localization"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ombra.App.ViewModels"
             xmlns:ctl="using:Ombra.App.Controls"
             x:Class="Ombra.App.Views.Panes.PlanPane"
             x:DataType="vm:PlanViewModel">
  <UserControl.Styles>
    <!-- The box as a button: nothing around it but the box; not clickable on an earlier plan -->
    <Style Selector="Button.plan-check">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.plan-check:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.plan-check:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- The ⋯ of a task: quiet until the row is hovered or the menu is open -->
    <Style Selector="Border.plan-task Button.plan-more">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Border.plan-task:pointerover Button.plan-more, Border.plan-task Button.plan-more:focus-visible, Border.plan-task Button.plan-more:flyout-open">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <DataTemplate x:Key="PlanTaskTemplate" x:DataType="vm:PlanTaskViewModel">
      <Border Classes="plan-task" Classes.current="{Binding IsCurrent}" ToolTip.Tip="{Binding StatusName}"
              AutomationProperties.Name="{Binding AccessibleName}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <!-- The box sits on the text's first line (20 px line: 2 above, 16 box, 2 below); a click marks it done or to do -->
          <Button Classes="plan-check" Command="{Binding ToggleDoneCommand}" IsHitTestVisible="{Binding CanEdit}" Focusable="{Binding CanEdit}"
                  Margin="0,2,0,0" AutomationProperties.Name="{Binding AccessibleName}" ToolTip.Tip="{loc:T 'Mark done or to do'}">
            <Border Classes="md-check" Classes.checked="{Binding IsDone}" Classes.active="{Binding IsActive}" Classes.dropped="{Binding IsDropped}"
                    Classes.blocked="{Binding IsBlocked}" Width="16" Height="16">
              <Panel>
                <ctl:Icon Data="{StaticResource IconCheck}" Size="12" StrokeThickness="3.5" IsVisible="{Binding IsDone}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Ellipse Classes="todo-active-dot" IsVisible="{Binding IsActive}" />
                <ctl:Icon Data="{StaticResource IconClose}" Size="12" IsVisible="{Binding IsDropped}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border Classes="plan-hold" IsVisible="{Binding IsBlocked}" />
              </Panel>
            </Border>
          </Button>
          <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="3">
            <TextBlock Classes="plan-text" Classes.done="{Binding IsDone}" Classes.dropped="{Binding IsDropped}" Classes.current="{Binding IsCurrent}"
                       Text="{Binding Content}" IsVisible="{Binding !IsEditing}" />
            <!-- Editing in place: Enter keeps the new text, Esc keeps the old -->
            <TextBox x:Name="PlanTaskEditBox" Classes="sm" Text="{Binding EditText}" IsVisible="{Binding IsEditing}" TextWrapping="Wrap"
                     AutomationProperties.Name="{loc:T 'Task text'}" ctl:FocusOnShow.When="{Binding IsEditing}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding CommitEditCommand}" />
                <KeyBinding Gesture="Escape" Command="{Binding CancelEditCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsBlocked}">
              <ctl:Icon Classes="warning-mark" Data="{StaticResource IconAlert}" Size="15" Margin="0,2,6,0" VerticalAlignment="Top" />
              <TextBlock Grid.Column="1" Classes="plan-note" Text="{Binding BlockerText}" />
            </Grid>
            <TextBlock Classes="plan-activity" Text="{Binding Activity}" IsVisible="{Binding HasActivity}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <!-- The task's actions: edit, status, order, delete -->
          <Button x:Name="PlanTaskMenu" Grid.Column="2" Classes="icon sm plan-more" IsVisible="{Binding CanEdit}" Margin="6,-4,0,0" VerticalAlignment="Top"
                  AutomationProperties.Name="{loc:T 'Task actions'}" ToolTip.Tip="{loc:T 'Edit, reorder or delete this task'}">
            <ctl:Icon Data="{StaticResource IconMoreHorizontal}" Size="16" />
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight" ctl:ChoiceMenu.CloseOnChoice="True">
                <StackPanel MinWidth="200" Spacing="1">
                  <Button Classes="menu-item" Command="{Binding StartEditCommand}" AutomationProperties.Name="{loc:T 'Edit text'}">
                    <Grid ColumnDefinitions="Auto,*">
                      <ctl:Icon Data="{StaticResource IconPencil}" Size="16" Margin="0,0,10,0" />
                      <TextBlock Grid.Column="1" Text="{loc:T 'Edit text'}" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                  <Border Classes="menu-separator" />
                  <Button Classes="menu-item" Command="{Binding SetStatusCommand}" CommandParameter="pending" AutomationProperties.Name="{loc:T 'To do'}">
                    <TextBlock Text="{loc:T 'To do'}" Margin="26,0,0,0" VerticalAlignment="Center" />
                  </Button>
                  <Button Classes="menu-item" Command="{Binding SetStatusCommand}" CommandParameter="in_progress" AutomationProperties.Name="{loc:T 'In progress'}">
                    <TextBlock Text="{loc:T 'In progress'}" Margin="26,0,0,0" VerticalAlignment="Center" />
                  </Button>
                  <Button Classes="menu-item" Command="{Binding SetStatusCommand}" CommandParameter="completed" AutomationProperties.Name="{loc:T 'Done'}">
                    <TextBlock Text="{loc:T 'Done'}" Margin="26,0,0,0" VerticalAlignment="Center" />
                  </Button>
                  <Button Classes="menu-item" Command="{Binding SetStatusCommand}" CommandParameter="abandoned" AutomationProperties.Name="{loc:T 'Dropped'}">
                    <TextBlock Text="{loc:T 'Dropped'}" Margin="26,0,0,0" VerticalAlignment="Center" />
                  </Button>
                  <Border Classes="menu-separator" />
                  <Button Classes="menu-item" Command="{Binding MoveUpCommand}" AutomationProperties.Name="{loc:T 'Move up'}">
                    <Grid ColumnDefinitions="Auto,*">
                      <ctl:Icon Data="{StaticResource IconArrowUp}" Size="16" Margin="0,0,10,0" />
                      <TextBlock Grid.Column="1" Text="{loc:T 'Move up'}" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                  <Button Classes="menu-item" Command="{Binding MoveDownCommand}" AutomationProperties.Name="{loc:T 'Move down'}">
                    <Grid ColumnDefinitions="Auto,*">
                      <ctl:Icon Data="{StaticResource IconArrowDown}" Size="16" Margin="0,0,10,0" />
                      <TextBlock Grid.Column="1" Text="{loc:T 'Move down'}" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                  <Border Classes="menu-separator" />
                  <Button Classes="menu-item danger" Command="{Binding DeleteCommand}" AutomationProperties.Name="{loc:T 'Delete task'}">
                    <Grid ColumnDefinitions="Auto,*">
                      <ctl:Icon Data="{StaticResource IconTrash}" Size="16" Margin="0,0,10,0" />
                      <TextBlock Grid.Column="1" Text="{loc:T 'Delete task'}" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="PlanPhaseTemplate" x:DataType="vm:PlanPhaseViewModel">
      <StackPanel Spacing="2">
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasName}" Margin="8,0,8,4">
          <TextBlock Classes="pane-group" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Classes="pane-count" Text="{Binding Count}" Margin="8,0,0,0" VerticalAlignment="Center" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource PlanTaskTemplate}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer x:Name="PlanScroll" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="12,14,12,24" Spacing="16">

      <!-- Nothing yet: when a plan appears -->
      <StackPanel x:Name="PlanEmpty" IsVisible="{Binding ShowEmptyHint}" Spacing="8" Margin="12,48,12,0" MaxWidth="300" HorizontalAlignment="Center">
        <ctl:Icon Classes="pane-empty-mark" Data="{StaticResource IconChecklist}" Size="28" />
        <TextBlock Text="{loc:T 'No plan yet'}" FontWeight="Medium" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                   Text="{loc:T 'When the agent breaks the work into steps (its todo list), the plan shows here and each step is checked off as it is done.'}" />
      </StackPanel>

      <!-- The current plan -->
      <StackPanel Spacing="14" IsVisible="{Binding HasPlan}">
        <ProgressBar x:Name="PlanProgressBar" Classes="plan-progress" Value="{Binding Progress}" Maximum="100" Margin="8,0" />
        <ItemsControl x:Name="PlanPhases" ItemsSource="{Binding Phases}" ItemTemplate="{StaticResource PlanPhaseTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="14" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
      <!-- Add a task at the end of the plan (a new plan when there is none): Enter or the + sends it to omp -->
      <Grid x:Name="PlanAddTask" ColumnDefinitions="*,Auto" Margin="8,0" IsVisible="{Binding IsEditable}">
        <TextBox x:Name="PlanNewTaskBox" Classes="sm" Text="{Binding NewTaskText}" PlaceholderText="{loc:T 'Add a task'}"
                 AutomationProperties.Name="{loc:T 'New task'}">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding AddTaskCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button x:Name="PlanAddTaskButton" Grid.Column="1" Classes="icon sm" Margin="6,0,0,0" Command="{Binding AddTaskCommand}"
                AutomationProperties.Name="{loc:T 'Add task'}" ToolTip.Tip="{loc:T 'Add this task to the plan (Enter)'}">
          <ctl:Icon Data="{StaticResource IconPlus}" Size="16" />
        </Button>
      </Grid>
      <Grid ColumnDefinitions="Auto,*" Margin="8,0" IsVisible="{Binding HasEditError}">
        <ctl:Icon Classes="error-mark" Data="{StaticResource IconAlert}" Size="16" VerticalAlignment="Top" Margin="0,0,8,0" />
        <TextBlock x:Name="PlanEditError" Grid.Column="1" Classes="error" Text="{Binding EditError}" TextWrapping="Wrap" FontSize="13" />
      </Grid>
      <TextBlock Classes="muted" Text="{loc:T 'No plan right now. The last one is below.'}" Margin="8,0" TextWrapping="Wrap">
        <TextBlock.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="!HasPlan" />
            <Binding Path="HasEarlierPlans" />
          </MultiBinding>
        </TextBlock.IsVisible>
      </TextBlock>

      <!-- Earlier plans: replaced or cleared, kept folded -->
      <ItemsControl x:Name="EarlierPlans" ItemsSource="{Binding EarlierPlans}" IsVisible="{Binding HasEarlierPlans}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:EarlierPlanViewModel">
            <Border Classes="plan-earlier">
              <StackPanel Spacing="4">
                <ToggleButton Classes="pane-fold flat" IsChecked="{Binding IsExpanded}" AutomationProperties.Name="{loc:T 'Earlier plan'}">
                  <Grid ColumnDefinitions="Auto,Auto,*">
                    <ctl:Icon Classes="chevron" Data="{StaticResource IconChevronRight}" Size="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{loc:T 'Earlier plan'}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="pane-count" Text="{Binding Summary}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding When}" />
                  </Grid>
                </ToggleButton>
                <StackPanel Spacing="8" IsVisible="{Binding IsExpanded}" Margin="0,0,0,4">
                  <TextBlock Classes="pane-count" Text="{Binding When}" Margin="8,0" />
                  <ItemsControl ItemsSource="{Binding Phases}" ItemTemplate="{StaticResource PlanPhaseTemplate}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Every change, newest first -->
      <StackPanel x:Name="PlanHistory" Spacing="4" IsVisible="{Binding HasHistory}">
        <ToggleButton x:Name="PlanHistoryToggle" Classes="pane-fold flat" IsChecked="{Binding IsHistoryOpen}" AutomationProperties.Name="{loc:T 'History'}">
          <Grid ColumnDefinitions="Auto,*">
            <ctl:Icon Classes="chevron" Data="{StaticResource IconChevronRight}" Size="16" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding HistoryTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </Grid>
        </ToggleButton>
        <!-- The times in one column ("14:32", or "Sep 24 14:32" before today) -->
        <ItemsControl ItemsSource="{Binding Changes}" IsVisible="{Binding IsHistoryOpen}" Margin="8,0,8,0" Grid.IsSharedSizeScope="True">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PlanChangeViewModel">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="PlanTime" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Classes="plan-note" Text="{Binding Time}" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Classes="plan-note">
                  <Run Text="{Binding What}" FontWeight="SemiBold" Foreground="{DynamicResource GuiTextPrimary}" />
                  <Run Text="{Binding Content}" />
                </TextBlock>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
