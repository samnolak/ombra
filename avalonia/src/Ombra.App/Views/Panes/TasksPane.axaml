<!-- The Background tasks pane: omp's subagents (its task tool) as they run and after they end — status, how long,
     what each does now, tools and tokens; a card opens to its task, latest output and own conversation — then omp's
     background jobs (get_jobs: long commands, async tasks) with Stop, their output and "waiting for input".
     DataContext: TasksViewModel. -->
<UserControl xmlns:loc="using:Ombra.App.Localization"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ombra.App.ViewModels"
             xmlns:ctl="using:Ombra.App.Controls"
             x:Class="Ombra.App.Views.Panes.TasksPane"
             x:DataType="vm:TasksViewModel">
  <ScrollViewer x:Name="TasksScroll" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="12,14,12,24" Spacing="18">

      <!-- Nothing yet -->
      <StackPanel x:Name="TasksEmpty" IsVisible="{Binding IsEmpty}" Spacing="8" Margin="12,48,12,0" MaxWidth="300" HorizontalAlignment="Center">
        <ctl:Icon Classes="pane-empty-mark" Data="{StaticResource IconLayers}" Size="28" />
        <TextBlock Text="{loc:T 'No background tasks'}" FontWeight="Medium" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding !IsUnsupported}"
                   Text="{loc:T 'Subagents the agent starts and commands it leaves running in the background show here while they work, and stay listed after they finish.'}" />
        <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding IsUnsupported}"
                   Text="{loc:T 'Commands the agent leaves running in the background show here while they run and for a few minutes after.'}" />
      </StackPanel>
      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsUnsupported}" Margin="8,0">
        <ctl:Icon Classes="warning-mark" Data="{StaticResource IconAlert}" Size="16" Margin="0,1,8,0" VerticalAlignment="Top" />
        <TextBlock Grid.Column="1" Classes="muted" TextWrapping="Wrap"
                   Text="{loc:T 'Subagents appear here with a newer omp. Update omp to see them; background jobs are listed either way.'}" />
      </Grid>

      <!-- Subagents -->
      <StackPanel x:Name="SubagentsSection" Spacing="8" IsVisible="{Binding HasSubagents}">
        <Grid ColumnDefinitions="*,Auto" Margin="8,0">
          <TextBlock Classes="pane-group" Text="{loc:T 'Subagents'}" VerticalAlignment="Center" />
          <Button x:Name="StopAllSubagents" Grid.Column="1" Classes="link action" Content="{loc:T 'Stop all'}" Command="{Binding StopAllCommand}"
                  IsVisible="{Binding CanStopAll}" Padding="0" MinHeight="0" ToolTip.Tip="{loc:T 'Stop every running subagent'}" />
        </Grid>
        <ItemsControl x:Name="SubagentList" ItemsSource="{Binding Subagents}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SubagentRowViewModel">
              <Border Classes="task-card subagent-card" Classes.running="{Binding IsRunning}" EffectiveViewportChanged="OnCardViewportChanged" DetachedFromVisualTree="OnCardDetached">
                <StackPanel>
                  <ToggleButton Classes="task-row flat" IsChecked="{Binding IsExpanded}" AutomationProperties.Name="{Binding AccessibleName}"
                                ToolTip.Tip="{loc:T 'Show its task, output and conversation'}">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Classes="task-title" Text="{Binding Title}" />
                        <TextBlock Grid.Column="1" Classes="task-line" Text="{Binding ElapsedText}" Margin="8,2,0,0" VerticalAlignment="Top" />
                        <ctl:Icon Grid.Column="2" Classes="chevron" Data="{StaticResource IconChevronRight}" Size="16" Margin="6,2,0,0" VerticalAlignment="Top" />
                      </Grid>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="status" Classes.running="{Binding IsRunning}" Classes.done="{Binding IsDone}" Classes.failed="{Binding IsFailed}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse />
                            <TextBlock Text="{Binding StatusText}" />
                          </StackPanel>
                        </Border>
                        <TextBlock Classes="task-line" Text="{Binding Agent}" VerticalAlignment="Center" />
                        <!-- A space's width after the agent, as in "bash · running", not the row's 8 px -->
                        <TextBlock Classes="task-line" Text="{loc:T '· in the background'}" IsVisible="{Binding IsBackground}" VerticalAlignment="Center" Margin="-4,0,0,0" />
                      </StackPanel>
                      <!-- Two lines: a failed task's reason ("… refused the request (rate limited)") had lost its end -->
                      <TextBlock Classes="task-line" Text="{Binding ActivityText}" IsVisible="{Binding HasActivity}" TextWrapping="Wrap" MaxLines="2" />
                      <TextBlock Classes="task-line" Text="{Binding MetaText}" IsVisible="{Binding HasMeta}" />
                      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasRetryNote}">
                        <ctl:Icon Classes="warning-mark" Data="{StaticResource IconAlert}" Size="15" Margin="0,1,6,0" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Classes="plan-note" Text="{Binding RetryNote}" />
                      </Grid>
                    </StackPanel>
                  </ToggleButton>
                  <!-- Running: stop it, or tell it something; a failure stays on the card -->
                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="12,0,12,10" IsVisible="{Binding IsRunning}">
                    <TextBox x:Name="SubagentMessageBox" Text="{Binding MessageText}" Watermark="{loc:T 'Message this subagent…'}"
                             AutomationProperties.Name="{loc:T 'Message this subagent'}" IsEnabled="{Binding !IsSending}">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SendMessageCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                    <Button x:Name="SubagentSend" Grid.Column="1" Classes="flat" Content="{loc:T 'Send'}" Command="{Binding SendMessageCommand}"
                            IsEnabled="{Binding CanSend}" Margin="6,0,0,0" ToolTip.Tip="{loc:T 'Send it to this subagent while it works'}" />
                    <Button x:Name="SubagentStop" Grid.Column="2" Classes="flat" Content="{loc:T 'Stop'}" Command="{Binding StopCommand}"
                            IsEnabled="{Binding CanStop}" Margin="6,0,0,0" ToolTip.Tip="{loc:T 'Stop this subagent'}" />
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*" Margin="12,0,12,10" IsVisible="{Binding HasActionError}">
                    <ctl:Icon Classes="warning-mark" Data="{StaticResource IconAlert}" Size="15" Margin="0,1,6,0" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Classes="plan-note" Text="{Binding ActionError}" TextWrapping="Wrap" />
                  </Grid>
                  <!-- Open: the task, what it used and printed lately, its own conversation -->
                  <StackPanel IsVisible="{Binding IsExpanded}" Margin="12,0,12,12" Spacing="10">
                    <StackPanel Spacing="4" IsVisible="{Binding HasTask}">
                      <TextBlock Classes="pane-group" Text="{loc:T 'Task'}" />
                      <SelectableTextBlock Classes="plan-note" Text="{Binding TaskText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="4" IsVisible="{Binding HasTools}">
                      <TextBlock Classes="pane-group" Text="{loc:T 'Recent tools'}" />
                      <Border Classes="task-code">
                        <SelectableTextBlock Classes="mono" Text="{Binding ToolsText}" TextWrapping="Wrap" Foreground="{DynamicResource GuiTextSecondary}" />
                      </Border>
                    </StackPanel>
                    <StackPanel Spacing="4" IsVisible="{Binding HasOutput}">
                      <TextBlock Classes="pane-group" Text="{loc:T 'Latest output'}" />
                      <Border Classes="task-code">
                        <SelectableTextBlock Classes="mono" Text="{Binding OutputText}" TextWrapping="Wrap" Foreground="{DynamicResource GuiTextSecondary}" />
                      </Border>
                    </StackPanel>
                    <StackPanel Spacing="6">
                      <TextBlock Classes="pane-group" Text="{loc:T 'Conversation'}" IsVisible="{Binding MessagesLoaded}" />
                      <TextBlock Classes="muted" Text="{loc:T 'Live preview · latest 40 entries; long text is shortened'}" IsVisible="{Binding MessagesLoaded}" TextWrapping="Wrap" />
                      <Button Classes="link action" Content="{loc:T 'Show its conversation'}" Command="{Binding LoadMessagesCommand}" IsVisible="{Binding !MessagesLoaded}"
                              IsEnabled="{Binding !IsLoadingMessages}" HorizontalAlignment="Left" Padding="0" MinHeight="0"
                              ToolTip.Tip="{loc:T 'The subagent’s own messages and tool calls, as omp saved them'}" />
                      <TextBlock Classes="muted" Text="{loc:T 'Reading…'}" IsVisible="{Binding IsLoadingMessages}" />
                      <TextBlock Classes="muted" Text="{Binding MessagesNote}" IsVisible="{Binding HasMessagesNote}" TextWrapping="Wrap" />
                      <ItemsControl ItemsSource="{Binding Messages}" IsVisible="{Binding MessagesLoaded}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SubagentMessageViewModel">
                            <StackPanel Spacing="2">
                              <TextBlock Classes="task-message-role" Text="{Binding Label}" />
                              <SelectableTextBlock Classes="plan-note" Text="{Binding Text}" TextWrapping="Wrap" IsVisible="{Binding !IsTool}"
                                                   Foreground="{DynamicResource GuiTextPrimary}" />
                              <SelectableTextBlock Classes="mono" Text="{Binding Text}" TextWrapping="Wrap" IsVisible="{Binding IsTool}"
                                                   Foreground="{DynamicResource GuiTextSecondary}" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Background jobs (omp's get_jobs) -->
      <StackPanel x:Name="JobsSection" Spacing="8">
        <StackPanel.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.Or}">
            <Binding Path="HasJobs" />
            <Binding Path="HasJobsError" />
          </MultiBinding>
        </StackPanel.IsVisible>
        <TextBlock Classes="pane-group" Text="{loc:T 'Background jobs'}" Margin="8,0" />
        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasJobsError}" Margin="8,0">
          <ctl:Icon Classes="warning-mark" Data="{StaticResource IconAlert}" Size="16" Margin="0,1,8,0" VerticalAlignment="Top" />
          <TextBlock Grid.Column="1" Classes="muted" Text="{Binding JobsError}" TextWrapping="Wrap" />
        </Grid>
        <ItemsControl x:Name="JobList" ItemsSource="{Binding Jobs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:JobRowViewModel">
              <Border Classes="task-card" Classes.running="{Binding IsRunning}" Padding="12,10" AutomationProperties.Name="{Binding AccessibleName}">
                <StackPanel Spacing="6">
                  <TextBlock Classes="task-title" Text="{Binding Title}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="status" Classes.running="{Binding IsRunning}" Classes.done="{Binding IsDone}" Classes.failed="{Binding IsFailed}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse />
                        <TextBlock Text="{Binding StatusText}" />
                      </StackPanel>
                    </Border>
                    <TextBlock Classes="task-line" Text="{Binding Detail}" VerticalAlignment="Center" />
                  </StackPanel>
                  <!-- Quiet on what looks like a prompt: a background command cannot be answered from here -->
                  <Grid x:Name="JobWaiting" ColumnDefinitions="Auto,*" IsVisible="{Binding IsWaitingForInput}">
                    <ctl:Icon Classes="warning-mark" Data="{StaticResource IconAlert}" Size="15" Margin="0,1,6,0" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Classes="plan-note" TextWrapping="Wrap"
                               Text="{loc:T 'It seems to wait for input: its last line looks like a question. A background command can’t be answered; stop it, or ask the agent to run it without prompts.'}" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Name="JobOutputToggle" Classes="flat" Content="{Binding OutputToggleText}" Command="{Binding ToggleOutputCommand}"
                            ToolTip.Tip="{loc:T 'What it printed, the latest part first, updated while it runs'}" />
                    <Button x:Name="JobStop" Classes="flat" Content="{loc:T 'Stop'}" Command="{Binding StopCommand}"
                            IsVisible="{Binding IsRunning}" IsEnabled="{Binding CanStop}" ToolTip.Tip="{loc:T 'Stop this job'}" />
                  </StackPanel>
                  <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasActionError}">
                    <ctl:Icon Classes="warning-mark" Data="{StaticResource IconAlert}" Size="15" Margin="0,1,6,0" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Classes="plan-note" Text="{Binding ActionError}" TextWrapping="Wrap" />
                  </Grid>
                  <StackPanel Spacing="4" IsVisible="{Binding IsOutputShown}">
                    <TextBlock Classes="muted" Text="{loc:T 'Reading…'}" IsVisible="{Binding IsLoadingOutput}" />
                    <TextBlock Classes="muted" Text="{Binding OutputNote}" IsVisible="{Binding HasOutputNote}" TextWrapping="Wrap" />
                    <Border Classes="task-code" IsVisible="{Binding HasOutput}">
                      <SelectableTextBlock x:Name="JobOutputText" Classes="mono" Text="{Binding OutputText}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource GuiTextSecondary}" />
                    </Border>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
