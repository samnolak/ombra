<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ombra.App.App"
             Name="Ombra"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- The client's design tokens and line icons -->
        <ResourceInclude Source="avares://Ombra/Views/Tokens.axaml" />
        <ResourceInclude Source="avares://Ombra/Views/Icons.axaml" />
        <ResourceInclude Source="avares://Ombra/Views/Icons.Panes.axaml" />
        <ResourceInclude Source="avares://Ombra/Views/Icons.Files.axaml" />
        <ResourceInclude Source="avares://Ombra/Views/Icons.Pets.axaml" />
        <ResourceInclude Source="avares://Ombra/Views/Icons.Connectors.axaml" />
        <ResourceInclude Source="avares://Ombra/Views/Icons.Workspace.axaml" />
        <ResourceInclude Source="avares://Ombra/Views/Icons.Session.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <!-- The terminal's own theme, included here rather than injected by the library on first use: its injection is
         guarded by a process-wide flag, so an Application created later in the same process (the test host) never got it. -->
    <StyleInclude Source="avares://Iciclecreek.Avalonia.Terminal/Themes/Generic.axaml" />
    <StyleInclude Source="avares://Ombra/Views/Styles.axaml" />
    <StyleInclude Source="avares://Ombra/Views/Styles.Panes.axaml" />
    <StyleInclude Source="avares://Ombra/Views/Styles.Files.axaml" />
    <StyleInclude Source="avares://Ombra/Views/Styles.Pets.axaml" />
    <StyleInclude Source="avares://Ombra/Views/Styles.Connectors.axaml" />
    <StyleInclude Source="avares://Ombra/Views/Styles.Workspace.axaml" />
    <StyleInclude Source="avares://Ombra/Views/Styles.Session.axaml" />
    <StyleInclude Source="avares://Ombra/Views/Styles.Composer.axaml" />
    <StyleInclude Source="avares://Ombra/Views/Styles.Images.axaml" />
  </Application.Styles>
</Application>
