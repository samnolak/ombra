<!-- What a settings section says after an action: done (a check), an error in omp's words, and the restart offer when
     omp applies the change only when it starts. Used by the Connectors and Plugins and skills pages. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmpGui.App.ViewModels"
             xmlns:ctl="using:OmpGui.App.Controls"
             x:Class="OmpGui.App.Views.Settings.ConnectorsSettingsFeedback"
             x:DataType="vm:PageFeedbackViewModel"
             IsVisible="{Binding IsVisible}">
  <StackPanel Spacing="8">
    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasNotice}">
      <ctl:Icon Classes="positive-mark" Data="{StaticResource IconCheck}" Size="16" VerticalAlignment="Top" Margin="0,0,8,0" />
      <SelectableTextBlock Grid.Column="1" x:Name="FeedbackNotice" Text="{Binding Notice}" TextWrapping="Wrap" FontSize="13" />
    </Grid>
    <Border Classes="notice error" IsVisible="{Binding HasError}">
      <Grid ColumnDefinitions="Auto,*">
        <ctl:Icon Classes="error-mark" Data="{StaticResource IconAlert}" Size="16" VerticalAlignment="Top" Margin="0,0,8,0" />
        <SelectableTextBlock Grid.Column="1" x:Name="FeedbackError" Classes="error" Text="{Binding Error}" TextWrapping="Wrap" FontSize="13" />
      </Grid>
    </Border>
    <Border Classes="notice warning" IsVisible="{Binding ShowRestart}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <ctl:Icon Classes="warning-mark" Data="{StaticResource IconReload}" Size="16" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBlock Grid.Column="1" Text="{Binding RestartText}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center" />
        <Button Grid.Column="2" x:Name="RestartOmpButton" Content="Restart omp" Command="{Binding RestartCommand}" IsEnabled="{Binding !IsRestarting}"
                Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Restart omp" />
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
