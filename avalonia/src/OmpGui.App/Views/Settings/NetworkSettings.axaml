<!-- Settings › Advanced › Network: corporate network certificates (NetworkTrustViewModel, ClientCore/Network/CorporateTrust)
     and a connection check that sends one request without a key. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmpGui.App.ViewModels"
             xmlns:ctl="using:OmpGui.App.Controls"
             x:Class="OmpGui.App.Views.Settings.NetworkSettings"
             x:DataType="vm:MainViewModel">
  <Panel DataContext="{Binding NetworkTrust}">
    <Border x:Name="NetworkCard" Classes="section-card" x:DataType="vm:NetworkTrustViewModel">
      <StackPanel Spacing="12">
        <TextBlock Classes="section" Text="Network" />

        <!-- Corporate network certificates -->
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2" Margin="0,0,16,0" VerticalAlignment="Center">
            <TextBlock Classes="ws-title" Text="Corporate network certificates" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="For networks that inspect HTTPS traffic, where omp fails with SELF_SIGNED_CERT_IN_CHAIN or “unable to get local issuer certificate”. Nothing changes until you set it up." />
          </StackPanel>
          <Border Grid.Column="1" Classes="status done" IsVisible="{Binding IsOn}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse />
              <TextBlock Text="On" />
            </StackPanel>
          </Border>
        </Grid>
        <SelectableTextBlock x:Name="NetworkTrustStatus" Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="13" />
        <TextBlock x:Name="NetworkTrustUserSettings" Classes="muted" Text="{Binding UserSettingsText}" TextWrapping="Wrap"
                   IsVisible="{Binding HasUserSettingsText}" />
        <WrapPanel ItemSpacing="8" LineSpacing="8" IsVisible="{Binding !IsExplaining}">
          <Button x:Name="NetworkTrustSetUp" Classes="md" Classes.accent="{Binding !IsOn}" Content="{Binding SetUpLabel}" Command="{Binding BeginSetupCommand}" />
          <Button x:Name="NetworkTrustTurnOff" Classes="md flat" Content="Turn off" Command="{Binding TurnOffCommand}" IsVisible="{Binding IsOn}" />
        </WrapPanel>

        <!-- What changes, before anything does -->
        <Border x:Name="NetworkTrustExplain" Classes="ws-form" IsVisible="{Binding IsExplaining}">
          <StackPanel Spacing="10">
            <TextBlock Classes="ws-title" Text="{Binding ExplainTitle}" TextWrapping="Wrap" />
            <StackPanel Spacing="6" IsVisible="{Binding IsExplainingSystem}">
              <TextBlock TextWrapping="Wrap" FontSize="13"
                         Text="• omp's engine will trust the certificate authorities that macOS trusts: those in your Keychain, with their trust settings. macOS evaluates them; nothing is copied or read by the app." />
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding IsExplainingPem}">
              <TextBlock TextWrapping="Wrap" FontSize="13"
                         Text="• omp's engine will also trust the certificate authorities in a file you choose (PEM, .crt or .cer, from your IT department). The app checks it first: certificate authorities only, no private keys, not expired." />
              <TextBlock TextWrapping="Wrap" FontSize="13"
                         Text="• The app keeps its own copy, readable only by you, and points NODE_EXTRA_CA_CERTS at it. Your file is not changed." />
            </StackPanel>
            <TextBlock TextWrapping="Wrap" FontSize="13" Text="• Certificate checks stay on: only connections signed by a trusted authority are accepted." />
            <TextBlock TextWrapping="Wrap" FontSize="13"
                       Text="• Applies to omp's HTTPS connections and to the Bun and Node.js programs omp starts (they inherit its environment): every chat, and omp terminal tabs opened from now on." />
            <TextBlock TextWrapping="Wrap" FontSize="13" Text="• Unchanged: the system's trust store, VPN, proxies and network routes." />
            <TextBlock TextWrapping="Wrap" FontSize="13"
                       Text="• Not covered: the built-in browser, and tools with their own network stack, such as curl, git or Python." />
            <TextBlock TextWrapping="Wrap" FontSize="13" Classes="muted"
                       Text="Open chats restart omp to use it: idle ones now, working ones when their run ends." />

            <!-- The file: chosen, then checked locally -->
            <StackPanel Spacing="8" IsVisible="{Binding IsExplainingPem}">
              <Button x:Name="NetworkTrustChooseFile" Classes="md" Content="Choose file…" Command="{Binding ChooseFileCommand}" HorizontalAlignment="Left" />
              <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasChosenFile}">
                <Panel Margin="0,1,8,0" VerticalAlignment="Top">
                  <ctl:Icon Classes="ok-mark" Data="{StaticResource IconCheckCircle}" Size="16" IsVisible="{Binding ChosenFileOk}" />
                  <ctl:Icon Classes="error-mark" Data="{StaticResource IconAlertCircle}" Size="16" IsVisible="{Binding !ChosenFileOk}" />
                </Panel>
                <TextBlock x:Name="NetworkTrustFileCheck" Grid.Column="1" Text="{Binding ChosenFileText}" TextWrapping="Wrap" FontSize="13" />
              </Grid>
            </StackPanel>

            <Border Classes="ws-note warning" IsVisible="{Binding HasBlocker}">
              <TextBlock x:Name="NetworkTrustBlocker" Text="{Binding Blocker}" TextWrapping="Wrap" FontSize="13" />
            </Border>
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button x:Name="NetworkTrustEnable" Classes="md accent" Content="Enable" Command="{Binding EnableCommand}" IsEnabled="{Binding CanEnable}" />
              <Button Classes="md flat" Content="Cancel" Command="{Binding CancelCommand}" />
              <Button x:Name="NetworkTrustUseFile" Classes="md flat" Content="Use a certificate file instead…" Command="{Binding UseFileInsteadCommand}"
                      IsVisible="{Binding IsExplainingSystem}" />
              <Button Classes="md flat" Content="Use macOS certificates instead" Command="{Binding UseSystemInsteadCommand}">
                <Button.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsExplainingPem" />
                    <Binding Path="CanUseFileInstead" />
                  </MultiBinding>
                </Button.IsVisible>
              </Button>
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border x:Name="NetworkTrustMessage" Classes="ws-note" Classes.ok="{Binding !MessageIsError}" Classes.error="{Binding MessageIsError}" IsVisible="{Binding HasMessage}">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="13" />
            <TextBlock x:Name="NetworkTrustRestartNote" Classes="muted" Text="{Binding RestartNote}" TextWrapping="Wrap" FontSize="13" IsVisible="{Binding HasRestartNote}" />
          </StackPanel>
        </Border>

        <Border Classes="ws-sep" />

        <!-- Connection check: separate, says what it sends -->
        <StackPanel Spacing="2">
          <TextBlock Classes="ws-title" Text="Connection check" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Sends one request without a key, with the same runtime and settings as omp, and says whether HTTPS gets through." />
        </StackPanel>
        <ItemsControl x:Name="NetworkCheckTargets" ItemsSource="{Binding CheckTargets}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="8" LineSpacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ConnectionCheckTarget">
              <Button Classes="md" Content="{Binding Label}" CommandParameter="{Binding}"
                      Command="{Binding $parent[ItemsControl].((vm:NetworkTrustViewModel)DataContext).RunCheckCommand}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasCheckResult}">
          <Panel Margin="0,1,8,0" VerticalAlignment="Top">
            <ctl:Icon Classes="ok-mark" Data="{StaticResource IconCheckCircle}" Size="16" IsVisible="{Binding CheckIsOk}" />
            <ctl:Icon Classes="error-mark" Data="{StaticResource IconAlertCircle}" Size="16">
              <ctl:Icon.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="!CheckIsOk" />
                  <Binding Path="!IsChecking" />
                </MultiBinding>
              </ctl:Icon.IsVisible>
            </ctl:Icon>
          </Panel>
          <SelectableTextBlock x:Name="NetworkCheckResult" Grid.Column="1" Text="{Binding CheckResult}" TextWrapping="Wrap" FontSize="13" />
        </Grid>
      </StackPanel>
    </Border>
  </Panel>
</UserControl>
