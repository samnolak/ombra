<!-- Settings → Model providers, "Local and custom": model servers on this computer (Ollama, LM Studio, llama.cpp, vLLM)
     and providers of the user's own, both kept in omp's models.yml (CustomProvidersViewModel). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmpGui.App.ViewModels"
             xmlns:ctl="using:OmpGui.App.Controls"
             x:Class="OmpGui.App.Views.Settings.CustomProvidersSettings"
             x:DataType="vm:MainViewModel">
  <Border x:Name="CustomProvidersCard" Classes="section-card" DataContext="{Binding CustomProviders}" x:DataType="vm:CustomProvidersViewModel">
    <StackPanel Spacing="12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="section" Text="Local and custom" VerticalAlignment="Center" />
        <Button Grid.Column="1" x:Name="AddCustomProviderButton" Content="Add custom provider…" Command="{Binding BeginAddCommand}"
                IsVisible="{Binding !IsFormOpen}" IsEnabled="{Binding CanChange}" />
      </Grid>
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Model servers on this computer and providers of your own. omp reads them from its models.yml when it starts: after each change here, omp restarts and its models appear in the model picker." />

      <Border x:Name="CustomProvidersMessageBar" Classes="ws-note" Classes.ok="{Binding !MessageIsError}" Classes.error="{Binding MessageIsError}" IsVisible="{Binding HasMessage}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Panel Margin="0,0,10,0" VerticalAlignment="Top">
            <ctl:Icon Classes="ok-mark" Data="{StaticResource IconCheckCircle}" Size="16" IsVisible="{Binding !MessageIsError}" />
            <ctl:Icon Classes="error-mark" Data="{StaticResource IconAlertCircle}" Size="16" IsVisible="{Binding MessageIsError}" />
          </Panel>
          <SelectableTextBlock x:Name="CustomProvidersMessage" Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="icon" Width="24" Height="24" Margin="8,-4,-6,-4" VerticalAlignment="Top" Command="{Binding DismissMessageCommand}"
                  ToolTip.Tip="Dismiss" AutomationProperties.Name="Dismiss">
            <ctl:Icon Data="{StaticResource IconClose}" Size="14" />
          </Button>
        </Grid>
      </Border>
      <Border Classes="ws-note error" IsVisible="{Binding HasLoadError}">
        <SelectableTextBlock x:Name="CustomProvidersLoadError" Text="{Binding LoadError}" TextWrapping="Wrap" FontSize="13" />
      </Border>

      <!-- Add or edit a custom provider: name (→ provider id), address, protocol, key, models -->
      <Border x:Name="CustomProviderForm" Classes="ws-form" IsVisible="{Binding IsFormOpen}">
        <StackPanel Spacing="10">
          <TextBlock Classes="ws-title" Text="{Binding FormTitle}" />
          <StackPanel Spacing="4" IsVisible="{Binding IsNew}">
            <TextBlock Classes="label" Text="Name" />
            <TextBox x:Name="CustomProviderNameBox" Classes="sm" Text="{Binding FormName}" PlaceholderText="My server" AutomationProperties.Name="Provider name" />
            <TextBlock Classes="tertiary" Text="{Binding FormIdNote}" IsVisible="{Binding FormIdNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="Address (base URL)" />
            <TextBox x:Name="CustomProviderUrlBox" Classes="sm" Text="{Binding FormBaseUrl}" PlaceholderText="{Binding BaseUrlHint}" AutomationProperties.Name="Base URL" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="Speaks" />
            <Border Classes="segmented" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button x:Name="CustomProviderApiChat" Classes="segment" Classes.selected="{Binding FormApiIsChat}" Content="OpenAI Chat Completions"
                        Command="{Binding SetApiCommand}" CommandParameter="openai-completions" AutomationProperties.Name="OpenAI-compatible Chat Completions" />
                <Button x:Name="CustomProviderApiResponses" Classes="segment" Classes.selected="{Binding FormApiIsResponses}" Content="OpenAI Responses"
                        Command="{Binding SetApiCommand}" CommandParameter="openai-responses" AutomationProperties.Name="OpenAI Responses" />
                <Button x:Name="CustomProviderApiAnthropic" Classes="segment" Classes.selected="{Binding FormApiIsAnthropic}" Content="Anthropic Messages"
                        Command="{Binding SetApiCommand}" CommandParameter="anthropic-messages" AutomationProperties.Name="Anthropic Messages" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="API key (optional)" />
            <TextBox x:Name="CustomProviderKeyBox" Classes="sm" Text="{Binding FormApiKey}" PasswordChar="•" PlaceholderText="sk-…, or the name of an environment variable that holds it"
                     AutomationProperties.Name="API key" />
            <TextBlock Classes="tertiary" TextWrapping="Wrap" Text="Saved in omp's models.yml, which only your user can read. Leave it empty for a server that needs no key." />
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="Models" />
            <Border Classes="segmented" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button x:Name="CustomProviderDiscover" Classes="segment" Classes.selected="{Binding FormDiscover}" Content="Discover from the server"
                        Command="{Binding SetDiscoverCommand}" CommandParameter="true" AutomationProperties.Name="Discover models from the server" />
                <Button x:Name="CustomProviderListModels" Classes="segment" Classes.selected="{Binding FormListsModels}" Content="List them"
                        Command="{Binding SetDiscoverCommand}" CommandParameter="false" AutomationProperties.Name="List the models" />
              </StackPanel>
            </Border>
            <TextBlock Classes="tertiary" TextWrapping="Wrap" IsVisible="{Binding FormDiscover}"
                       Text="omp asks the server for its models each time it starts." />
            <TextBox x:Name="CustomProviderModelsBox" Classes="sm" Text="{Binding FormModels}" IsVisible="{Binding FormListsModels}"
                     AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="72" MaxHeight="160" PlaceholderText="One model id per line"
                     AutomationProperties.Name="Model ids" />
          </StackPanel>
          <Border Classes="ws-note" Classes.ok="{Binding TestOk}" Classes.error="{Binding !TestOk}" IsVisible="{Binding HasTestResult}">
            <Grid ColumnDefinitions="Auto,*">
              <Panel Margin="0,0,10,0" VerticalAlignment="Top">
                <ctl:Icon Classes="ok-mark" Data="{StaticResource IconCheckCircle}" Size="16" IsVisible="{Binding TestOk}" />
                <ctl:Icon Classes="error-mark" Data="{StaticResource IconCrossCircle}" Size="16" IsVisible="{Binding !TestOk}" />
              </Panel>
              <SelectableTextBlock x:Name="CustomProviderTestResult" Grid.Column="1" Text="{Binding TestResult}" TextWrapping="Wrap" FontSize="13" />
            </Grid>
          </Border>
          <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasFormError}">
            <ctl:Icon Classes="error-mark" Data="{StaticResource IconAlertCircle}" Size="16" Margin="0,0,8,0" VerticalAlignment="Top" />
            <SelectableTextBlock x:Name="CustomProviderFormError" Grid.Column="1" Text="{Binding FormError}" TextWrapping="Wrap" FontSize="13" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="CustomProviderSave" Classes="accent" Content="Save" Command="{Binding SaveFormCommand}" IsEnabled="{Binding CanChange}" />
            <Button x:Name="CustomProviderTest" Content="Test connection" Command="{Binding TestCommand}" IsEnabled="{Binding !Testing}" />
            <Button Content="Cancel" Classes="flat" Command="{Binding CancelFormCommand}" />
            <TextBlock Classes="muted" Text="Connecting…" IsVisible="{Binding Testing}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- On this computer -->
      <TextBlock Classes="label" Text="On this computer" Margin="0,4,0,-6" />
      <ItemsControl x:Name="LocalServerList" ItemsSource="{Binding LocalServers}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LocalServerRowViewModel">
            <Border Classes="ws-row">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <ctl:Icon Data="{StaticResource IconServer}" Size="16" Margin="0,0.5,12,0" VerticalAlignment="Top" TextElement.Foreground="{DynamicResource GuiTextSecondary}" />
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="ws-title" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="tertiary" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Border Classes="status" Classes.done="{Binding IsRunning}" IsVisible="{Binding IsAdded}" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse />
                        <TextBlock Text="Added" />
                      </StackPanel>
                    </Border>
                    <Button Classes="icon" IsVisible="{Binding IsAdded}" Command="{Binding AskRemoveCommand}" VerticalAlignment="Center"
                            IsEnabled="{Binding $parent[ItemsControl].((vm:CustomProvidersViewModel)DataContext).CanChange}"
                            ToolTip.Tip="{Binding Name, StringFormat='Remove {0}…'}" AutomationProperties.Name="{Binding Name, StringFormat='Remove {0}'}">
                      <ctl:Icon Data="{StaticResource IconTrash}" Size="16" />
                    </Button>
                    <Button Content="Add" IsVisible="{Binding IsNotAdded}" Command="{Binding BeginAddCommand}" VerticalAlignment="Center"
                            IsEnabled="{Binding $parent[ItemsControl].((vm:CustomProvidersViewModel)DataContext).CanChange}"
                            AutomationProperties.Name="{Binding Name, StringFormat='Add {0}'}" />
                  </StackPanel>
                </Grid>
                <Border Classes="conn-inset" IsVisible="{Binding IsAddOpen}" Margin="28,0,0,0">
                  <StackPanel Spacing="8">
                    <TextBlock TextWrapping="Wrap" FontSize="13"
                               Text="{Binding Name, StringFormat='omp will use {0} at this address and ask it for its models each time it starts.'}" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBox Classes="sm" Text="{Binding Url}" AutomationProperties.Name="{Binding Name, StringFormat='Address of {0}'}" />
                      <Button Grid.Column="1" Content="Check" Margin="8,0,0,0" Command="{Binding CheckCommand}" IsEnabled="{Binding !Checking}"
                              AutomationProperties.Name="{Binding Name, StringFormat='Check {0}'}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="accent" Content="Add to omp" Command="{Binding ConfirmAddCommand}"
                              IsEnabled="{Binding $parent[ItemsControl].((vm:CustomProvidersViewModel)DataContext).CanChange}" />
                      <Button Classes="flat" Content="Cancel" Command="{Binding CancelAddCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Classes="ws-note warning" IsVisible="{Binding IsConfirmingRemove}" Margin="28,0,0,0">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding RemoveQuestion}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Button Classes="danger" Content="Remove" Command="{Binding ConfirmRemoveCommand}" AutomationProperties.Name="{Binding Name, StringFormat='Confirm removing {0}'}" />
                      <Button Content="Cancel" Classes="flat" Command="{Binding CancelRemoveCommand}" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Classes="ws-note error" IsVisible="{Binding HasProblem}" Margin="28,0,0,0">
                  <SelectableTextBlock Text="{Binding Problem}" TextWrapping="Wrap" FontSize="13" />
                </Border>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Providers of the user's own -->
      <TextBlock Classes="label" Text="Your providers" Margin="0,4,0,-6" IsVisible="{Binding HasCustomProviders}" />
      <ItemsControl x:Name="CustomProviderList" ItemsSource="{Binding CustomProviders}" IsVisible="{Binding HasCustomProviders}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CustomProviderRowViewModel">
            <Border Classes="ws-row">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <ctl:Icon Data="{StaticResource IconGlobe}" Size="16" Margin="0,0.5,12,0" VerticalAlignment="Top" TextElement.Foreground="{DynamicResource GuiTextSecondary}" />
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="ws-title" Text="{Binding Id}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="tertiary" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button Classes="icon" IsVisible="{Binding IsEditable}" Command="{Binding EditCommand}"
                            IsEnabled="{Binding $parent[ItemsControl].((vm:CustomProvidersViewModel)DataContext).CanChange}"
                            ToolTip.Tip="{Binding Id, StringFormat='Edit {0}'}" AutomationProperties.Name="{Binding Id, StringFormat='Edit {0}'}">
                      <ctl:Icon Data="{StaticResource IconPencil}" Size="16" />
                    </Button>
                    <Button Classes="icon" Command="{Binding AskRemoveCommand}"
                            IsEnabled="{Binding $parent[ItemsControl].((vm:CustomProvidersViewModel)DataContext).CanChange}"
                            ToolTip.Tip="{Binding Id, StringFormat='Remove {0}…'}" AutomationProperties.Name="{Binding Id, StringFormat='Remove {0}'}">
                      <ctl:Icon Data="{StaticResource IconTrash}" Size="16" />
                    </Button>
                  </StackPanel>
                </Grid>
                <TextBlock Classes="tertiary" Text="{Binding ReadOnlyNote}" TextWrapping="Wrap" IsVisible="{Binding !IsEditable}" Margin="28,0,0,0" />
                <Border Classes="ws-note warning" IsVisible="{Binding IsConfirmingRemove}" Margin="28,0,0,0">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding RemoveQuestion}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Button Classes="danger" Content="Remove" Command="{Binding ConfirmRemoveCommand}" AutomationProperties.Name="{Binding Id, StringFormat='Confirm removing {0}'}" />
                      <Button Content="Cancel" Classes="flat" Command="{Binding CancelRemoveCommand}" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Classes="ws-note error" IsVisible="{Binding HasProblem}" Margin="28,0,0,0">
                  <SelectableTextBlock Text="{Binding Problem}" TextWrapping="Wrap" FontSize="13" />
                </Border>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Classes="ws-sep" IsVisible="{Binding FileLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock x:Name="CustomProvidersFile" Classes="tertiary" Text="{Binding FileLabel}" TextWrapping="Wrap"
                 IsVisible="{Binding FileLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </Border>
</UserControl>
