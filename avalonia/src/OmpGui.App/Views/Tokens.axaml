  </ResourceDictionary.ThemeDictionaries>
  <!-- A focused field keeps its 1 px border (only the colour changes): 2 px had shifted its text by a pixel -->
  <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>

  <!-- radius -->
  <CornerRadius x:Key="GuiRadius4">4</CornerRadius>
  <CornerRadius x:Key="GuiRadius8">8</CornerRadius>
  <CornerRadius x:Key="GuiRadius12">12</CornerRadius>
  <CornerRadius x:Key="GuiRadius16">16</CornerRadius>
  <CornerRadius x:Key="GuiRadius24">24</CornerRadius>
  <CornerRadius x:Key="GuiRadiusFull">999</CornerRadius>
  <!-- Fluent's own corner radii follow the small / overlay radii above -->
  <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
  <!-- type scale, in Inter -->
  <x:Double x:Key="GuiFontL">17</x:Double>
  <x:Double x:Key="GuiFontM">15</x:Double>
  <x:Double x:Key="GuiFontS">13</x:Double>
  <x:Double x:Key="GuiFontXs">11</x:Double>
  <x:Double x:Key="GuiFontXl">20</x:Double>
  <x:Double x:Key="GuiFontXxl">24</x:Double>
  <x:Double x:Key="ControlContentThemeFontSize">14</x:Double>
</ResourceDictionary>
