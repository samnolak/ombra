<!-- The client's design tokens: colours per theme, radius, type scale, shadows (docs/design/DESIGN_SYSTEM.md). The palette
     is Claude's classic warm one: ivory / charcoal surfaces, ink text, one clay accent; blue only for links and the
     keyboard focus ring. A new colour goes into both theme dictionaries, Light and Dark. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <!-- the client's tokens -->
          <SolidColorBrush x:Key="GuiTextPrimary" Color="#FF141413" />
          <SolidColorBrush x:Key="GuiTextSecondary" Color="#FF3D3D3A" />
          <SolidColorBrush x:Key="GuiTextTertiary" Color="#FF6B6A64" />
          <SolidColorBrush x:Key="GuiTextLink" Color="#FF1B67B2" />
          <SolidColorBrush x:Key="GuiTextLinkHover" Color="#FF15528E" />
          <SolidColorBrush x:Key="GuiTextError" Color="#FFB53333" />
          <SolidColorBrush x:Key="GuiTextSuccess" Color="#FF2F7613" />
          <SolidColorBrush x:Key="GuiTextWarning" Color="#FF875A08" />
          <SolidColorBrush x:Key="GuiTextOnAccent" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="GuiTextOnInverse" Color="#FFFAF9F5" />
          <SolidColorBrush x:Key="GuiWindow" Color="#FFFAF9F5" />
          <SolidColorBrush x:Key="GuiPage" Color="#FFF5F4ED" />
          <SolidColorBrush x:Key="GuiSurface1" Color="#FFFFFFFF" />
          <!-- The chosen segment of a segmented control: raised off its fill track -->
          <SolidColorBrush x:Key="GuiSegmentSelected" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="GuiSurface2" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="GuiFill1" Color="#0D141413" />
          <SolidColorBrush x:Key="GuiFill1Hover" Color="#14141413" />
          <SolidColorBrush x:Key="GuiFill1Pressed" Color="#1C141413" />
          <SolidColorBrush x:Key="GuiFill1OnWindow" Color="#FFF0EEE6" />
          <SolidColorBrush x:Key="GuiFill1OnSurface1" Color="#FFF5F4ED" />
          <SolidColorBrush x:Key="GuiFill2" Color="#1A141413" />
          <SolidColorBrush x:Key="GuiFill2Hover" Color="#24141413" />
          <SolidColorBrush x:Key="GuiFill3" Color="#33141413" />
          <SolidColorBrush x:Key="GuiAccent" Color="#FFC6613F" />
          <SolidColorBrush x:Key="GuiAccentHover" Color="#FFD97757" />
          <SolidColorBrush x:Key="GuiAccentPressed" Color="#FFB1532F" />
          <SolidColorBrush x:Key="GuiInverse" Color="#FF141413" />
          <SolidColorBrush x:Key="GuiInverseHover" Color="#FF3D3D3A" />
          <SolidColorBrush x:Key="GuiInversePressed" Color="#FF5E5D59" />
          <SolidColorBrush x:Key="GuiBorder" Color="#33141413" />
          <SolidColorBrush x:Key="GuiBorderSoft" Color="#1A141413" />
          <SolidColorBrush x:Key="GuiBorderStrong" Color="#66141413" />
          <SolidColorBrush x:Key="GuiBorderHover" Color="#4D141413" />
          <SolidColorBrush x:Key="GuiBorderFocus" Color="#8C141413" />
          <SolidColorBrush x:Key="GuiBorderDarkOnly" Color="#00FFFFFF" />
          <SolidColorBrush x:Key="GuiStatusInfo" Color="#FF2C84DB" />
          <SolidColorBrush x:Key="GuiStatusInfoSoft" Color="#FFDDEBF9" />
          <SolidColorBrush x:Key="GuiStatusSuccess" Color="#FF3F8A1F" />
          <SolidColorBrush x:Key="GuiStatusSuccessSoft" Color="#FFE7F1DA" />
          <SolidColorBrush x:Key="GuiStatusError" Color="#FFC0392F" />
          <SolidColorBrush x:Key="GuiStatusErrorSoft" Color="#FFF9ECEC" />
          <SolidColorBrush x:Key="GuiStatusWarning" Color="#FFB77700" />
          <SolidColorBrush x:Key="GuiStatusWarningSoft" Color="#FFF8EEDD" />
          <SolidColorBrush x:Key="GuiStatusNeutral" Color="#FF6B6A64" />
          <SolidColorBrush x:Key="GuiStatusNeutralSoft" Color="#1A141413" />
          <SolidColorBrush x:Key="GuiSelection" Color="#FFC9DEF7" />
          <SolidColorBrush x:Key="GuiTooltip" Color="#FF141413" />
          <SolidColorBrush x:Key="GuiProgressTrack" Color="#1A141413" />
          <SolidColorBrush x:Key="GuiBackdrop" Color="#33141413" />
          <SolidColorBrush x:Key="GuiSidebar" Color="#FFF5F4ED" />
          <!-- Claude Code roles: brand mark (logo, spinner, unread), keyboard focus, permission modes, diff rows, session dots -->
          <SolidColorBrush x:Key="GuiBrandMark" Color="#FFD97757" />
          <SolidColorBrush x:Key="GuiFocus" Color="#FF2A78D6" />
          <SolidColorBrush x:Key="GuiModeManual" Color="#FF6B6A64" />
          <SolidColorBrush x:Key="GuiModeAcceptEdits" Color="#FF8700FF" />
          <SolidColorBrush x:Key="GuiModePlan" Color="#FF006666" />
          <SolidColorBrush x:Key="GuiModeBypass" Color="#FFAB2B3F" />
          <SolidColorBrush x:Key="GuiDiffAddedBg" Color="#2E1E9E3C" />
          <SolidColorBrush x:Key="GuiDiffAddedText" Color="#FF17692D" />
          <SolidColorBrush x:Key="GuiDiffRemovedBg" Color="#29CD2054" />
          <SolidColorBrush x:Key="GuiDiffRemovedText" Color="#FFB42346" />
          <SolidColorBrush x:Key="GuiStatusRunning" Color="#FF2C7A39" />
          <SolidColorBrush x:Key="GuiStatusWaiting" Color="#FF2C84DB" />
          <SolidColorBrush x:Key="GuiStatusUnread" Color="#FFD97757" />
          <SolidColorBrush x:Key="GuiInlineCodeBg" Color="#14141413" />
          <SolidColorBrush x:Key="GuiCodeBlockBg" Color="#FFF0EEE6" />
          <!-- Code (Controls/SyntaxHighlighter): quiet colours that keep the text readable on pale diff fills -->
          <SolidColorBrush x:Key="GuiCodeKeyword" Color="#FF8A2BB5" />
          <SolidColorBrush x:Key="GuiCodeString" Color="#FF1F7A3A" />
          <SolidColorBrush x:Key="GuiCodeComment" Color="#FF6B6A64" />
          <SolidColorBrush x:Key="GuiCodeNumber" Color="#FFA6501A" />
          <SolidColorBrush x:Key="GuiCodeType" Color="#FF1D5FC2" />
          <SolidColorBrush x:Key="GuiCodeFunction" Color="#FF9A3412" />
          <!-- diff row fills used by the transcript styles -->
          <SolidColorBrush x:Key="DiffAddedBackgroundBrush" Color="#2E1E9E3C" />
          <SolidColorBrush x:Key="DiffRemovedBackgroundBrush" Color="#29CD2054" />
          <!-- Fluent theme keys -->
          <SolidColorBrush x:Key="TextControlForeground" Color="#FF141413" />
          <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FF141413" />
          <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FF141413" />
          <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#FF6B6A64" />
          <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#0D141413" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#33141413" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#4D141413" />
          <!-- A focused field: a 1 px border in the focus blue; the keyboard ring is GuiFocusRing -->
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FF2A78D6" />
          <BoxShadows x:Key="GuiFocusRing">inset 0 0 0 2 #FF2A78D6</BoxShadows>
          <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#1A141413" />
          <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF6B6A64" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF6B6A64" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF6B6A64" />
          <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#FFC9DEF7" />
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#0D141413" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#14141413" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#1C141413" />
          <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#0D141413" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#00000000" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#00000000" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#00000000" />
          <SolidColorBrush x:Key="ComboBoxForeground" Color="#FF141413" />
          <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="#FF6B6A64" />
          <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#FF3D3D3A" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#1A141413" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#0D141413" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#1A141413" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#24141413" />
          <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#1A141413" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#1A141413" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#0D141413" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#1C141413" />
          <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#FF141413" />
          <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#FF141413" />
          <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#FF141413" />
          <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="#FF6B6A64" />
          <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="#FF6B6A64" />
          <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" Color="#FF6B6A64" />
          <SolidColorBrush x:Key="MenuFlyoutSubItemChevron" Color="#FF3D3D3A" />
          <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="#1A141413" />
          <!-- Tooltips are inverse: ink in light, ivory in dark -->
          <SolidColorBrush x:Key="ToolTipBackground" Color="#FF141413" />
          <SolidColorBrush x:Key="ToolTipForeground" Color="#FFFAF9F5" />
          <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#00000000" />
          <!-- Check boxes and radios: the clay accent with a white mark -->
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#FFC6613F" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#FFD97757" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#FFB1532F" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#FFC6613F" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#FFD97757" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#FFB1532F" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#66141413" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#8C141413" />
          <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#FFC6613F" />
          <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#FFC6613F" />
          <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="#FFD97757" />
          <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#FFD97757" />
          <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="#FFB1532F" />
          <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="#FFB1532F" />
          <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="RadioButtonOuterEllipseStroke" Color="#66141413" />
          <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokePointerOver" Color="#8C141413" />
          <!-- Switches (Fluent ToggleSwitch): an outlined track when off, the accent with a white knob when on -->
          <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FFC6613F" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FFD97757" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FFB1532F" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FFC6613F" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FFD97757" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#1A141413" />
          <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#24141413" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#66141413" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#8C141413" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FF3D3D3A" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FF141413" />
          <SolidColorBrush x:Key="ProgressBarForeground" Color="#FFC6613F" />
          <SolidColorBrush x:Key="ProgressBarBackground" Color="#1A141413" />
          <!-- Scroll bars stay thin and quiet: a soft thumb that firms up under the pointer -->
          <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#33141413" />
          <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#66141413" />
          <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#8C141413" />
          <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#33141413" />
          <SolidColorBrush x:Key="ListBoxItemBackgroundPointerOver" Color="#00000000" />
          <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="#00000000" />
          <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="#00000000" />
          <SolidColorBrush x:Key="ListBoxItemBackgroundPressed" Color="#00000000" />
          <!-- Buttons: secondary = fill 1 on the ink; primary (accent) = clay with white text -->
          <SolidColorBrush x:Key="ButtonBackground" Color="#0D141413" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14141413" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1C141413" />
          <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#0D141413" />
          <SolidColorBrush x:Key="ButtonForeground" Color="#FF141413" />
          <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FF141413" />
          <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FF141413" />
          <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#FF6B6A64" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#00000000" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#00000000" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#00000000" />
          <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#00000000" />
          <SolidColorBrush x:Key="AccentButtonBackground" Color="#FFC6613F" />
          <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FFD97757" />
          <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FFB1532F" />
          <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#FFC6613F" />
          <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#00000000" />
          <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#00000000" />
          <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#00000000" />
          <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="#00000000" />
          <SolidColorBrush x:Key="ToggleButtonBackground" Color="#0D141413" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#14141413" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#1C141413" />
          <SolidColorBrush x:Key="ToggleButtonForeground" Color="#FF141413" />
          <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#FF141413" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#00000000" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#00000000" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#00000000" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#00000000" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#00000000" />
          <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#FF2A78D6" />
          <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#00000000" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#1A141413" />
          <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FF141413" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#24141413" />
          <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FF141413" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#1A141413" />
          <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FF141413" />
          <Color x:Key="SystemAccentColor">#FFC6613F</Color>
          <Color x:Key="SystemAccentColorLight1">#FFC6613F</Color>
          <Color x:Key="SystemAccentColorLight2">#FFC6613F</Color>
          <Color x:Key="SystemAccentColorLight3">#FFC6613F</Color>
          <Color x:Key="SystemAccentColorDark1">#FFC6613F</Color>
          <Color x:Key="SystemAccentColorDark2">#FFC6613F</Color>
          <Color x:Key="SystemAccentColorDark3">#FFC6613F</Color>
          <BoxShadows x:Key="GuiShadow">0 1 2 0 #0A000000, 0 4 14 0 #0F000000</BoxShadows>
          <BoxShadows x:Key="GuiShadowPopup">0 2 6 0 #0F000000, 0 10 32 0 #1F000000</BoxShadows>
        </ResourceDictionary>
