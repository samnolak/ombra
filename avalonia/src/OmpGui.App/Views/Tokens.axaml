          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#2EFAF9F5" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#47FAF9F5" />
          <!-- A focused field: a 1 px border in the focus blue; the keyboard ring is GuiFocusRing -->
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FF4C8FE0" />
          <BoxShadows x:Key="GuiFocusRing">inset 0 0 0 2 #FF4C8FE0</BoxShadows>
          <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#1AFAF9F5" />
          <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF9C9A92" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF9C9A92" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF9C9A92" />
          <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#FF2A4A6E" />
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#0FFAF9F5" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#17FAF9F5" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#1FFAF9F5" />
          <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#0FFAF9F5" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#00000000" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#00000000" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#00000000" />
          <SolidColorBrush x:Key="ComboBoxForeground" Color="#FFFAF9F5" />
          <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="#FF9C9A92" />
          <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#FFC2C0B6" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FF30302E" />
          <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#1AFAF9F5" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#0FFAF9F5" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#1FFAF9F5" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#29FAF9F5" />
          <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FF30302E" />
          <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#1AFAF9F5" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FF30302E" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#1AFAF9F5" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#0FFAF9F5" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#1FFAF9F5" />
          <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#FFFAF9F5" />
          <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#FFFAF9F5" />
          <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#FFFAF9F5" />
          <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="#FF9C9A92" />
          <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="#FF9C9A92" />
          <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" Color="#FF9C9A92" />
          <SolidColorBrush x:Key="MenuFlyoutSubItemChevron" Color="#FFC2C0B6" />
          <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="#1AFAF9F5" />
          <!-- Tooltips are inverse: ink in light, ivory in dark -->
          <SolidColorBrush x:Key="ToolTipBackground" Color="#FFFAF9F5" />
          <SolidColorBrush x:Key="ToolTipForeground" Color="#FF141413" />
          <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#00000000" />
          <!-- Check boxes and radios: the clay accent with a white mark -->
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#FFC6613F" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#FFD97757" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#FFB1532F" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#FFC6613F" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#FFD97757" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#FFB1532F" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#66FAF9F5" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#A6FAF9F5" />
          <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#FFC6613F" />
          <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#FFC6613F" />
          <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="#FFD97757" />
          <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#FFD97757" />
          <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="#FFB1532F" />
          <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="#FFB1532F" />
          <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="RadioButtonOuterEllipseStroke" Color="#66FAF9F5" />
          <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokePointerOver" Color="#A6FAF9F5" />
          <!-- Switches (Fluent ToggleSwitch): an outlined track when off, the accent with a white knob when on -->
          <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FFC6613F" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FFD97757" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FFB1532F" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FFC6613F" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FFD97757" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#1FFAF9F5" />
          <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#29FAF9F5" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#66FAF9F5" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#A6FAF9F5" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFC2C0B6" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FFFAF9F5" />
          <SolidColorBrush x:Key="ProgressBarForeground" Color="#FFC6613F" />
          <SolidColorBrush x:Key="ProgressBarBackground" Color="#1FFAF9F5" />
          <!-- Scroll bars stay thin and quiet: a soft thumb that firms up under the pointer -->
          <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#2EFAF9F5" />
          <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#66FAF9F5" />
          <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#A6FAF9F5" />
          <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#2EFAF9F5" />
          <SolidColorBrush x:Key="ListBoxItemBackgroundPointerOver" Color="#00000000" />
          <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="#00000000" />
          <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="#00000000" />
          <SolidColorBrush x:Key="ListBoxItemBackgroundPressed" Color="#00000000" />
          <!-- Buttons: secondary = fill 1 on the ink; primary (accent) = clay with white text -->
          <SolidColorBrush x:Key="ButtonBackground" Color="#0FFAF9F5" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#17FAF9F5" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1FFAF9F5" />
          <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#0FFAF9F5" />
          <SolidColorBrush x:Key="ButtonForeground" Color="#FFFAF9F5" />
          <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFAF9F5" />
          <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFAF9F5" />
          <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#FF9C9A92" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#00000000" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#00000000" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#00000000" />
          <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#00000000" />
          <SolidColorBrush x:Key="AccentButtonBackground" Color="#FFC6613F" />
          <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FFD97757" />
          <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FFB1532F" />
          <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#FFC6613F" />
          <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#00000000" />
          <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#00000000" />
          <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#00000000" />
          <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="#00000000" />
          <SolidColorBrush x:Key="ToggleButtonBackground" Color="#0FFAF9F5" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#17FAF9F5" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#1FFAF9F5" />
          <SolidColorBrush x:Key="ToggleButtonForeground" Color="#FFFAF9F5" />
          <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#FFFAF9F5" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#00000000" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#00000000" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#00000000" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#00000000" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#00000000" />
          <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#FF4C8FE0" />
          <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#00000000" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#1FFAF9F5" />
          <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFAF9F5" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#29FAF9F5" />
          <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFAF9F5" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#1FFAF9F5" />
          <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FFFAF9F5" />
          <Color x:Key="SystemAccentColor">#FFC6613F</Color>
          <Color x:Key="SystemAccentColorLight1">#FFC6613F</Color>
          <Color x:Key="SystemAccentColorLight2">#FFC6613F</Color>
          <Color x:Key="SystemAccentColorLight3">#FFC6613F</Color>
          <Color x:Key="SystemAccentColorDark1">#FFC6613F</Color>
          <Color x:Key="SystemAccentColorDark2">#FFC6613F</Color>
          <Color x:Key="SystemAccentColorDark3">#FFC6613F</Color>
          <BoxShadows x:Key="GuiShadow">0 0 0 0 #00000000</BoxShadows>
          <BoxShadows x:Key="GuiShadowPopup">0 10 32 0 #66000000</BoxShadows>
        </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <!-- A focused field keeps its 1 px border (only the colour changes): 2 px had shifted its text by a pixel -->
  <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>

  <!-- radius: 8 controls, 12 cards / menus / bubbles, 16 the composer -->
  <CornerRadius x:Key="GuiRadius4">4</CornerRadius>
  <CornerRadius x:Key="GuiRadius8">8</CornerRadius>
  <CornerRadius x:Key="GuiRadius12">12</CornerRadius>
  <CornerRadius x:Key="GuiRadiusFull">999</CornerRadius>
  <CornerRadius x:Key="GuiRadiusControl">8</CornerRadius>
  <CornerRadius x:Key="GuiRadiusCard">12</CornerRadius>
  <CornerRadius x:Key="GuiRadiusComposer">16</CornerRadius>
  <!-- Fluent's own corner radii follow the control / overlay radii above -->
  <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
  <!-- type scale, in Inter: UI 14, messages 16 on 24, captions 12, code 13 -->
  <x:Double x:Key="GuiFontUi">14</x:Double>
  <x:Double x:Key="GuiFontMessage">16</x:Double>
  <x:Double x:Key="GuiLineMessage">24</x:Double>
  <x:Double x:Key="GuiFontCaption">12</x:Double>
  <x:Double x:Key="GuiFontCode">13</x:Double>
  <x:Double x:Key="GuiFontL">17</x:Double>
  <x:Double x:Key="GuiFontM">15</x:Double>
  <x:Double x:Key="GuiFontS">13</x:Double>
  <x:Double x:Key="GuiFontXs">12</x:Double>
  <x:Double x:Key="GuiFontXl">20</x:Double>
  <x:Double x:Key="GuiFontXxl">24</x:Double>
  <x:Double x:Key="ControlContentThemeFontSize">14</x:Double>
  <!-- code: the platform's mono first (SF Mono / Menlo on macOS: Cascadia and Consolas are not there) -->
  <FontFamily x:Key="GuiFontMono">SF Mono, Menlo, Cascadia Mono, Consolas, DejaVu Sans Mono, monospace</FontFamily>
</ResourceDictionary>
