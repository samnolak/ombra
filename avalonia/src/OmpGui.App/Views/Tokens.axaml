          <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#14244A7F" />
          <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#CC000000" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#1A244A7F" />
          <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#CC000000" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#14244A7F" />
          <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#CC000000" />
