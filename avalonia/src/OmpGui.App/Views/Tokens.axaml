          <SolidColorBrush x:Key="SidebarBrush" Color="#FFF6F7F8" />
          <SolidColorBrush x:Key="DiffAddedBrush" Color="#FF00A328" />
          <!-- Code (Controls/SyntaxHighlighter): quiet colours that keep the text readable on pale diff fills -->
          <SolidColorBrush x:Key="GuiCodeKeyword" Color="#FF8A2BB5" />
          <SolidColorBrush x:Key="GuiCodeString" Color="#FF1F7A3A" />
          <SolidColorBrush x:Key="GuiCodeComment" Color="#FF7A8290" />
          <SolidColorBrush x:Key="GuiCodeNumber" Color="#FFB45309" />
          <SolidColorBrush x:Key="GuiCodeType" Color="#FF1D5FC2" />
          <SolidColorBrush x:Key="GuiCodeFunction" Color="#FF9A3412" />
          <SolidColorBrush x:Key="DiffAddedBackgroundBrush" Color="#2900B92D" />
          <SolidColorBrush x:Key="DiffRemovedBrush" Color="#FFF52222" />
          <SolidColorBrush x:Key="DiffRemovedBackgroundBrush" Color="#24F52222" />
          <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#FFF6F7F8" />
          <SolidColorBrush x:Key="SelectedItemBrush" Color="#14244A7F" />
          <SolidColorBrush x:Key="HoverItemBrush" Color="#0F244A7F" />
          <SolidColorBrush x:Key="ApprovalBorderBrush" Color="#3DFFDD2D" />
          <SolidColorBrush x:Key="ApprovalBackgroundBrush" Color="#3DFFDD2D" />
          <SolidColorBrush x:Key="DetailsBackgroundBrush" Color="#0F244A7F" />
          <!-- Fluent theme keys -->
          <SolidColorBrush x:Key="TextControlForeground" Color="#CC000000" />
          <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#CC000000" />
          <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#CC000000" />
          <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#66000000" />
          <SolidColorBrush x:Key="TextControlBackground" Color="#FFF6F7F8" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFF6F7F8" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#0F244A7F" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#00000000" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#38001024" />
          <!-- A focused field: the action blue at 1 px (Fluent's 2 px black read as heavy); the keyboard ring is GuiFocusRing -->
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FF428BF9" />
          <BoxShadows x:Key="GuiFocusRing">inset 0 0 0 2 #CC428BF9</BoxShadows>
          <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#00000000" />
          <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#8A000000" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#8A000000" />
