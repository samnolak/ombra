<!-- The client's design tokens: colours per theme, radius, type scale, shadows (docs/design/DESIGN_SYSTEM.md). A new colour
     goes into both theme dictionaries, Light and Dark. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <!-- the client's tokens -->
          <SolidColorBrush x:Key="GuiTextPrimary" Color="#CC000000" />
          <SolidColorBrush x:Key="GuiTextSecondary" Color="#8A000000" />
          <SolidColorBrush x:Key="GuiTextTertiary" Color="#66000000" />
          <SolidColorBrush x:Key="GuiTextLink" Color="#FF126DF7" />
          <SolidColorBrush x:Key="GuiTextLinkHover" Color="#FF165ECA" />
          <SolidColorBrush x:Key="GuiTextError" Color="#FFF52222" />
          <SolidColorBrush x:Key="GuiTextSuccess" Color="#FF00A328" />
          <SolidColorBrush x:Key="GuiTextWarning" Color="#FFEF8007" />
          <SolidColorBrush x:Key="GuiTextOnAccent" Color="#FF333333" />
          <SolidColorBrush x:Key="GuiTextOnBlue" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="GuiTextOnInverse" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="GuiWindow" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="GuiPage" Color="#FFF6F7F8" />
          <SolidColorBrush x:Key="GuiSurface1" Color="#FFFFFFFF" />
          <!-- The chosen segment of a segmented control: raised off its fill track -->
          <SolidColorBrush x:Key="GuiSegmentSelected" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="GuiSurface2" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="GuiFill1" Color="#0F244A7F" />
          <SolidColorBrush x:Key="GuiFill1Hover" Color="#17244A7F" />
          <SolidColorBrush x:Key="GuiFill1Pressed" Color="#1C244A7F" />
          <SolidColorBrush x:Key="GuiFill1OnWindow" Color="#FFF6F7F8" />
          <SolidColorBrush x:Key="GuiFill1OnSurface1" Color="#FFF6F7F8" />
          <SolidColorBrush x:Key="GuiFill2" Color="#14244A7F" />
          <SolidColorBrush x:Key="GuiFill2Hover" Color="#1A244A7F" />
          <SolidColorBrush x:Key="GuiFill3" Color="#1F001024" />
          <SolidColorBrush x:Key="GuiAccent" Color="#FFFFDD2D" />
          <SolidColorBrush x:Key="GuiAccentHover" Color="#FFFFCD33" />
          <SolidColorBrush x:Key="GuiAccentPressed" Color="#FFFAB619" />
          <SolidColorBrush x:Key="GuiBlue" Color="#FF428BF9" />
          <SolidColorBrush x:Key="GuiBlueHover" Color="#FF126DF7" />
          <SolidColorBrush x:Key="GuiBluePressed" Color="#FF156ED4" />
          <SolidColorBrush x:Key="GuiInverse" Color="#FF000000" />
          <SolidColorBrush x:Key="GuiInverseHover" Color="#FF2C2C2E" />
          <SolidColorBrush x:Key="GuiInversePressed" Color="#FF575B61" />
          <SolidColorBrush x:Key="GuiBorder" Color="#1F001024" />
          <SolidColorBrush x:Key="GuiBorderSoft" Color="#12001024" />
          <SolidColorBrush x:Key="GuiBorderStrong" Color="#52001024" />
          <SolidColorBrush x:Key="GuiBorderHover" Color="#38001024" />
          <SolidColorBrush x:Key="GuiBorderFocus" Color="#70001024" />
          <SolidColorBrush x:Key="GuiBorderDarkOnly" Color="#00FFFFFF" />
          <SolidColorBrush x:Key="GuiStatusInfo" Color="#FF428BF9" />
          <SolidColorBrush x:Key="GuiStatusInfoSoft" Color="#29428BF9" />
          <SolidColorBrush x:Key="GuiStatusSuccess" Color="#FF00B92D" />
          <SolidColorBrush x:Key="GuiStatusSuccessSoft" Color="#2900B92D" />
          <SolidColorBrush x:Key="GuiStatusError" Color="#FFF52222" />
          <SolidColorBrush x:Key="GuiStatusErrorSoft" Color="#24F52222" />
          <SolidColorBrush x:Key="GuiStatusWarning" Color="#FFFAA805" />
          <SolidColorBrush x:Key="GuiStatusWarningSoft" Color="#3DFFDD2D" />
