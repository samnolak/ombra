          <SolidColorBrush x:Key="GuiTooltip" Color="#FF575B61" />
          <SolidColorBrush x:Key="GuiProgressTrack" Color="#0F001024" />
          <SolidColorBrush x:Key="GuiBackdrop" Color="#B2000000" />
          <SolidColorBrush x:Key="GuiSidebar" Color="#FFF6F7F8" />
          <!-- older client keys -->
          <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="UserBubbleBrush" Color="#0F244A7F" />
          <SolidColorBrush x:Key="ToolRowBrush" Color="#FFF6F7F8" />
          <SolidColorBrush x:Key="MutedTextBrush" Color="#8A000000" />
