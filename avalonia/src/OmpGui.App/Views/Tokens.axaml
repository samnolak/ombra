          <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#12001024" />
          <SolidColorBrush x:Key="ToolTipBackground" Color="#FF575B61" />
          <SolidColorBrush x:Key="ToolTipForeground" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#00000000" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#FFFFDD2D" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#FFFFCD33" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#FFFAB619" />
