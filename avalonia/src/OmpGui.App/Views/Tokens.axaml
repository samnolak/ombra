          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#17244A7F" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#1C244A7F" />
          <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#0F244A7F" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#00000000" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#00000000" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#00000000" />
          <SolidColorBrush x:Key="ComboBoxForeground" Color="#CC000000" />
          <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="#8A000000" />
