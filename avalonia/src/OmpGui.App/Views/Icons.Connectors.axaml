<!-- Line icons for the Connectors (MCP), Plugins and Skills settings, same rules as Icons.axaml (24-unit grid, stroked; Filled for solid shapes). -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- A package (npm or marketplace plugin): a box seen from above-front -->
  <StreamGeometry x:Key="IconPackage">M4 7.5 L12 3.5 L20 7.5 V16.5 L12 20.5 L4 16.5 Z M4 7.5 L12 11.5 L20 7.5 M12 11.5 V20.5 M8 5.5 L16 9.5</StreamGeometry>
  <!-- A marketplace: a shop front with an awning -->
  <StreamGeometry x:Key="IconStore">M4.5 9.5 L6 4.5 H18 L19.5 9.5 Z M4.5 9.5 A2.5 2.5 0 0 0 9.5 9.5 A2.5 2.5 0 0 0 14.5 9.5 A2.5 2.5 0 0 0 19.5 9.5 M5.5 11.5 V19.5 H18.5 V11.5 M10 19.5 V15.5 H14 V19.5</StreamGeometry>
  <!-- Remove / uninstall -->
  <StreamGeometry x:Key="IconTrash">M4.5 6.5 H19.5 M9.5 6.5 V4.5 H14.5 V6.5 M6.5 6.5 L7.5 19.5 H16.5 L17.5 6.5 M10.5 10.5 V15.5 M13.5 10.5 V15.5</StreamGeometry>
  <!-- Edit: a pencil -->
  <StreamGeometry x:Key="IconPencil">M4.5 19.5 L5.5 15.5 L15.5 5.5 A1.414 1.414 0 0 1 17.5 5.5 L18.5 6.5 A1.414 1.414 0 0 1 18.5 8.5 L8.5 18.5 Z M13.5 7.5 L16.5 10.5</StreamGeometry>
</ResourceDictionary>
