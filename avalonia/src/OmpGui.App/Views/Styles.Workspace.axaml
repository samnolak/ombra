<!-- Styles for the app shell (sidebar, header pane toggles, the settings page's navigation) and the Computer use, Git
     and worktrees and SSH settings, on the design system's tokens (Tokens.axaml), as in Styles.axaml. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:OmpGui.App.Controls"
        xmlns:panes="using:OmpGui.App.Views.Panes">

  <!-- ─────────────── Sidebar ─────────────── -->
  <Style Selector="TextBlock.sidebar-brand">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="Button.sidebar-action">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadiusControl}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.sidebar-action.current">
    <Setter Property="Background" Value="{DynamicResource GuiFill2}" />
  </Style>
  <Style Selector="Button.sidebar-action.current /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GuiFill2}" />
  </Style>
  <!-- The shortcut beside "New session" / "Settings": only while the row is hovered or focused, so the list stays calm -->
  <Style Selector="TextBlock.sidebar-shortcut">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Button.sidebar-action:pointerover TextBlock.sidebar-shortcut, Button.sidebar-action:focus-visible TextBlock.sidebar-shortcut">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- An update to install, or how the last one went: the sidebar's one tinted row -->
  <Style Selector="Button.sidebar-action.update">
    <Setter Property="Background" Value="{DynamicResource GuiStatusInfoSoft}" />
  </Style>
  <Style Selector="Button.sidebar-action.update ctl|Icon">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiStatusInfo}" />
  </Style>
  <Style Selector="ListBox.sessions">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.sessions ListBoxItem">
    <Setter Property="Padding" Value="8,1" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="ListBox.sessions ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.sessions ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TextBlock.sidebar-empty">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
  </Style>
  <!-- Group headings: a project (its "remove from sidebar" and "new session here" show on hover or focus), Pinned -->
  <Style Selector="Grid.group-header">
    <Setter Property="Height" Value="30" />
  </Style>
  <Style Selector="TextBlock.group-label">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontCaption}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
  </Style>
  <Style Selector="ctl|Icon.group-icon">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextSecondary}" />
  </Style>
  <Style Selector="Grid.group-header Button.group-action">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Grid.group-header:pointerover Button.group-action, Grid.group-header:focus-within Button.group-action">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- A session: the title takes the row; its age (or status dot) at the right gives way to pin and ⋯ on hover / focus -->
  <Style Selector="Button.session">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadiusControl}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <!-- The hover fill follows the row, not its button: pin and ⋯ sit over the button as its siblings, so moving onto them
       took the button's :pointerover (and the fill) away and back. Fill 1's hover step (8 % ink / 9 % ivory, as Claude's
       rows): fill 1 itself (5 / 6 %) was too faint to see which row the pointer is on. -->
  <Style Selector="Panel.session-row:pointerover Button.session /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GuiFill1Hover}" />
  </Style>
  <!-- The open session: the neutral fill -->
  <Style Selector="Button.session.current">
    <Setter Property="Background" Value="{DynamicResource GuiFill2}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.session.current /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GuiFill2}" />
  </Style>
  <Style Selector="TextBlock.session-age">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
  </Style>
  <!-- Not ":focus-within": a clicked pin or menu keeps focus, which left that row's actions showing next to the hovered
       row's. Shown on hover, to the keyboard (:focus-visible), and while the row's menu is open. -->
  <Style Selector="Panel.session-row Button.session-action">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="Panel.session-row:pointerover Button.session-action, Button.session-action:focus-visible, Button.session-action:flyout-open">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
  </Style>
  <Style Selector="Panel.session-meta">
    <Setter Property="MinWidth" Value="20" />
  </Style>
  <Style Selector="Panel.session-row">
    <Setter Property="ctl:SessionRowActions.Track" Value="True" />
  </Style>
  <!-- The meta keeps the actions' width while they show, so the title trims before them instead of running under; it
       hides whenever they show (hover, keyboard focus, open menu: the class follows the last two) -->
  <Style Selector="Panel.session-row:pointerover Panel.session-meta, Panel.session-row.actions-shown Panel.session-meta">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="MinWidth" Value="48" />
  </Style>
  <Style Selector="Button.session-action ctl|Icon">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextSecondary}" />
  </Style>
  <Style Selector="Button.session-action:pointerover ctl|Icon, Button.session-action.on ctl|Icon">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <Style Selector="Button.session-action.on">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- What omp is doing in a session: working (pulsing), needs your input, a reply you have not seen, stopped by an error -->
  <Style Selector="Ellipse.session-dot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{DynamicResource GuiStatusRunning}" />
  </Style>
  <!-- Pulses while omp works (ctl:Pulse, not a style animation: that would redraw the window every vsync) -->
  <Style Selector="Ellipse.session-dot.running">
    <Setter Property="ctl:Pulse.Low" Value="0.3" />
  </Style>
  <Style Selector="Ellipse.session-dot.waiting">
    <Setter Property="Fill" Value="{DynamicResource GuiStatusWaiting}" />
  </Style>
  <!-- Unread: the brand yellow with a deep amber ring in light (yellow alone is 2.1:1 on the sidebar, under the 3:1 a
       graphic needs; a darker yellow would match the waiting dot). Dark needs no ring. -->
  <Style Selector="Ellipse.session-dot.unread">
    <Setter Property="Fill" Value="{DynamicResource GuiStatusUnread}" />
    <Setter Property="Stroke" Value="{DynamicResource GuiStatusUnreadRing}" />
    <Setter Property="StrokeThickness" Value="1.5" />
  </Style>
  <Style Selector="Ellipse.session-dot.error">
    <Setter Property="Fill" Value="{DynamicResource GuiStatusError}" />
  </Style>
  <!-- The sidebar's right edge: drag to resize (a hairline in the focus colour, centred on the edge, while hovered or dragged) -->
  <Style Selector="Border.sidebar-grip-line">
    <Setter Property="Width" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.sidebar-grip:pointerover Border.sidebar-grip-line, Border.sidebar-grip.dragging Border.sidebar-grip-line">
    <Setter Property="Background" Value="{DynamicResource GuiFocus}" />
  </Style>
  <Style Selector="Border.sidebar.drawer Border.sidebar-grip">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- ─────────────── Header: the pane toggles, folded into ⋮ when the column is narrow ─────────────── -->
  <Style Selector="Border.header-divider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource GuiBorder}" />
  </Style>
  <Style Selector="Border.header.fold-panes StackPanel.header-panes">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.header:not(.fold-panes) panes|ViewsMenu.header-views">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- ─────────────── Settings page: its navigation in the sidebar's place ─────────────── -->
  <Style Selector="Border.settings-sidebar">
    <Setter Property="Width" Value="240" />
    <Setter Property="Background" Value="{DynamicResource GuiSidebar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GuiBorderSoft}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="TextBlock.settings-title">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.settings-group">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontCaption}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
    <Setter Property="Margin" Value="10,16,0,4" />
  </Style>
  <Style Selector="Button.settings-nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadiusControl}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="Button.settings-nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GuiFill1}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <Style Selector="Button.settings-nav.current /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GuiFill2}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <Style Selector="Button.settings-nav.current">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <!-- In the narrow strip: tabs as wide as their names -->
  <Style Selector="Button.settings-nav.tab">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="0" />
  </Style>

  <!-- A 1 px separator between rows of a settings card -->
  <Style Selector="Border.ws-sep">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource GuiBorderSoft}" />
  </Style>

  <!-- A row's name (as the General page: medium weight, UI size) -->
  <Style Selector="TextBlock.ws-title">
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <!-- A value in a label / value line (same size as its muted label, so both share a baseline) -->
  <Style Selector="TextBlock.ws-value, SelectableTextBlock.ws-value">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontS}" />
  </Style>

  <!-- Feedback and notes inside a page: a pale fill in the status colour and a mark in the status colour; the text stays
       primary (status colours on their pale fill are below 4.5:1) -->
  <Style Selector="Border.ws-note">
    <Setter Property="Background" Value="{DynamicResource GuiFill1}" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadius8}" />
    <Setter Property="Padding" Value="12,9" />
  </Style>
  <Style Selector="Border.ws-note.ok">
    <Setter Property="Background" Value="{DynamicResource GuiStatusSuccessSoft}" />
  </Style>
  <Style Selector="Border.ws-note.warning">
    <Setter Property="Background" Value="{DynamicResource GuiStatusWarningSoft}" />
  </Style>
  <Style Selector="Border.ws-note.error">
    <Setter Property="Background" Value="{DynamicResource GuiStatusErrorSoft}" />
  </Style>
  <Style Selector="Border.ws-note TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource GuiFontS}" />
  </Style>
  <Style Selector="ctl|Icon.ok-mark">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiStatusSuccess}" />
  </Style>
  <Style Selector="ctl|Icon.unknown-mark">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextTertiary}" />
  </Style>

  <!-- A form opened inside a card (new worktree, add a host): a pale outline, so its filled fields read as on the card -->
  <Style Selector="Border.ws-form">
    <Setter Property="BorderBrush" Value="{DynamicResource GuiBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource GuiRadius12}" />
    <Setter Property="Padding" Value="16,14" />
  </Style>

  <!-- A list row (worktree, SSH host): 10 px above and below, separated by the pale line -->
  <Style Selector="Border.ws-row">
    <Setter Property="Padding" Value="0,10" />
    <Setter Property="BorderBrush" Value="{DynamicResource GuiBorderSoft}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <!-- The header's branch chip: quiet like the project name beside it, a hover fill like the title button -->
  <Style Selector="Button.branch-chip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="6,0,8,0" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="{DynamicResource GuiFontS}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.branch-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GuiFill1}" />
    <Setter Property="Foreground" Value="{DynamicResource GuiTextPrimary}" />
  </Style>
  <Style Selector="Button.branch-chip ctl|Icon.project-chevron">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource GuiTextTertiary}" />
  </Style>
  <!-- "· worktree" after the branch: the same quiet colour, even while the chip is hovered -->
  <Style Selector="Button.branch-chip TextBlock.worktree-mark">
    <Setter Property="Foreground" Value="{DynamicResource GuiTextSecondary}" />
  </Style>
</Styles>
