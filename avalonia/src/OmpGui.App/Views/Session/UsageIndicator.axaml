<!-- The context ring next to the model (Claude Code's context indicator) and its popover: omp's /context breakdown as
     bars, this session's tokens and cost (get_session_stats), the model provider's plan limits (omp's usage JSON) and
     "Compact now" (UsageViewModel, ProviderUsageViewModel). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmpGui.App.ViewModels"
             xmlns:ctl="using:OmpGui.App.Controls"
             xmlns:session="using:OmpGui.App.Views.Session"
             x:Class="OmpGui.App.Views.Session.UsageIndicator"
             x:DataType="vm:MainViewModel">
  <Panel>
    <Button x:Name="RingButton" Classes="chip ghost usage-ring" Command="{Binding Usage.ToggleCommand}" IsVisible="{Binding Usage.HasPercent}"
            ToolTip.Tip="{Binding Usage.Tooltip}" AutomationProperties.Name="{Binding Usage.AccessibleName}">
      <StackPanel Orientation="Horizontal" Spacing="5">
        <ctl:UsageRing x:Name="Ring" Value="{Binding Usage.Percent, FallbackValue=0, TargetNullValue=0}" Size="16" VerticalAlignment="Center"
                       Classes.warn="{Binding Usage.IsWarn}" Classes.full="{Binding Usage.IsFull}" />
        <TextBlock x:Name="PercentText" Classes="usage-percent" Text="{Binding Usage.PercentText}" VerticalAlignment="Center" />
      </StackPanel>
    </Button>
    <Popup x:Name="UsagePopup" IsOpen="{Binding Usage.IsOpen, Mode=TwoWay}" PlacementTarget="{Binding #RingButton}"
           Placement="TopEdgeAlignedRight" IsLightDismissEnabled="True" VerticalOffset="-6">
      <Border x:Name="UsagePopover" Classes="menu usage-popover" Width="360" Margin="12">
        <!-- Scrolls in a short window (UsageIndicator.axaml.cs caps it) instead of running into the window's top edge -->
        <ScrollViewer x:Name="UsageScroll" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10" Margin="10,8,10,10">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Classes="caps" Text="Context window" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="tertiary" Text="Updating…" IsVisible="{Binding Usage.IsLoading}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button Grid.Column="2" Classes="icon" Width="26" Height="26" Command="{Binding Usage.RefreshCommand}" ToolTip.Tip="Measure again"
                    AutomationProperties.Name="Refresh usage">
              <ctl:Icon Data="{StaticResource IconReload}" Size="14" />
            </Button>
          </Grid>
          <TextBlock x:Name="ContextHeadline" Classes="usage-headline" Text="{Binding Usage.ContextHeadline}" TextWrapping="Wrap" />
          <ItemsControl x:Name="ContextBars" ItemsSource="{Binding Usage.ContextRows}" IsVisible="{Binding Usage.HasContext}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ContextRowViewModel">
                <Grid Classes="usage-row" ColumnDefinitions="148,*,Auto" ToolTip.Tip="{Binding Tooltip}" AutomationProperties.Name="{Binding Tooltip}">
                  <TextBlock Classes="usage-label" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <ProgressBar Grid.Column="1" Classes="usage-bar" Classes.free="{Binding IsFree}" Classes.reserve="{Binding IsReserve}"
                               Value="{Binding Value}" Maximum="100" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Classes="usage-value" Text="{Binding Tokens}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="tertiary" Text="{Binding Usage.ContextNote}" TextWrapping="Wrap"
                     IsVisible="{Binding Usage.ContextNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <Border Height="1" Background="{DynamicResource GuiBorderSoft}" />
          <TextBlock Classes="caps" Text="This session" IsVisible="{Binding Usage.HasTotals}" />
          <ItemsControl x:Name="UsageTotals" ItemsSource="{Binding Usage.Totals}" IsVisible="{Binding Usage.HasTotals}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:UsageTotalViewModel">
                <Grid Classes="usage-row" ColumnDefinitions="*,Auto">
                  <TextBlock Classes="usage-label" Text="{Binding Label}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="usage-value" Text="{Binding Value}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Usage.HasLimits}">
            <TextBlock Classes="caps" Text="Plan usage" VerticalAlignment="Center" />
            <Button x:Name="AllProvidersButton" Grid.Column="1" Classes="link action" Content="All providers" Command="{Binding Usage.ShowAllProvidersCommand}"
                    VerticalAlignment="Center" ToolTip.Tip="Every signed-in provider's limits (Settings → Model providers)" />
          </Grid>
          <ItemsControl x:Name="UsageLimits" ItemsSource="{Binding Usage.Limits}" IsVisible="{Binding Usage.HasLimits}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProviderUsageGroupViewModel">
                <session:ProviderUsageGroupView />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="tertiary" Text="{Binding Usage.UsageNote}" TextWrapping="Wrap"
                     IsVisible="{Binding Usage.UsageNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Classes="warning" Text="{Binding Usage.Error}" TextWrapping="Wrap"
                     IsVisible="{Binding Usage.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Button x:Name="CompactNowButton" Classes="accent" Content="Compact now" Command="{Binding Usage.CompactNowCommand}"
                    ToolTip.Tip="omp summarizes the conversation and goes on from the summary (/compact)" />
            <Button x:Name="DashboardButton" Grid.Column="2" Classes="link action" Content="Usage dashboard" Command="{Binding Usage.OpenDashboardCommand}"
                    VerticalAlignment="Center" ToolTip.Tip="omp's local dashboard of tokens and cost across all sessions (/stats)" />
          </Grid>
        </StackPanel>
        </ScrollViewer>
      </Border>
    </Popup>
  </Panel>
</UserControl>
