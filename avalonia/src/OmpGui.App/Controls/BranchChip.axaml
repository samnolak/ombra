<!-- The header's branch chip (as Claude Code shows the session's branch): the project's branch, a worktree mark when the
     folder is a linked worktree; hidden outside git. Its menu: copy the name, a new worktree from here, Git settings. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmpGui.App.ViewModels"
             xmlns:ctl="using:OmpGui.App.Controls"
             x:Class="OmpGui.App.Controls.BranchChip"
             x:DataType="vm:MainViewModel"
             IsVisible="{Binding BranchChip.IsVisible}" VerticalAlignment="Center">
  <Panel DataContext="{Binding BranchChip}">
    <Button x:Name="ChipButton" x:DataType="vm:BranchChipViewModel" Classes="flat branch-chip" HorizontalAlignment="Left"
            ToolTip.Tip="{Binding Tooltip}" AutomationProperties.Name="{Binding AccessibleName}">
      <!-- A DockPanel, not a StackPanel: the name gets the room that is left and trims (a StackPanel let it run past the chip) -->
      <DockPanel>
        <ctl:Icon DockPanel.Dock="Left" Data="{StaticResource IconBranch}" Size="15" Margin="0,0,5,0" VerticalAlignment="Center" />
        <!-- A menu, like the title and the project next to it: the same chevron -->
        <ctl:Icon DockPanel.Dock="Right" Classes="project-chevron" Data="{StaticResource IconChevronDown}" Size="14" Margin="3,0,0,0" VerticalAlignment="Center" />
        <!-- In a slot the narrow header can hide (a style cannot override the mark's own binding) -->
        <Panel DockPanel.Dock="Right" Classes="worktree-slot">
          <TextBlock x:Name="WorktreeMark" Classes="worktree-mark" Text="· worktree" IsVisible="{Binding IsWorktree}" Margin="5,0,0,0" VerticalAlignment="Center" />
        </Panel>
        <TextBlock x:Name="BranchLabel" Text="{Binding Branch}" MaxWidth="300" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </DockPanel>
      <Button.Flyout>
        <Flyout Placement="BottomEdgeAlignedLeft">
          <StackPanel x:Name="BranchMenu" Width="272" Spacing="2">
            <Button x:Name="CopyBranchItem" Classes="menu-item" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding CopyBranchCommand}"
                    AutomationProperties.Name="Copy branch name">
              <Grid ColumnDefinitions="Auto,*">
                <ctl:Icon Data="{StaticResource IconCopy}" Size="16" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding CopyLabel}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button x:Name="NewWorktreeItem" Classes="menu-item" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding NewWorktreeCommand}"
                    AutomationProperties.Name="New worktree from here">
              <Grid ColumnDefinitions="Auto,*">
                <ctl:Icon Data="{StaticResource IconPlus}" Size="16" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="New worktree from here…" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Border Height="1" Background="{DynamicResource GuiBorderSoft}" Margin="4,3" />
            <Button x:Name="GitSettingsItem" Classes="menu-item" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding OpenGitSettingsCommand}"
                    AutomationProperties.Name="Git settings">
              <Grid ColumnDefinitions="Auto,*">
                <ctl:Icon Data="{StaticResource IconSettings}" Size="16" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="Git and worktree settings" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </StackPanel>
        </Flyout>
      </Button.Flyout>
    </Button>
  </Panel>
</UserControl>
