<!-- The pet in the app's window, on a layer over the whole window (only the pet, its bubble and its message box take
     the pointer). By default the pet sits on the message box's top edge, at its right end, in a band above the box
     (PetsViewModel.ComposerMargin) as tall as the pet, so it never covers the conversation, a card or a question.
     Dragged, it stays where it is dropped: on the desktop, in a window of its own (PetWindow), or, with Settings → Pets
     → "Inside the window", in this layer (PetsViewModel.Position). Placed in code (PetPerch.Place, PetStage). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmpGui.App.ViewModels"
             xmlns:ctl="using:OmpGui.App.Controls"
             x:Class="OmpGui.App.Controls.PetPerch"
             x:DataType="vm:MainViewModel"
             IsVisible="{Binding Pets.IsOnScreen}">
  <ctl:PetStage x:Name="Stage" DataContext="{Binding Pets}" />
</UserControl>
