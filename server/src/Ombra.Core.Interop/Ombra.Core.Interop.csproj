<Project Sdk="Microsoft.NET.Sdk">
  <!--
    .NET wrapper over the ombra-core C ABI (server/native/ombra-core, src/ffi.rs). Shared by the
    server ("public verification" mode, OmbraPublic) and the Ombra client (OmbraState).
    Native library: libombra_core.{dylib,so} / ombra_core.dll, built by
      cargo build (release profile) in server/native/ombra-core
    and copied next to the assembly from $(OmbraNativeDir). The resolver in NativeLoader.cs also
    honours OMBRA_CORE_NATIVE_PATH / AppContext "Ombra.Core.NativePath".
  -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Native payload selection depends on the referencing application's RID. -->
    <IsRidAgnostic>false</IsRidAgnostic>
    <!-- A host cargo build is usable only for the host RID. Cross-publishes must
         select cargo's target-specific output, never copy the host library. -->
    <OmbraNativeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</OmbraNativeRid>
    <OmbraNativeRid Condition="'$(OmbraNativeRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</OmbraNativeRid>
    <OmbraNativeTarget Condition="'$(OmbraNativeRid)' == 'osx-arm64'">aarch64-apple-darwin</OmbraNativeTarget>
    <OmbraNativeTarget Condition="'$(OmbraNativeRid)' == 'osx-x64'">x86_64-apple-darwin</OmbraNativeTarget>
    <OmbraNativeTarget Condition="'$(OmbraNativeRid)' == 'linux-arm64'">aarch64-unknown-linux-gnu</OmbraNativeTarget>
    <OmbraNativeTarget Condition="'$(OmbraNativeRid)' == 'linux-x64'">x86_64-unknown-linux-gnu</OmbraNativeTarget>
    <OmbraNativeTarget Condition="'$(OmbraNativeRid)' == 'win-arm64'">aarch64-pc-windows-msvc</OmbraNativeTarget>
    <OmbraNativeTarget Condition="'$(OmbraNativeRid)' == 'win-x64'">x86_64-pc-windows-msvc</OmbraNativeTarget>
    <OmbraNativeDir Condition="'$(OmbraNativeDir)' == '' and '$(OmbraNativeRid)' == '$(NETCoreSdkRuntimeIdentifier)'">$(MSBuildThisFileDirectory)../../native/ombra-core/target/release/</OmbraNativeDir>
    <OmbraNativeDir Condition="'$(OmbraNativeDir)' == '' and '$(OmbraNativeTarget)' != ''">$(MSBuildThisFileDirectory)../../native/ombra-core/target/$(OmbraNativeTarget)/release/</OmbraNativeDir>
    <OmbraNativeFile Condition="'$(OmbraNativeFile)' == '' and $(OmbraNativeRid.StartsWith('osx-'))">libombra_core.dylib</OmbraNativeFile>
    <OmbraNativeFile Condition="'$(OmbraNativeFile)' == '' and $(OmbraNativeRid.StartsWith('linux-'))">libombra_core.so</OmbraNativeFile>
    <OmbraNativeFile Condition="'$(OmbraNativeFile)' == '' and $(OmbraNativeRid.StartsWith('win-'))">ombra_core.dll</OmbraNativeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(OmbraNativeDir)$(OmbraNativeFile)" Condition="Exists('$(OmbraNativeDir)$(OmbraNativeFile)')"
          Link="$(OmbraNativeFile)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
