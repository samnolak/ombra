{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ombra": {
    "DataDir": "/var/lib/ombra",
    "TokenKeyFile": "/etc/ombra/token.key",
    "ServerIdFile": "/etc/ombra/server-id",
    "Mode": "ip",
    "TlsCertFile": "/etc/ombra/tls/current.crt",
    "TlsKeyFile": "/etc/ombra/tls/current.key",
    "ListenUrl": "https://0.0.0.0:443"
  }
}
